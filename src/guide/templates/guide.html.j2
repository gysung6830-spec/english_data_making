<!-- 구문해석 실전서 — 표지 · 목차 · 0부 · 1부 · 2부 -->

{% set nums = ['①','②','③','④','⑤'] %}
{% macro vocab_block(vocab) %}
<div class="vocab-box">
  <div class="vocab-title">📦 이 페이지 핵심 어휘</div>
  <div class="vocab-grid">
  {% for v in vocab %}<div class="vocab-item"><b>{{ v.word }}</b> {{ v.meaning }}</div>{% endfor %}
  </div>
</div>
{% endmacro %}

{% macro method_demo(demo) %}
<div class="demo">
  <div class="demo-step"><span class="dtag s1">① 괄호치기</span>
    <span class="demo-en">{{ demo.bracketed or demo.sentence }}</span></div>
  <div class="demo-step"><span class="dtag s2">② 뼈대(쉬운 말)</span>
    <span class="skel-en">{{ demo.skeleton_en }}</span>
    <span class="skel-ko">— {{ demo.skeleton_ko }}</span></div>
  <div class="demo-step"><span class="dtag s3">③ 완성</span>
    <span class="demo-full">{{ demo.full_ko }}</span></div>
</div>
{% endmacro %}

{% macro problems_block(problems) %}
<div class="problems">
  <div class="prob-title">🎯 실전적용 <span>· 예시 외 기출로 직접 풀어 보기</span></div>
  {% for p in problems %}
  <div class="problem">
    <div class="prob-head">
      <span class="prob-kind {{ p.kind }}">{{ '객관식' if p.kind=='mc' else '주관식' }}</span>
      {% if p.source %}<span class="src-chip">{{ p.source }}</span>{% endif %}
    </div>
    <div class="prob-sentence">{{ p.sentence }}</div>
    <div class="prob-prompt">Q. {{ p.prompt | replace('▷ 오역:', '<br>▷ 오역:') | safe }}</div>
    {% if p.kind == 'mc' %}
      {% for opt in p.options %}
      <div class="prob-opt">{{ nums[loop.index0] }} {{ opt }}</div>
      {% endfor %}
      <div class="prob-answer">정답 {{ nums[p.answer_index] }} · {{ p.point }}</div>
      {% if p.cut %}<div class="wb-cut"><span class="cut-tag">끊어읽기</span>{{ p.cut }}</div>{% endif %}
    {% else %}
      <div class="prob-answer">모범답안 · {{ p.answer }}</div>
      {% if p.cut %}<div class="wb-cut"><span class="cut-tag">끊어읽기</span>{{ p.cut }}</div>{% endif %}
      {% if p.trap %}<div class="prob-trap">⚠️ 흔한 오역 · {{ p.trap }}</div>{% endif %}
      {% if p.point %}<div class="prob-point">🔑 {{ p.point }}</div>{% endif %}
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endmacro %}

{# 실전적용: 문제(여러 개, 페이지 채움) → 해설(같은 수) 배치 #}
{% macro drill_pages(title, practice) %}
{% set dnums = ['①','②','③','④','⑤'] %}
{# ── 문제 묶음 ── #}
<section class="chapter drill-q">
  <div class="drill-band">실전적용 <small>{{ title }} · 문제 {{ practice|length }}題</small></div>
  {% for pr in practice %}
  <div class="dq-item">
    <div class="dq"><span class="dq-no">{{ '%02d' % pr.no }}</span>
      <span class="dq-sent">{{ pr.sentence }}{% if pr.source %}<span class="src-chip">{{ pr.source }}</span>{% endif %}</span>
    </div>
    <div class="dq-prompt">Q. {{ pr.prompt | replace('▷ 오역:', '<br>▷ 오역:') | safe }}</div>
    {% if pr.kind == 'mc' %}
      {% for opt in pr.options %}<div class="dq-opt">{{ dnums[loop.index0] }} {{ opt }}</div>{% endfor %}
    {% else %}
      <div class="dq-ans-line">▶ 해석: <span class="dq-blank"></span></div>
    {% endif %}
    {% if pr.vocab %}<div class="dq-voca">📦 {% for v in pr.vocab %}<span><b>{{ v.word }}</b> {{ v.meaning }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{# ── 해설 묶음(문제와 동일 수) ── #}
<section class="chapter drill-a">
  <div class="drill-band dk">실전적용 해설 <small>{{ title }} · 문제 {{ practice|length }}題</small></div>
  {% for pr in practice %}{% set s = pr.solution %}
  <div class="sol-item">
    <div class="dq"><span class="dq-no">{{ '%02d' % pr.no }}</span>
      <span class="dq-sent">{{ (s.cut_en if (s and s.cut_en) else pr.sentence) | replace(' / ', ' <b class="cslash">/</b> ') | safe }}
        {% if pr.kind == 'mc' %}<span class="dq-correct">정답 {{ dnums[pr.answer_index] }}</span>{% endif %}{% if pr.source %}<span class="src-chip">{{ pr.source }}</span>{% endif %}</span>
    </div>
    {% if s %}
    {% if s.cut %}<div class="sol cut"><span class="sol-tag">끊어읽기{% if pr.kind == 'short' %} · 해석{% endif %}</span>{{ s.cut }}</div>{% endif %}
    {% if s.author_msg %}<div class="sol msg"><span class="sol-tag">이 정도는 캐치</span>{{ s.author_msg }}</div>{% endif %}
    {% if s.wrong %}<div class="sol wrong"><span class="sol-tag">오역 진단</span>{{ s.wrong }}
      {% if s.wrong_why %}<div class="sol-why">↳ 왜 틀렸나 · {{ s.wrong_why }}</div>{% endif %}
      {% if s.key_points %}<div class="sol-kp">{% for k in s.key_points %}<div class="kp">▪ {{ k }}</div>{% endfor %}</div>{% endif %}</div>
    {% elif s.key_points %}<div class="sol key"><span class="sol-tag">주요 구문</span>
      <div class="sol-kp">{% for k in s.key_points %}<div class="kp">▪ {{ k }}</div>{% endfor %}</div></div>{% endif %}
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endmacro %}

<!-- 표지 -->
<section class="cover">
  <div class="kicker">{{ guide.kicker }}</div>
  <h1>{{ guide.title }}</h1>
  <div class="rule"></div>
  <div class="sub">{{ guide.subtitle }}</div>
  {% if sample %}<div style="height:26px"></div><div class="badge-sample">SAMPLE · 미리보기</div>{% endif %}
</section>

<!-- 머리말 -->
<section class="preface">
  <div class="pf-label">머리말</div>
  <div class="pf-title">문장은 통째로 읽는 게 아닙니다</div>
  <div class="pf-body">
    <p>수능 영어에서 등급을 가르는 건 단어를 몇 개 아느냐가 아닙니다. 같은 단어를 알아도 누구는 문장을 정확히 읽고, 누구는 엉뚱하게 읽습니다. 차이는 딱 하나 — <b>어디서 끊고, 무엇을 먼저 잡느냐</b>입니다.</p>
    <p>잘 읽는 학생은 긴 문장을 절대 통째로 밀고 나가지 않습니다. 수식어를 괄호로 밀어 두고 <b>주어·동사(뼈대)부터</b> 세운 뒤, 그 위에 살을 붙입니다. 이 책은 그 '읽는 동작'을 <b>평가원 기출 문장</b>으로 몸에 붙이도록 만들었습니다. 지어낸 예문은 한 문장도 없습니다.</p>
    <p>각 문장마다 세 가지를 답니다. <b>어떻게 읽나</b>(구조를 어디서 끊는지), <b>끊어읽기</b>(그렇게 읽은 결과), 그리고 <b>이 정도는 캐치</b>(읽고 나서 반드시 남아야 할 정보). 특히 마지막 줄 — 문장을 읽었으면 <i>이 정도는 잡아야 한다</i>는 감각, 그게 이 책이 끝까지 밀고 가는 하나의 축입니다.</p>
    <p class="pf-sign">— 문장을 끝까지 놓치지 않기를 바라며</p>
  </div>
</section>

<!-- 목차 -->
<section class="toc">
  <div class="toc-title">목차 <span class="toc-en">CONTENTS</span></div>

  {% set letters = ['A','B','C','D','E','F'] %}
  {% if guide.part0 %}
  <div class="toc-part"><a href="#part0"><span class="toc-pno">0부</span> 기본기 — {{ guide.part0.title }}</a></div>
  {% for m in guide.part0.methods %}
  <div class="toc-item"><a href="#part0"><span class="toc-no">0-{{ loop.index }}</span>{{ m.step }} · {{ m.title }}</a></div>
  {% endfor %}
  {% endif %}

  {% if guide.part2 %}
  <div class="toc-part"><a href="#part2"><span class="toc-pno">1부</span> 구문해석 — {{ guide.part2.title }}</a></div>
  {% set tns = namespace(cn=0) %}
  {% for g in guide.part2.groups %}
  <div class="toc-sub">1부 {{ letters[loop.index0] }} · {{ g.title }} <span>· {{ g.subtitle }}</span></div>
  {% for c in g.chapters %}
  {% set tns.cn = tns.cn + 1 %}
  <div class="toc-item"><a href="#sx-{{ c.id }}"><span class="toc-no">1-{{ tns.cn }}</span>{{ c.title }}</a></div>
  {% endfor %}
  {% endfor %}
  {% endif %}

  {% if guide.chapters %}
  <div class="toc-part"><a href="#part1"><span class="toc-pno">2부</span> 평가원 코드 — 필자가 의도하는 바를 파악하기</a></div>
  {% for c in guide.chapters %}
  <div class="toc-item"><a href="#ch-{{ c.id }}"><span class="toc-no">2-{{ loop.index }}</span>{{ c.title }}</a></div>
  {% endfor %}
  {% endif %}

  {% if guide.abstract %}
  <div class="toc-part"><a href="#partAbs"><span class="toc-pno">3부</span> 추상 → 구체 — {{ guide.abstract.title.split('·')[1] if '·' in guide.abstract.title else guide.abstract.title }}</a></div>
  {% for c in guide.abstract.chapters %}
  <div class="toc-item"><a href="#abs-{{ c.id }}"><span class="toc-no">3-{{ loop.index }}</span>{{ c.title }}</a></div>
  {% endfor %}
  {% endif %}

  {% if guide.inference %}
  <div class="toc-part"><a href="#partInf"><span class="toc-pno special">부록</span> 어휘 유추 — 모르는 단어는 유추로 뚫는다</a></div>
  <div class="toc-item"><a href="#partInf"><span class="toc-no">부록</span>유추의 다섯 단서 · 유추 문제(객관식·주관식)</a></div>
  {% endif %}
</section>

{# ===================== 0부 — 3단계 읽기 엔진 ===================== #}
{% if guide.part0 %}
{% set p0 = guide.part0 %}
<section class="chapter" id="part0">
  <div class="ch-kicker">0부 · 기본기</div>
  <div class="ch-title">{{ p0.title }}</div>
  <div class="spine">“{{ p0.spine }}”</div>
  <div class="ch-signal">{{ p0.intro }}</div>
  {% if p0.mindset %}<div class="mindset"><span class="mindset-tag">먼저 이것부터</span>{{ p0.mindset | safe }}</div>{% endif %}

  {# ── 엔진 요약 배너: 문장이 3단계를 통과한다 ── #}
  <div class="engine-flow">
    <span class="ef-cap ef-in">수능 문장<small>길고 복잡</small></span>
    <span class="ef-arrow">▶</span>
    <span class="ef-step"><b>①</b> 괄호치기</span>
    <span class="ef-arrow">▶</span>
    <span class="ef-step"><b>②</b> 뼈대·관계</span>
    <span class="ef-arrow">▶</span>
    <span class="ef-step"><b>③</b> 살 붙이기</span>
    <span class="ef-arrow">▶</span>
    <span class="ef-cap ef-out">쉬운 해석<small>직독직해</small></span>
  </div>

  {# ── STEP 1·2·3 지그재그 매거진(좌·우 교차) ── #}
  <div class="steps-zz">
  {% for m in p0.methods if m.step.startswith('STEP') %}
    <div class="zz{{ ' alt' if loop.index is even }}">
      <div class="zz-side"><div class="zz-num">{{ loop.index }}</div><div class="zz-lbl">{{ m.step }}</div></div>
      <div class="zz-main">
        <div class="zz-title">{{ m.title }}</div>
        <div class="method-idea">{{ m.idea }}</div>
        {% if m.rule %}<div class="method-rule"><b>규칙 ·</b> {{ m.rule }}</div>{% endif %}
        {% if m.ms_point %}<div class="ms-point">💡 한 줄 정리 · {{ m.ms_point }}</div>{% endif %}
        {% if m.demo %}{{ method_demo(m.demo) }}{% endif %}
      </div>
    </div>
  {% endfor %}
  </div>

  {# ── 끊고 잇기 실전 엔진: 매끄럽게 잇기 · 전치사 조사 · 한 문장 확인 (한 페이지) ── #}
  {% if p0.link_tricks %}
  <div class="engine engine-link brk-before">
    <div class="engine-head"><span class="engine-badge">실전</span>매끄럽게 잇기 — 끊었으면 이어라</div>
    <div class="engine-intro">STEP 1에서 신호 앞을 <b>끊었다면</b>, 이제 조각을 <b>앞으로만</b> 이어야 해석이 된다. 아래 손기술로 이어라.</div>
    <div class="link-list">
      {% for t in p0.link_tricks %}
      <div class="link-row"><span class="link-k">{{ t.k }}</span><span class="link-v">{{ t.v | safe }}{% if t.ex %} <span class="link-ex">{{ t.ex | safe }}</span>{% endif %}</span></div>
      {% endfor %}
    </div>
    {% if p0.prep_gloss %}
    <div class="prep-gloss">
      <div class="pg-title">전치사 = 조사 붙이기 <small>of A of B = B의 A</small></div>
      <div class="pg-chips">
        {% for g in p0.prep_gloss %}<span class="pg-chip"><b>{{ g.p }}</b> {{ g.m }}</span>{% endfor %}
      </div>
    </div>
    {% endif %}
    {% if p0.cut_demo %}
    <div class="cut-demo">
      <div class="cd-title">🔎 한 문장으로 확인 <small>신호 앞에서 끊고 → 앞으로만 잇기</small></div>
      <div class="cd-marked">{{ p0.cut_demo.marked | safe }}</div>
      <div class="cd-read">{{ p0.cut_demo.read | safe }}</div>
      {% if p0.cut_demo.note %}<div class="cd-note">{{ p0.cut_demo.note | safe }}</div>{% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  {# ── 지원 도구: 읽기 깊이 · 유추 (STEP 아님, 별도 카드) ── #}
  {% for m in p0.methods if not m.step.startswith('STEP') %}
  <div class="method extra">
    <div class="method-head"><span class="step alt">{{ m.step }}</span> {{ m.title }}</div>
    <div class="method-idea">{{ m.idea }}</div>
    {% if m.rule %}<div class="method-rule"><b>규칙 ·</b> {{ m.rule }}</div>{% endif %}
    {% if m.ms_point %}<div class="ms-point">💡 한 줄 정리 · {{ m.ms_point }}</div>{% endif %}
    {% if m.demo %}{{ method_demo(m.demo) }}{% endif %}
    {% if m.step == '읽기 깊이' and p0.depth_demos %}
    <div class="depth-demos">
      <div class="dd-title">🖍 같은 글도 유형 따라 '읽는 양'이 다르다 — <span>형광펜 = 꼭 읽을 곳</span></div>
      {% for dd in p0.depth_demos %}
      <div class="depth-demo">
        <div class="dd-head"><span class="dd-kind">{{ dd.kind }}</span>{% if dd.source %}<span class="dd-src">{{ dd.source }}</span>{% endif %}</div>
        {% if dd.goal %}<div class="dd-goal">🎯 {{ dd.goal }}</div>{% endif %}
        <div class="dd-passage">{{ dd.passage | hi_marks }}</div>
        {% if dd.read %}<div class="dd-read"><span class="ddr-tag">형광펜만 읽으면</span>{{ dd.read }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}

  {% if p0.tools %}
  <div class="tools">
    <div class="tools-title">🔧 미니 도구</div>
    {% for t in p0.tools %}<div class="tool">{{ t }}</div>{% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

{# ===================== 1부 — 구문해석 · 해석공식 시각화 ===================== #}
{% if guide.part2 %}
{% set p2 = guide.part2 %}
<section class="pcover" id="part2">
  <div class="pc-kick">PART 1 · 구문해석</div>
  <div class="pc-title">{{ p2.title }}</div>
  <div class="pc-rule"></div>
  <div class="pc-intro">구문을 '읽는 동작'이 같은 것끼리 <b style="color:#fff">네 갈래</b>로 묶었다. 갈래마다 전략은 하나 — 그 하나를 반복 적용하면 된다.</div>
  <div class="pc-strats">
    <div class="pc-list-h">🧭 이 파트의 네 갈래 읽기 전략</div>
    {% for g in p2.groups %}
    <div class="pc-row"><div class="pc-rh"><span class="pc-g">1부 {{ ['A','B','C','D'][loop.index0] }}</span><span class="pc-t">{{ g.title }}</span><span class="pc-n">{{ g.chapters|length }}개 유형</span></div><div class="pc-s">{{ g.strategy }}</div></div>
    {% endfor %}
  </div>
  <div class="pc-tip">🎯 <b>이렇게 공부하세요</b> · 해석 공식(도식) → 기출 예문 4개(끊어읽기) → 실전적용 문제·해설 순서로 익힌다.</div>
</section>

{% set bletters = ['A','B','C','D','E','F'] %}
{% set bns = namespace(cn=0) %}
{% for g in p2.groups %}
{% set pidx = loop.index %}
<section class="divider" id="grp-{{ g.id }}">
  <div class="dv-inner">
    <div class="dv-badge">1부 · {{ bletters[loop.index0] }}</div>
    <div class="dv-title">{{ g.title }}</div>
    <div class="dv-sub">{{ g.subtitle }}</div>
    <div class="dv-rule"></div>
    <div class="dv-chapters">
    {% for c in g.chapters %}
      <div class="dv-ch"><span class="no">1-{{ bns.cn + loop.index }}</span><span class="t">{{ c.title }}</span></div>
    {% endfor %}
    </div>
  </div>
</section>

{% for chapter in g.chapters %}
{% set bns.cn = bns.cn + 1 %}
<section class="chapter wb" id="sx-{{ chapter.id }}">
  <div class="ch-kicker">1-{{ bns.cn }} · 구문</div>
  <div class="ch-title chap">{{ chapter.title }}</div>

  {% if chapter.point %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">1</span><span class="wb-step-t">원리</span><span class="wb-step-hint">— 이게 무엇인가</span></div>
    <div class="wb-box point">{{ chapter.point }}</div>
  </div>
  {% endif %}

  {% if chapter.diagram or chapter.strategy %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">2</span><span class="wb-step-t">이렇게 읽어라</span><span class="wb-step-hint">— 공식 + 전략</span></div>
    {% if chapter.strategy %}<div class="method-lead">🎯 <b>전략</b> · {{ chapter.strategy }}</div>{% endif %}
    {% if chapter.diagram %}
    <div class="formula joined">
      <div class="f-diagram">
        <div class="f-symbol">{{ chapter.diagram.symbol }}</div>
        <div class="f-rows">
          {% for r in chapter.diagram.rows %}
          <div class="f-row"><span class="f-en">{{ r.en }}</span>
            <span class="f-arrow">→</span><span class="f-ko">{{ r.ko }}</span></div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if chapter.coach %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">3</span><span class="wb-step-t">코치 한 마디</span><span class="wb-step-hint">— 함정·요령</span></div>
    <div class="coach">{{ chapter.coach | safe }}</div>
  </div>
  {% endif %}

  {% if chapter.training %}
  <div class="ex-label">단계별 트레이닝 <span>· 쉬움 → 하드, 한 겹씩 붙여 읽기</span></div>
  <div class="train">
    {% for t in chapter.training %}
    <div class="train-row">
      <div class="train-lv">{{ t.level }}</div>
      <div class="train-body"><span class="train-en">{{ t.en }}</span>
        <span class="train-arrow">→</span><span class="train-ko">{{ t.ko }}</span></div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if chapter.examples %}
  <div class="ex-label">기출 예문 <span>· 밑줄=구문 신호</span></div>
  <ol class="wb-ex">
    {% for e in chapter.examples %}
    <li><span class="n">{{ loop.index }}</span>{{ (e.cut_en or e.en) | replace(' / ', ' <b class="cslash">/</b> ') | safe }}
      {% if e.src %}<span class="src-chip">{{ e.src }}</span>{% endif %}
      {% if e.ab %}<div class="wb-ab"><span class="ab-tag">A→B</span>{{ e.ab }}</div>{% endif %}
      {% if e.how %}<div class="wb-how"><span class="how-tag">어떻게 읽나</span>{{ e.how }}</div>{% endif %}
      {% if e.cut %}<div class="wb-cut"><span class="cut-tag">끊어읽기</span>{{ e.cut }}</div>{% endif %}
      {% if e.catch %}<div class="wb-catch"><span class="catch-tag">이 정도는 캐치</span>{{ e.catch }}</div>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <div class="wb-note">▪ 기출 예문은 API 연결 시 선별 기출로 자동 생성됩니다. (실전적용 문제·해설은 뒤에 이어집니다)</div>
  {% endif %}

  {% if chapter.vocab %}{{ vocab_block(chapter.vocab) }}{% endif %}
</section>

{% if chapter.practice %}{{ drill_pages(chapter.title, chapter.practice) }}{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{# ===================== 2부 — 평가원 코드 ===================== #}
{% if guide.chapters %}
<section class="pcover" id="part1">
  <div class="pc-kick">PART 2 · 평가원 기능어 특집</div>
  <div class="pc-title">평가원 코드 — 필자가 의도하는 바를 파악하기</div>
  <div class="pc-rule"></div>
  <div class="pc-intro">평가원 문장은 추상적이고 수식어가 많다. 그런데 <b style="color:#fff">기능어(평가원 코드)</b>만 정확히 잡으면 문장이 어느 방향으로 흐르는지 — 그리고 답이 어디로 이어지는지 — 가 보인다.</div>
  <div class="pc-strats">
    <div class="pc-list-h">🧭 이 파트의 7가지 코드, 이렇게 잡는다</div>
    {% for c in guide.chapters %}
    <div class="pc-row"><div class="pc-rh"><span class="pc-g">2-{{ loop.index }}</span><span class="pc-t">{{ c.title }}</span></div><div class="pc-s">{{ c.tip }}</div></div>
    {% endfor %}
  </div>
  <div class="pc-tip">🎯 <b>이렇게 공부하세요</b> · 오역 ↔ 정답 카드로 함정과 방향을 나란히 본 뒤, 실전적용 문제로 스스로 방향을 잡는다.</div>
</section>

{% for chapter in guide.chapters %}
<section class="chapter" id="ch-{{ chapter.id }}">
  <div class="ch-kicker">2-{{ loop.index }} · 코드</div>
  <div class="ch-title chap">{{ chapter.title }}</div>
  <div class="ch-signal">{{ chapter.signal }}</div>
  <div class="ch-intro">
    <div><span class="lbl">이 유형의 대표 오역 ·</span>
      <span class="misread">{{ chapter.misread }}</span></div>
    <div class="tip"><span class="lbl">💡 코드를 만나면 ·</span> {{ chapter.tip }}</div>
  </div>
  {% if chapter.core_tip or chapter.infer_tip %}
  <div class="tip-cards">
    {% if chapter.core_tip %}<div class="tip-card core"><b>🎯 핵심 파악</b> {{ chapter.core_tip }}</div>{% endif %}
    {% if chapter.infer_tip %}<div class="tip-card infer"><b>🔮 유추 tip</b> {{ chapter.infer_tip }}</div>{% endif %}
  </div>
  {% endif %}
  <div class="ex-label">예시 <span>중난이도·고난이도 기출</span></div>
  {% for card in chapter.cards %}
  <div class="card card-c{{ loop.index0 % 5 }}">
    <div class="card-head">
      <span class="code-chip">{{ card.code }}</span>
      <span class="code-ko">{{ card.code_ko }}</span>
      {% if card.difficulty %}<span class="diff diff-{{ card.difficulty }}">{{ card.difficulty }}난이도</span>{% endif %}
      {% set dl = card.dir | dir_label %}
      {% if dl %}<span class="dir-badge">{{ dl }}</span>{% endif %}
    </div>
    {% if card.source %}<div class="src-chip">{{ card.source }}</div>{% endif %}
    <div class="sentence">
      {% if card.body.cut_en %}{{ card.body.cut_en | replace(' / ', ' <b class="cslash">/</b> ') | safe }}{% else %}{{ card.sentence | highlight_code(card.body.highlight) }}{% endif %}
    </div>
    <div class="rows">
      <div class="ab right"><span class="tag">정답</span>{{ card.body.correct }}
        {% if card.body.cut %}<div class="wb-cut"><span class="cut-tag">끊어읽기</span>{{ card.body.cut }}</div>{% endif %}
      </div>
    </div>
    {% if card.body.so_what %}
    <div class="so-what"><span class="sw-tag">이 정도는 캐치</span>{{ card.body.so_what }}
      <span class="sw-note">(이 문장만으로 도출)</span>
    </div>
    {% endif %}
    {% if card.body.skeleton %}<div class="skeleton">뼈대 · {{ card.body.skeleton }}</div>{% endif %}
    <div class="ab wrong"><span class="tag">오역</span>{{ card.body.literal_trap }}
      <div class="why">↳ 왜 틀렸나 · {{ card.body.trap_why }}</div></div>
  </div>
  {% endfor %}

  {% if chapter.vocab %}{{ vocab_block(chapter.vocab) }}{% endif %}
</section>
{% if chapter.practice %}{{ drill_pages(chapter.title, chapter.practice) }}{% endif %}
{% endfor %}
{% endif %}

{# ===================== 2부 — 패러프레이징(지문 단위) ===================== #}
{% if guide.paraphrase %}
{% set pp = guide.paraphrase %}
<section class="chapter" id="partP">
  <div class="ch-kicker">2부 · 패러프레이징</div>
  <div class="ch-title">{{ pp.title }}</div>
  <div class="ch-signal">{{ pp.intro }}</div>
</section>
{% endif %}

{# ===================== 추상 → 구체 ===================== #}
{% if guide.abstract %}
{% set ab = guide.abstract %}
<section class="pcover" id="partAbs">
  <div class="pc-kick">PART 3 · 추상 → 구체</div>
  <div class="pc-title">{{ ab.title }}</div>
  <div class="pc-rule"></div>
  <div class="pc-intro">{{ ab.intro }}</div>
  <div class="pc-strats">
    <div class="pc-list-h">🧭 추상을 구체로 푸는 다섯 갈래</div>
    {% for c in ab.chapters %}
    <div class="pc-row"><div class="pc-rh"><span class="pc-g">3-{{ loop.index }}</span><span class="pc-t">{{ c.title }}</span></div><div class="pc-s">{{ c.strategy }}</div></div>
    {% endfor %}
  </div>
  <div class="pc-tip">🎯 <b>이렇게 공부하세요</b> · 추상 표현을 만나면 바로 옆·뒤의 구체화 장치(재진술·예시·대비·비유)를 찾는다. 그 장치가 곧 추상어의 '쉬운 번역'이다.</div>
</section>

{% for chapter in ab.chapters %}
<section class="chapter wb" id="abs-{{ chapter.id }}">
  <div class="ch-kicker">3-{{ loop.index }} · 추상→구체</div>
  <div class="ch-title chap">{{ chapter.title }}</div>

  {% if chapter.point %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">1</span><span class="wb-step-t">원리</span><span class="wb-step-hint">— 이게 무엇인가</span></div>
    <div class="wb-box point">{{ chapter.point }}</div>
  </div>
  {% endif %}

  {% if chapter.exprs or chapter.strategy %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">2</span><span class="wb-step-t">이렇게 읽어라</span><span class="wb-step-hint">— 표현 + 전략</span></div>
    {% if chapter.strategy %}<div class="method-lead">🎯 <b>구체화 전략</b> · {{ chapter.strategy }}</div>{% endif %}
    {% if chapter.exprs %}
    <div class="formula joined">
      <div class="f-rows">
        {% for r in chapter.exprs %}
        <div class="f-row"><span class="f-en">{{ r.en }}</span>
          <span class="f-arrow">→</span><span class="f-ko">{{ r.ko }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if chapter.examples %}
  <div class="ex-label">기출 예문 <span>· 구체화</span></div>
  <ol class="wb-ex">
    {% for e in chapter.examples %}
    <li><span class="n">{{ loop.index }}</span>{{ (e.cut_en or e.en) | replace(' / ', ' <b class="cslash">/</b> ') | safe }}
      {% if e.src %}<span class="src-chip">{{ e.src }}</span>{% endif %}
      {% if e.how %}<div class="wb-how"><span class="how-tag">구체화</span>{{ e.how }}</div>{% endif %}
      {% if e.cut %}<div class="wb-cut"><span class="cut-tag">끊어읽기</span>{{ e.cut }}</div>{% endif %}
      {% if e.catch %}<div class="wb-catch"><span class="catch-tag">이 정도는 캐치</span>{{ e.catch }}</div>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</section>
{% if chapter.practice %}{{ drill_pages(chapter.title, chapter.practice) }}{% endif %}
{% endfor %}
{% endif %}

{# ===================== 부록 — 어휘 유추 ===================== #}
{% if guide.inference %}
{% set inf = guide.inference %}
<section class="chapter" id="partInf">
  <div class="ch-kicker">부록 · 어휘 유추</div>
  <div class="ch-title">{{ inf.title }}</div>
  <div class="ch-signal">{{ inf.intro }}</div>
  {% if inf.chapters and inf.chapters[0].exprs %}
  <div class="roadmap">
    <div class="rm-title">🔮 모르는 단어를 뚫는 5가지 단서</div>
    {% for e in inf.chapters[0].exprs %}
    <div class="rm-item"><span class="rm-no">{{ loop.index }}</span><span class="rm-t">{{ e.en }}</span></div>
    {% endfor %}
  </div>
  <div class="study-tip">🎯 <b>이렇게 공부하세요</b> · 모든 단어를 외울 필요는 없다. 모르는 단어를 만나면 <b>주변 단서</b>(대조·재진술·예시·병렬·형태)로 '대략의 뜻·좋은 말/나쁜 말'만 잡아도 문제는 풀린다. 아래 원리와 유추 문제(객관식·주관식)로 '단서 잡는 눈'을 훈련한다.</div>
  {% endif %}
</section>
{% for chapter in inf.chapters %}
<section class="chapter wb" id="inf-{{ chapter.id }}">
  <div class="ch-kicker">어휘 유추 · 원리</div>
  <div class="ch-title chap">{{ chapter.title }}</div>
  {% if chapter.point %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">1</span><span class="wb-step-t">원리</span><span class="wb-step-hint">— 이게 무엇인가</span></div>
    <div class="wb-box point">{{ chapter.point }}</div>
  </div>
  {% endif %}
  {% if chapter.exprs or chapter.strategy %}
  <div class="wb-step">
    <div class="wb-step-h"><span class="wb-step-no">2</span><span class="wb-step-t">이렇게 읽어라</span><span class="wb-step-hint">— 단서 + 전략</span></div>
    {% if chapter.strategy %}<div class="method-lead">🎯 <b>유추 전략</b> · {{ chapter.strategy }}</div>{% endif %}
    {% if chapter.exprs %}
    <div class="formula joined">
      <div class="f-rows">
        {% for r in chapter.exprs %}
        <div class="f-row"><span class="f-en">{{ r.en }}</span>
          <span class="f-arrow">→</span><span class="f-ko">{{ r.ko }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}
  {% if chapter.examples %}
  <div class="ex-label">유추 시연 <span>· 단서로 뜻 뚫기</span></div>
  <ol class="wb-ex">
    {% for e in chapter.examples %}
    <li><span class="n">{{ loop.index }}</span>{{ (e.cut_en or e.en) | replace(' / ', ' <b class="cslash">/</b> ') | safe }}
      {% if e.src %}<span class="src-chip">{{ e.src }}</span>{% endif %}
      {% if e.how %}<div class="wb-how"><span class="how-tag infer">유추</span>{{ e.how }}</div>{% endif %}
      {% if e.cut %}<div class="wb-cut"><span class="cut-tag">끊어읽기</span>{{ e.cut }}</div>{% endif %}
      {% if e.catch %}<div class="wb-catch"><span class="catch-tag">이 정도는 캐치</span>{{ e.catch }}</div>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</section>
{% if chapter.practice %}{{ drill_pages(chapter.title, chapter.practice) }}{% endif %}
{% endfor %}
{% endif %}
