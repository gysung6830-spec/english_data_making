<!-- 구문해석 실전서 — 표지 · 목차 · 0부 · 1부 · 2부 -->

{% set nums = ['①','②','③','④','⑤'] %}
{% macro vocab_block(vocab) %}
<div class="vocab-box">
  <div class="vocab-title">📦 이 페이지 핵심 어휘</div>
  <div class="vocab-grid">
  {% for v in vocab %}<div class="vocab-item"><b>{{ v.word }}</b> {{ v.meaning }}</div>{% endfor %}
  </div>
</div>
{% endmacro %}

{% macro problems_block(problems) %}
<div class="problems">
  <div class="prob-title">🧪 문제 <span>· 예시 외 기출로 직접 풀어 보기</span></div>
  {% for p in problems %}
  <div class="problem">
    <div class="prob-head">
      <span class="prob-kind {{ p.kind }}">{{ '객관식' if p.kind=='mc' else '주관식' }}</span>
      {% if p.source %}<span class="src-chip">📄 {{ p.source }}</span>{% endif %}
    </div>
    <div class="prob-sentence">{{ p.sentence }}</div>
    <div class="prob-prompt">Q. {{ p.prompt }}</div>
    {% if p.kind == 'mc' %}
      {% for opt in p.options %}
      <div class="prob-opt">{{ nums[loop.index0] }} {{ opt }}</div>
      {% endfor %}
      <div class="prob-answer">정답 {{ nums[p.answer_index] }} · {{ p.point }}</div>
    {% else %}
      <div class="prob-answer">모범답안 · {{ p.answer }}</div>
      {% if p.trap %}<div class="prob-trap">⚠️ 흔한 오역 · {{ p.trap }}</div>{% endif %}
      {% if p.point %}<div class="prob-point">🔑 {{ p.point }}</div>{% endif %}
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endmacro %}

<!-- 표지 -->
<section class="cover">
  <div class="kicker">{{ guide.kicker }}</div>
  <h1>{{ guide.title }}</h1>
  <div class="rule"></div>
  <div class="sub">{{ guide.subtitle }}</div>
  {% if sample %}<div style="height:26px"></div><div class="badge-sample">SAMPLE · 미리보기</div>{% endif %}
</section>

<!-- 목차 -->
<section class="toc">
  <div class="toc-title">목차 <span class="toc-en">CONTENTS</span></div>

  {% if guide.part0 %}
  <div class="toc-part"><a href="#part0">0부 · 기본기 — {{ guide.part0.title }}</a></div>
  {% for m in guide.part0.methods %}
  <div class="toc-item"><a href="#part0">{{ m.step }} · {{ m.title }}</a></div>
  {% endfor %}
  {% endif %}

  {% if guide.chapters %}
  <div class="toc-part"><a href="#part1">1부 · 평가원 코드 — 잘못 읽으면 큰일나는 구문: 필자의 긍정(O)/부정(X) 파악</a></div>
  {% for c in guide.chapters %}
  <div class="toc-item"><a href="#ch-{{ c.id }}">Ch{{ loop.index }} · {{ c.title }}</a></div>
  {% endfor %}
  {% endif %}

  {% if guide.paraphrase %}
  <div class="toc-part"><a href="#partP">2부 · 패러프레이징 — 핵심주제가 어떻게 다른 표현으로 전개되는가</a></div>
  <div class="toc-item"><a href="#partP">지문 단위 훈련 (주제 제시 → 재진술 → 예시 → 결론)</a></div>
  {% endif %}

  {% if guide.part2 %}
  <div class="toc-part"><a href="#part2">3부 · 구문해석 — 이런 구조면 이렇게 해석</a></div>
  {% for c in guide.part2.chapters %}
  <div class="toc-item"><a href="#sx-{{ c.id }}">Ch{{ loop.index }} · {{ c.title }}</a></div>
  {% endfor %}
  {% endif %}
</section>

{# ===================== 0부 — 3단계 읽기 엔진 ===================== #}
{% if guide.part0 %}
{% set p0 = guide.part0 %}
<section class="chapter" id="part0">
  <div class="ch-kicker">0부 · 기본기</div>
  <div class="ch-title">{{ p0.title }}</div>
  <div class="spine">“{{ p0.spine }}”</div>
  <div class="ch-signal">{{ p0.intro }}</div>

  {% for m in p0.methods %}
  <div class="method">
    <div class="method-head"><span class="step">{{ m.step }}</span> {{ m.title }}</div>
    <div class="method-idea">{{ m.idea }}</div>
    {% if m.rule %}<div class="method-rule"><b>규칙 ·</b> {{ m.rule }}</div>{% endif %}
    {% if m.ms_point %}<div class="ms-point">🎒 중3 포인트 · {{ m.ms_point }}</div>{% endif %}
    {% if m.demo %}
    <div class="demo">
      <div class="demo-step"><span class="dtag s1">① 괄호치기</span>
        <span class="demo-en">{{ m.demo.bracketed or m.demo.sentence }}</span></div>
      <div class="demo-step"><span class="dtag s2">② 뼈대(중3)</span>
        <span class="skel-en">{{ m.demo.skeleton_en }}</span>
        <span class="skel-ko">— {{ m.demo.skeleton_ko }}</span></div>
      <div class="demo-step"><span class="dtag s3">③ 완성</span>
        <span class="demo-full">{{ m.demo.full_ko }}</span></div>
    </div>
    {% endif %}
  </div>
  {% endfor %}

  {% if p0.tools %}
  <div class="tools">
    <div class="tools-title">🔧 미니 도구</div>
    {% for t in p0.tools %}<div class="tool">{{ t }}</div>{% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

{# ===================== 1부 — 평가원 코드 ===================== #}
{% if guide.chapters %}
<section class="chapter" id="part1">
  <div class="ch-kicker">1부 · 평가원 기능어 특집</div>
  <div class="ch-title">답으로 이어지는 평가원 코드</div>
  <div class="ch-signal">
    평가원 문장은 추상적이고 수식어가 많다. 그런데 <b>기능어(평가원 코드)</b>만 정확히 잡으면
    문장이 어느 방향으로 흐르는지 — 그리고 답이 어디로 이어지는지 — 가 보인다.
    같은 유형의 코드를 모아, 흔한 <b style="color:var(--wrong)">오역</b>과
    <b style="color:var(--right)">올바른 해석 방향</b>을 나란히 익힌다.
  </div>
</section>

{% for chapter in guide.chapters %}
<section class="chapter" id="ch-{{ chapter.id }}">
  <div class="ch-kicker">Ch{{ loop.index }}</div>
  <div class="ch-title">{{ chapter.title }}</div>
  <div class="ch-signal">{{ chapter.signal }}</div>
  <div class="ch-intro">
    <div><span class="lbl">이 유형의 대표 오역 ·</span>
      <span class="misread">{{ chapter.misread }}</span></div>
    <div class="tip"><span class="lbl">💡 코드를 만나면 ·</span> {{ chapter.tip }}</div>
  </div>
  {% if chapter.core_tip or chapter.infer_tip %}
  <div class="tip-cards">
    {% if chapter.core_tip %}<div class="tip-card core"><b>🎯 핵심 파악</b> {{ chapter.core_tip }}</div>{% endif %}
    {% if chapter.infer_tip %}<div class="tip-card infer"><b>🔮 유추법</b> {{ chapter.infer_tip }}</div>{% endif %}
  </div>
  {% endif %}
  <div class="ex-label">예시 <span>중난이도·고난이도 기출</span></div>
  {% for card in chapter.cards %}
  <div class="card">
    <div class="card-head">
      <span class="code-chip">{{ card.code }}</span>
      <span class="code-ko">{{ card.code_ko }}</span>
      {% if card.difficulty %}<span class="diff diff-{{ card.difficulty }}">{{ card.difficulty }}난이도</span>{% endif %}
      {% set dl = card.dir | dir_label %}
      {% if dl %}<span class="dir-badge">{{ dl }}</span>{% endif %}
    </div>
    {% if card.source %}<div class="src-chip">📄 {{ card.source }}</div>{% endif %}
    <div class="sentence">
      {{ card.sentence | highlight_code(card.body.highlight) }}
    </div>
    {% if card.body.subject and card.body.action %}
    <div class="sv-line"><span class="sv-s">{{ card.body.subject }}</span>
      <span class="sv-arrow">→</span><span class="sv-v">{{ card.body.action }}</span></div>
    {% endif %}
    <div class="rows">
      <div class="ab wrong"><span class="tag">오역</span>{{ card.body.literal_trap }}
        <div class="why">↳ 왜 틀렸나 · {{ card.body.trap_why }}</div></div>
      <div class="ab right"><span class="tag">정답</span>{{ card.body.correct }}</div>
    </div>
    {% if card.body.so_what %}
    <div class="so-what"><span class="sw-tag">이런 내용</span>{{ card.body.so_what }}
      <span class="sw-note">(이 문장만으로 도출)</span></div>
    {% endif %}
    {% if card.body.skeleton %}<div class="skeleton">뼈대 · {{ card.body.skeleton }}</div>{% endif %}
    <div class="tip-line"><b>핵심 ·</b> {{ chapter.tip }}</div>
  </div>
  {% endfor %}

  {% if chapter.problems %}{{ problems_block(chapter.problems) }}{% endif %}
  {% if chapter.vocab %}{{ vocab_block(chapter.vocab) }}{% endif %}
</section>
{% endfor %}
{% endif %}

{# ===================== 2부 — 패러프레이징(지문 단위) ===================== #}
{% if guide.paraphrase %}
{% set pp = guide.paraphrase %}
<section class="chapter" id="partP">
  <div class="ch-kicker">2부 · 패러프레이징</div>
  <div class="ch-title">{{ pp.title }}</div>
  <div class="ch-signal">{{ pp.intro }}</div>
</section>
{% endif %}

{# ===================== 3부 — 구문별 괄호치기 실전 ===================== #}
{% if guide.part2 %}
{% set p2 = guide.part2 %}
<section class="chapter" id="part2">
  <div class="ch-kicker">3부 · 구문해석(문법구조)</div>
  <div class="ch-title">{{ p2.title }}</div>
  <div class="ch-signal">{{ p2.intro }}</div>
</section>

{% for chapter in p2.chapters %}
<section class="chapter" id="sx-{{ chapter.id }}">
  <div class="ch-kicker">Ch{{ loop.index }}</div>
  <div class="ch-title">{{ chapter.title }}</div>
  <div class="ch-signal">{{ chapter.signal }}</div>
  <div class="ch-intro rule-box">
    <div><span class="lbl">이런 구조면 ·</span> {{ chapter.signal }}</div>
    <div class="tip"><span class="lbl">→ 이렇게 해석 ·</span> {{ chapter.how }}</div>
  </div>
  {% if chapter.combat_tip %}
  <div class="tip-cards"><div class="tip-card combat"><b>⚔️ {{ chapter.combat_tip.split('—')[0] }}</b>{{ '—' + chapter.combat_tip.split('—',1)[1] if '—' in chapter.combat_tip else chapter.combat_tip }}</div></div>
  {% endif %}
  <div class="ex-label">예시 <span>중난이도·고난이도 기출</span></div>

  {% for card in chapter.cards %}
  <div class="card syntax">
    {% if card.source %}<div class="src-chip">📄 {{ card.source }}
      {% if card.difficulty %}<span class="diff diff-{{ card.difficulty }}">{{ card.difficulty }}난이도</span>{% endif %}</div>{% endif %}
    <div class="sentence">
      {{ card.sentence | bracket_mods(card.body.modifiers) }}
    </div>
    <div class="syn-step">
      <span class="dtag s2">뼈대(중3)</span>
      <span class="skel-en">{{ card.body.skeleton_en }}</span>
      <span class="skel-ko">— {{ card.body.skeleton_ko }}</span>
    </div>
    {% if card.body.subject and card.body.action %}
    <div class="sv-line"><span class="sv-s">{{ card.body.subject }}</span>
      <span class="sv-arrow">→</span><span class="sv-v">{{ card.body.action }}</span></div>
    {% endif %}
    {% if card.body.modifiers %}
    <div class="mods">
      <div class="mods-title">🧩 살 붙이기</div>
      {% for mod in card.body.modifiers %}
      <div class="mod-row">
        <span class="mod-kind">{{ mod.kind }}</span>
        <span class="mod-phrase">( {{ mod.phrase }} )</span>
        <span class="mod-arrow">→</span>
        <span class="mod-mean">{{ mod.meaning }}</span>
        <span class="mod-conn">{{ mod.connector }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <div class="syn-full"><span class="dtag s3">완성</span>{{ card.body.full_ko }}</div>
    {% if card.body.real_meaning %}
    <div class="so-what"><span class="sw-tag">이런 내용</span>{{ card.body.real_meaning }}
      <span class="sw-note">(이 문장만으로 도출)</span></div>
    {% endif %}
    {% if card.body.self_check %}
    <div class="self-check">✅ 셀프체크 · {{ card.body.self_check }}</div>
    {% endif %}
  </div>
  {% endfor %}

  {% if chapter.problems %}{{ problems_block(chapter.problems) }}{% endif %}
  {% if chapter.vocab %}{{ vocab_block(chapter.vocab) }}{% endif %}
</section>
{% endfor %}
{% endif %}
