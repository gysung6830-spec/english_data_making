.env
__pycache__/
*.pyc
input/*.pdf
output/*.pdf
output/*.html
logs/*.jsonl
logs/*.log
.DS_Store
scratchpad/
output/*.png
output/*.jpg
output/*.json
web_uploads/

# 판매 사이트
store_data/store.db
store_data/store.db.tmp
store_data/*.json.tmp
# 손님이 올린 시험지 — 개인 자료라 저장소에 올리지 않습니다
store_data/submissions/*
!store_data/submissions/.gitkeep
# 판매하는 자료 원본 — 저장소에 올리면 누구나 받을 수 있으니 넣지 않습니다
store_data/deliverables/*
!store_data/deliverables/.gitkeep

# 무료 자료실에 올린 파일 (용량이 크고 자료라서 코드에 넣지 않습니다)
store_data/free/*
!store_data/free/.gitkeep

# 워터마크용 글꼴 캐시 (자동으로 다시 만들어집니다)
store_data/.cache/
