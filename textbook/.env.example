# .env — 웹앱(webapp/server.js) 환경변수. 이 파일을 .env 로 복사해서 채워 넣어.
# (.env 는 절대 커밋하지 말 것 — .gitignore 에 이미 등록됨)

# Claude API 키. 없으면 웹앱이 MOCK(형식만 채움) 으로 폴백한다.
ANTHROPIC_API_KEY=

# (선택) 사용할 모델. 기본값 claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# (선택) 키가 있어도 MOCK 로 강제하려면 1 로 설정 (로컬 파이프라인 테스트용).
# ANTHROPIC_MOCK=1

# (선택) 서버 포트. 기본 3000.
# PORT=3000
