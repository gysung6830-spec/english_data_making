{
  "name": "korean-grammar-textbook-generator",
  "version": "4.0.0",
  "private": true,
  "description": "수능 구문해석 교재 자동 생성기 — 문법 챕터별 [설명 → 같이 풀어보기 → 혼자 풀어보기] docx/pdf 생성",
  "main": "build_v4.js",
  "scripts": {
    "build": "node build_v4.js",
    "build:docx": "node build_v4.js --no-pdf",
    "validate": "node validate.js",
    "preview": "node preview_pdf.js",
    "web": "node webapp/server.js",
    "fonts": "node scripts/gen-fonts-embed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5"
  },
  "optionalDependencies": {
    "playwright": "^1.62.0"
  }
}
