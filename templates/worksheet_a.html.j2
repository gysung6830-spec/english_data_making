{#- 레이아웃 A : 분석 학습지형 (실제 참고 디자인 반영). 명세서 §3 -#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ analyses[0].title_en if analyses else '구문 분석 학습지' }}</title>
<style>
  :root{
    /* 김은아영어연구소 파일(초록 브랜드) 팔레트 — 디자인 그대로, 색만 회사색으로 */
    --navy:#2e8b54; --red:#cd5049; --blue:#2e8b54;      /* 성분·리본=초록, 어법=빨강 */
    --green:#2f9e5f; --purple:#6a54b3; --amber:#cf8a2a; /* 유의어=초록, 함축·지칭=보라, 포인트=주황 */
    --gray:#8a90a0; --ink:#20242e;
    --yellow-hl:#fbed9c; --green-hl:#dcecc4; --purple-hl:#e0daf1;
    --page-bg:#edf1ec; --line:#d3dcd3; --box-red:#e2b6b1; --tmi-line:#d7ddd6;
  }
  @page{ size:A4 portrait; margin:6mm 6mm; }   /* 학원 인쇄용: 상하좌우 여백 최소화 */
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  /* 한글·영문 '동일 글꼴' 보장: 임베드한 나눔스퀘어라운드만 쓰고, 없을 때만 generic sans.
     중간에 다른 한글 폰트(맑은고애·나눔고딕 등)를 두면 특정 글자가 그 폰트로 빠지며
     한글만 영문과 다른 서체로 보일 수 있으므로 스택에서 제거한다(지문독해 한/영 서체 통일). */
  body{
    font-family:'NanumSquareRound',sans-serif;
    color:var(--ink); font-size:13px; line-height:1.5; font-weight:400;
  }
  .page{ background:var(--page-bg); border-radius:18px; padding:15px 18px 16px; position:relative;
         page-break-after:always; }
  .page:last-child{ page-break-after:auto; }

  /* ---- 제비꼬리 리본 + 제목 ---- */
  .head{ display:flex; align-items:flex-start; gap:12px; margin:0 0 7px; min-height:52px; }
  /* 리본 폭은 '10-10'(가장 긴 유닛-문항 라벨)이 한 줄에 들어가도록 넉넉히. */
  .ribbon{ position:relative; width:68px; flex:0 0 68px; background:var(--navy); color:#fff;
           text-align:center; padding:8px 5px 13px; margin-top:-4px;
           box-shadow:inset 0 0 0 2px rgba(255,255,255,.28); }
  .ribbon .no{ font-size:19px; font-weight:800; line-height:1.05;
               white-space:nowrap; letter-spacing:-.5px; }
  .ribbon::after{ /* 하단 제비꼬리 V홈 (page-bg 삼각형이 아래 가운데를 파냄) */
    content:""; position:absolute; left:0; bottom:-1px; width:0; height:0;
    border-left:34px solid transparent; border-right:34px solid transparent;
    border-bottom:11px solid var(--page-bg); }
  .titles{ padding-top:2px; }
  .titles h1{ font-size:16px; font-weight:800; margin:0; line-height:1.2; color:#1c2030; }
  .titles .ko{ font-size:11.5px; color:#4a5064; margin-top:1px; font-weight:600; }

  /* ---- 지문 한눈 요약 박스(제목 밑, 본문 위) ---- */
  .summary{ margin:7px 0 2px; padding:6px 12px; background:#fff; border:1px solid var(--line);
            border-left:4px solid var(--navy); border-radius:8px; page-break-inside:avoid; }
  .summary .srow{ display:flex; align-items:baseline; gap:8px; }
  .summary .srow + .srow{ margin-top:3px; }
  .summary .slbl{ flex:0 0 auto; min-width:64px; text-align:center; box-sizing:border-box;
                  background:var(--navy); color:#fff; font-size:8.5px; font-weight:800;
                  border-radius:9px; padding:2px 8px; letter-spacing:.2px; }
  .summary .slbl.easy{ background:var(--amber); }        /* '쉽게 말하면' = 주황 */
  .summary .stx{ font-size:12px; line-height:1.5; color:#2c3340; font-weight:600; }  /* 본문(.tok .w 12px)과 크기 통일 */
  .page.compact .summary{ margin:9px 0 2px; padding:7px 11px; }
  .page.compact .summary .stx{ font-size:11px; line-height:1.55; }

  /* ---- 문장 행 ---- */
  .row{ display:grid; grid-template-columns:minmax(0,1fr) 200px; gap:12px; margin:18px 0 3px;
        padding-top:6px; page-break-inside:avoid; align-items:start; }
  .row:first-of-type{ margin-top:6px; }
  .analysis{ display:grid; grid-template-columns:26px 1fr; gap:6px; }
  /* 번호는 '본문 첫 단어 줄'과 높이를 맞춘다. 첫 줄에 성분(SVOC) 라벨이 있으면 그 라벨
     높이만큼 내려야 단어와 나란해진다(.analysis.lbl). 라벨이 없으면(학생용 등) 그대로 위. */
  .num{ color:var(--navy); font-weight:800; font-size:12px; line-height:1.4; }
  .analysis.lbl .num{ margin-top:13px; }

  /* 뱃지(함/빈/서) + 함축 영어줄 */
  .bdg{ display:inline-block; min-width:15px; height:15px; line-height:15px; text-align:center;
        background:var(--navy); color:#fff; font-size:9.5px; font-weight:700; border-radius:3px;
        padding:0 2px; vertical-align:1px; margin-right:3px; }
  .bdg.r{ background:var(--red); }
  .gloss{ margin:0 0 3px; font-size:11px; color:var(--blue); font-weight:600;
          background:var(--yellow-hl); display:inline-block; padding:1px 5px; border-radius:3px; }

  /* ---- 영문 라인 + 토큰 주석 ----
     각 토큰(.tok)의 너비는 '단어(.w)' 폭으로만 정해진다. 위/아래 주석(.over/.unders)은
     width:0 로 '띄워서' 단어 중앙에 얹기만 하므로, 긴 주석이 달려도 옆 단어를 밀지
     않는다 → 영문이 '일정한 간격'으로 매끄럽게 흐른다(한 문장을 온전히 읽기 쉽게).
     주석끼리 좌우로 살짝 겹칠 수 있으나 대개 주석이 드물어 문제되지 않는다. ---------*/
  .en{ margin-top:3px; }
  .en .line{ margin-bottom:6px; }          /* 줄바꿈된 같은 문장 줄 사이 여백(넉넉하게) */
  .en .line:last-of-type{ margin-bottom:0; }
  .tok{ display:inline-block; vertical-align:top; text-align:center; margin:0 3.5px; }
  /* 위(over) = 문장 성분 라벨(S·V·O 등). width:0 → 단어 폭에 영향 없음 */
  .tok .over{ display:flex; flex-direction:column; align-items:center; justify-content:flex-end;
              margin:0 auto 1px; width:0; height:0; overflow:visible; line-height:1.05;
              white-space:nowrap; text-align:center; }
  .tok .over .lbl{ color:#7c828c; font-weight:800; font-size:8.5px; }   /* 성분(SVOC) 라벨 = 회색 */
  .en .line.po .tok .over{ height:11px; }   /* 성분 라벨이 있는 줄만 상단 공간 확보(단어 정렬) */
  /* 긴 토큰(구절 단위)은 줄바꿈 허용 → 컬럼 폭을 넘겨 포인트 박스를 밀어내는 오류 방지.
     짧은 토큰(주석 달린 단어)은 어차피 한 줄에 들어가 정렬 유지. */
  .tok{ max-width:100%; }
  .tok .w{ display:block; font-size:12px; line-height:1.5; white-space:normal; overflow-wrap:break-word; }
  .tok .w.hl-y{ background:var(--yellow-hl); }
  .tok .w.hl-g{ background:var(--green-hl); }
  .tok .w.hl-p{ background:var(--purple-hl); }
  .tok .w.underline{ text-decoration:underline; text-underline-offset:2px; }
  .tok .w.red{ color:var(--red); font-weight:600; }
  /* 유의어/반의어가 달린 어휘 = 초록 '밑줄'(글씨색은 그대로; 어법이면 빨강 유지) */
  .tok .w.vu{ text-decoration:underline; text-decoration-color:var(--green);
              text-decoration-thickness:1.5px; text-underline-offset:1.5px; }
  /* 밑줄(초록)과 아래 주석이 겹치지 않도록 아래 주석을 충분히 띄운다 */
  .tok .unders{ display:flex; flex-direction:column; align-items:center; margin:4px auto 0;
                width:0; line-height:1.15; overflow:visible; }   /* width:0 → 단어 폭에 영향 없음 */
  /* 아래(unders) = 어법 번호(빨강) + 유의어(= 파랑)/반의어(↔ 회색) + 오답(X) */
  .ann{ font-size:9px; line-height:1.12; white-space:nowrap; text-align:center;
        max-width:160px; }   /* 아주 긴 주석만 방어적으로 제한(대개 짧음) */
  .ann.red{ color:var(--red); font-weight:800; font-size:9px; line-height:1; }
  .ann.syn{ color:var(--green); }   /* 유의어(=) 초록 글씨(밑줄 없음) */
  .ann.ant{ color:var(--gray); }    /* 반의어(↔) 차분한 회색 */
  .ann.gray{ color:var(--gray); }
  .ann.x{ color:var(--gray); font-weight:600; }

  .kotr{ margin-top:11px; color:#5b6172; font-size:12px; line-height:1.6; }

  /* 끊어읽기 경계 '/' + 직독직해 줄 + 온전한 해석 박스 */
  .sl{ color:#b6c0b6; font-weight:700; padding:0 4px; }
  .tsl{ margin:0 1px; }                         /* 영어 끊어읽기 '/' — 단어와 같은 baseline */
  .tsl .w{ color:#b6c0b6; font-weight:700; }
  /* 직독직해 줄: [뱃지 | 해석텍스트] 2단 그리드.
     뱃지는 번호(01) 밑 '왼쪽 여백(gutter)'에만 있고, 한글 해석은 오른쪽 텍스트 칸에서만
     흐른다 → 줄바꿈돼도 해석이 번호·뱃지 칸(왼쪽 세로선)을 침범하지 않는다. */
  /* 직독직해 줄: 한글 해석을 위 영어 본문과 '같은 왼쪽 위치'에서 시작하게 하고,
     '직독직해' 뱃지는 번호(01) 밑 왼쪽 여백(gutter)에 절대배치해 본문을 밀지 않는다. */
  .rdko{ position:relative; margin-top:9px; font-size:12px; line-height:1.95; color:#39424c; }
  .rdtext{ display:block; min-width:0; padding-left:3.5px; }  /* 첫 토큰(margin 3.5px)과 좌측 정렬 */
  .rdlbl{ position:absolute; left:-32px; top:3px; width:30px; box-sizing:border-box; text-align:center;
          background:var(--navy); color:#fff; font-size:7px; font-weight:800;
          padding:1px 2px; border-radius:7px; white-space:nowrap; letter-spacing:-.3px; }
  .rdko .rc{ font-weight:500; }
  .kobox{ margin-top:7px; background:#eef4ec; border:1px solid #cfe0cf; border-left:4px solid var(--navy);
          border-radius:8px; padding:5px 10px; font-size:9.5px; line-height:1.45; color:#232a24; }
  .kblbl{ display:inline-block; background:var(--navy); color:#fff; font-size:8px; font-weight:800;
          padding:1px 6px; border-radius:8px; margin-right:6px; vertical-align:1px; }

  /* ---- 우측 박스 : 알약형 헤더 + 라운드 박스(이전 스타일). 초록 톤과 어울리는 두 색으로 구별 ---- */
  .points{ display:flex; flex-direction:column; gap:9px; }
  .pbox{ background:#fff; border:1.5px solid var(--line); border-radius:13px; padding:0 11px 10px;
         font-size:10px; line-height:1.55; }
  .pbox .cap{ display:block; text-align:center; font-weight:800; font-size:10px; color:#fff;
              border-radius:20px; padding:2px 9px; margin:7px 0 5px; }
  /* 박스 안 어법 번호 = 인라인과 동일(빨강, 크게) */
  .pbox .gn{ color:var(--red); font-weight:800; font-size:12.5px; }
  /* 문장별 '합친' 박스(중립 배경). 뱃지 색은 '종류별'로: 어법=민트, 독해=골드
     (연한 파스텔 채움 + 진한 글자). */
  .pbox.merged{ border-color:#e5eae6; background:#fff; }
  .cap.gcap{ background:#dcece6; color:#2f6f63; }   /* 어법 Point = 민트 파스텔 */
  .cap.fcap{ background:#f4e7cf; color:#8a5f22; }   /* 독해 Point = 골드 파스텔 */
  .pbox .fr{ margin:2px 0; }
  .pbox .fl{ font-weight:800; color:#37827b; }
  .pbox .fl.im{ color:#37827b; }             /* 함축 라벨은 틸 */
  .pbox .fl.ref{ color:var(--purple); }      /* 지칭 라벨=보라(본문 대명사 점선과 짝) */
  /* 지칭 대명사: 독해 Point '지칭' 설명이 가리키는 본문 단어에 보라 점선 → 위치 연결 */
  .tok .w.refu{ border-bottom:1.6px dotted var(--purple); }
  /* 중요 문장(주제문·서술형 등): 번호를 채운 네모로 강조 → 한눈에 식별 */
  .row.imp .num{ color:#fff; background:var(--navy); border-radius:6px;
                 padding:2px 4px; text-align:center; align-self:start; }
  .row.imp.lbl .num, .row.imp .analysis.lbl .num{ margin-top:11px; }
  .analysis .num .sbadge{ display:block; font-size:8px; font-weight:800;
                          line-height:1.1; margin-top:1px; }
  .pbox .gko{ color:#4a5064; font-size:9.5px; }  /* 함축 한글 병기(작게) */
  .pbox b, .pbox strong{ font-weight:800; }

  /* ---- 압축(compact) 밀도: 한 지문을 최대한 1페이지에 ---- */
  .page.compact{ padding:14px 18px 26px; }
  .page.compact .head{ margin-bottom:5px; min-height:48px; }
  .page.compact .row{ margin:9px 0 2px; padding-top:3px; }
  .page.compact .en{ margin-top:1px; }
  .page.compact .en .line{ margin-bottom:6px; }
  .page.compact .en .line.po .tok .over{ height:9px; }
  .page.compact .tok .w{ font-size:11px; line-height:1.45; }
  .page.compact .tok .over .lbl{ font-size:8px; }
  .page.compact .ann{ font-size:8.5px; }
  .page.compact .ann.red{ font-size:9px; }
  .page.compact .kotr{ margin-top:6px; font-size:11.5px; line-height:1.45; }
  .page.compact .rdko{ margin-top:5px; font-size:11px; line-height:1.75; }
  .page.compact .kobox{ margin-top:5px; font-size:9.5px; line-height:1.4; padding:4px 9px; }
  .page.compact .num{ font-size:11px; }
  .page.compact .points{ gap:6px; }
  .page.compact .pbox{ font-size:10px; padding:0 9px 6px; }
  .page.compact .pbox .cap{ font-size:9.5px; padding:2px 8px; margin:6px 0 4px; }
  .page.compact .pbox .gn{ font-size:11.5px; }
  /* roomy(13px): 짧은 지문을 크게 키워 페이지 하단 여백을 채운다(학원 인쇄용 밀도). */
  .page.roomy .en .line{ margin-bottom:8px; }
  .page.roomy .tok .w{ font-size:13px; line-height:1.62; }
  .page.roomy .kotr{ margin-top:12px; font-size:13px; line-height:1.65; }
  .page.roomy .rdko{ margin-top:10px; font-size:13px; line-height:2.05; }
  .page.roomy .num{ font-size:13px; }
  .page.roomy .gloss{ font-size:12px; }
  .page.roomy .summary .stx{ font-size:13px; line-height:1.55; }
  .page.roomy .pbox{ font-size:12px; }
  .page.roomy .pbox .cap{ font-size:10.5px; }
  .page.roomy .pbox .gn{ font-size:13px; }
  /* 뒷면(정리): 원문·전체해석 + 어휘 + 논리흐름 — '읽기 좋은' 고정 크기(작다는 피드백 반영해 확대).
     내용이 많으면 자연 분할로 2쪽이 되며, 섹션 분할을 허용해 첫 쪽부터 꽉 채운다. */
  .page.compact .bhead{ margin-bottom:12px; }
  .page.compact .sec{ margin-bottom:13px; }
  .page.compact .sec > .st{ font-size:13.5px; margin-bottom:7px; }
  .page.compact .pcol{ padding:9px 12px; }
  .page.compact .ptext{ font-size:12px; line-height:1.8; }          /* 원문·전체해석 = 12px */
  .page.compact .ptext .pnum{ font-size:9.5px; min-width:15px; height:15px; line-height:15px; }
  .page.compact .vtab{ font-size:10px; }                            /* 어휘표 = 10px */
  .page.compact .vtab th, .page.compact .vtab td{ padding:4px 8px; }
  .page.compact .vtab th{ font-size:10px; }
  .page.compact .flow .step{ padding:6px 12px 7px; }
  .page.compact .flow .step .lb{ font-size:8.5px; padding:2px 9px; }
  .page.compact .flow .step .sn{ font-size:9px; }
  .page.compact .flow .step .tx{ font-size:10px; }                  /* 논리 흐름 = 10px */
  .page.compact .flow .step .ez{ font-size:9.5px; margin-top:3px; padding-top:3px; }
  .page.compact .flow .step .ez .ezt{ font-size:8.5px; padding:1px 6px; }
  .page.compact .flow .arrow{ font-size:12px; margin:2px 0; }

  /* 앞면(분석)이 넘칠 때 한 단계 더 압축(ultra). 여백·박스 먼저, 폰트는 바닥선까지만.
     가독성 바닥선: 영어 11.5px · 한글(직독직해/해석) 9.5px. 그래도 넘치는 장문은 2페이지. */
  .page.compact.ultra{ padding:11px 15px 20px; }
  .page.compact.ultra .head{ margin-bottom:4px; min-height:40px; }
  .page.compact.ultra .row{ margin:3px 0 1px; padding-top:2px; }
  .page.compact.ultra .en{ margin-top:0; }
  .page.compact.ultra .en .line{ margin-bottom:2px; }
  .page.compact.ultra .en .line.po .tok .over{ height:8px; }
  .page.compact.ultra .tok .w{ font-size:13px; line-height:1.35; }
  .page.compact.ultra .tok .over .lbl{ font-size:7.5px; }
  .page.compact.ultra .ann{ font-size:8px; }
  .page.compact.ultra .ann.red{ font-size:9.5px; }
  .page.compact.ultra .rdko{ margin-top:3px; font-size:13px; line-height:1.6; }
  .page.compact.ultra .rdlbl{ font-size:8px; padding:0 5px; }
  .page.compact.ultra .kobox{ margin-top:2px; font-size:9.5px; line-height:1.35; padding:3px 8px; }
  .page.compact.ultra .kblbl{ font-size:7.5px; }
  .page.compact.ultra .num{ font-size:13px; }
  .page.compact.ultra .points{ gap:4px; }
  .page.compact.ultra .pbox{ font-size:10.5px; padding:0 8px 4px; }
  .page.compact.ultra .pbox .cap{ font-size:10.5px; padding:2px 7px; margin:4px 0 3px; }
  .page.compact.ultra .pbox .gn{ font-size:11px; }

  /* ---- 포인트 박스 정렬 모드 ---- */
  /* even: 문장 행 높이를 균일하게 → 좌우가 규칙적으로 '일렬' */
  .page.bx-even .row{ min-height:118px; }
  .page.compact.bx-even .row{ min-height:98px; }
  .page.compact.ultra.bx-even .row{ min-height:82px; }
  /* uniform: 모든 포인트 박스 최소 높이를 같게 → 박스 크기 통일 */
  .page.bx-uniform .pbox{ min-height:58px; }
  .page.compact.bx-uniform .pbox{ min-height:48px; }
  .page.compact.ultra.bx-uniform .pbox{ min-height:42px; }

  /* 페이지 번호 = 오른쪽 하단, 저작권 = 왼쪽 하단 */
  .foot{ position:absolute; right:22px; bottom:10px; font-size:10.5px; color:var(--gray); }
  .foot .dot{ color:var(--amber); }
  .foot .pg{ color:#9aa0b0; font-weight:800; font-size:13px; margin:0 5px; }
  .copyr{ position:absolute; left:22px; bottom:10px; font-size:9.5px; color:var(--gray); }

  /* ---- 뒷페이지(요약): 어휘 리스트 / 논리 흐름도 / 쉬운 예시 목차 ---- */
  .bhead{ display:flex; align-items:center; gap:10px; margin:0 0 14px; }
  .bhead .tag{ background:var(--navy); color:#fff; font-weight:800; font-size:12px;
               padding:4px 12px; border-radius:4px; flex:0 0 auto; white-space:nowrap; }
  .bhead h2{ font-size:16px; font-weight:800; margin:0; color:#1c2030; }
  /* 원문 · 전체 해석 2단 */
  .pcols{ display:grid; grid-template-columns:1fr; gap:8px; }   /* 원문·전체해석 = 세로 1단 */
  .pcol{ background:#eef4ec; border:1px solid #cfe0cf; border-radius:9px; padding:9px 11px; }
  .pclbl{ display:inline-block; background:var(--navy); color:#fff; font-size:9px; font-weight:800;
          padding:1px 9px; border-radius:9px; margin-bottom:6px; }
  .ptext{ font-size:11px; line-height:1.8; color:#232a24; text-align:justify; }
  .ptext .pnum{ display:inline-block; background:var(--navy); color:#fff; font-size:8px; font-weight:800;
                min-width:13px; height:13px; line-height:13px; text-align:center; border-radius:7px;
                padding:0 2px; margin:0 2px 0 1px; vertical-align:1px; }

  /* 원문 페이지: 원문/해석 각각 아래에 필기용 빈 박스. 한 페이지로 압축(작은 폰트) */
  .srcsec{ margin-bottom:8px; }
  .source .st{ margin-bottom:5px; }
  .source .ptext{ font-size:10.5px; line-height:1.65; }
  .writebox{ position:relative; margin-top:6px; height:104px; border:1px dashed #c3cdd6;
             border-radius:8px; background:repeating-linear-gradient(#fcfdfe,#fcfdfe 25px,#eef1f4 25px,#eef1f4 26px); }
  .writebox .wblbl{ position:absolute; top:4px; left:8px; font-size:8.5px; font-weight:800; color:#9aa4b0; }

  /* 활용 가이드 목차 */
  .gtoc{ margin-top:3px; }
  .gtocrow{ display:flex; align-items:baseline; font-size:12px; padding:3px 2px; }
  .gtoct{ font-weight:700; color:#2c3340; }
  .gtocdots{ flex:1; border-bottom:1px dotted #b7c0ca; margin:0 7px 3px; }
  .gtocpg{ font-weight:800; color:var(--navy); }
  /* 뒷면이 2페이지가 될 때 첫 페이지를 꽉 채우고 남는 것만 넘기도록 자연스러운 분할 허용.
     (원문/해석 블록·표의 행·흐름 단계는 각자 쪼개지지 않게 유지) */
  .sec{ margin-bottom:18px; }
  .pcols{ page-break-inside:avoid; }
  .vtab tr{ page-break-inside:avoid; }
  .flow .step{ page-break-inside:avoid; }
  .sec > .st{ display:inline-block; font-size:13px; font-weight:800; color:var(--navy);
              border-bottom:2px solid var(--navy); padding-bottom:2px; margin-bottom:9px; }
  /* 어휘 리스트 표 */
  .vtab{ width:100%; border-collapse:collapse; font-size:11.5px; }
  .vtab th, .vtab td{ border:1px solid var(--line); padding:5px 8px; text-align:left;
                      vertical-align:top; }
  .vtab th{ background:var(--navy); color:#fff; font-weight:700; font-size:11px; }
  .vtab tr:nth-child(even) td{ background:#f4f7fd; }
  .vtab .vn{ text-align:center; font-weight:700; color:var(--navy); white-space:nowrap; }
  .vtab .w{ font-weight:800; color:#20242e; white-space:nowrap; }
  .vtab .syn{ color:#2e7d4d; }   /* 유의어=진한 초록 */
  .vtab .ant{ color:#b23f36; }   /* 반의어=진한 빨강 */
  /* 논리 흐름 + 쉬운 예시 (같은 단계에 함께) */
  .flow{ display:flex; flex-direction:column; gap:0; }
  .flow .step{ border:1.5px solid var(--navy); border-radius:10px; padding:7px 12px 8px;
               background:#f4f7fd; }
  .flow .step .lb{ display:inline-block; background:var(--navy); color:#fff; font-weight:800;
                   font-size:9px; padding:1px 8px; border-radius:10px; margin-right:8px; }
  .flow .step .sn{ color:var(--gray); font-size:10px; font-weight:600; margin-left:6px; }
  .flow .step .tx{ font-size:12px; font-weight:700; }
  .flow .step .ez{ margin-top:4px; padding-top:4px; border-top:1px dashed #c3cde0; font-size:11.5px;
                   color:#33384a; }
  .flow .step .ez .ezt{ display:inline-block; background:#fff2c9; color:#8a6d16; font-weight:800;
                        font-size:9px; padding:1px 6px; border-radius:8px; margin-right:6px; }
  .flow .arrow{ text-align:center; color:var(--navy); font-size:14px; line-height:1;
                margin:3px 0; font-weight:800; }

  /* 정리 2단: 논리흐름(왼쪽) · 함축의미(오른쪽). 한쪽만 있으면 전체 폭 */
  .twocol{ display:grid; grid-template-columns:1fr 1fr; gap:0 16px; align-items:start; }
  .twocol > .sec{ margin-bottom:10px; }
  .twocol > .sec:only-child{ grid-column:1 / -1; }

  /* 출제 포인트 · 함축의미 — 카드(청록 톤). 2단 안에선 세로로 쌓임 */
  .impl{ display:grid; grid-template-columns:1fr; gap:7px; align-items:start; }
  .icard{ background:#eef6f4; border:1px solid #cde6e1; border-left:4px solid #0f8378;
          border-radius:9px; padding:7px 10px 8px; page-break-inside:avoid; }
  .icard .isnt{ display:inline-block; background:#0f8378; color:#fff; font-size:8.5px;
                font-weight:800; padding:1px 7px; border-radius:8px; }
  .icard .iph{ display:block; font-weight:800; color:#123f3a; font-size:11px; line-height:1.35;
               margin:3px 0 4px; }
  .icard .il{ font-size:10px; line-height:1.5; color:#33384a; margin:2px 0; }
  .icard .il b{ color:#0f8378; font-weight:800; margin-right:3px; }
  .icard .itrap{ font-size:9.5px; line-height:1.45; color:#8a5f22; background:#fff5e0;
                 border-radius:7px; padding:3px 8px; margin-top:5px; }
  .page.compact .impl{ gap:7px; }
  .page.compact .icard .iph{ font-size:10.5px; }
  .page.compact .icard .il{ font-size:9.5px; }
  .page.compact .icard .itrap{ font-size:9px; }

  /* ---- 맨 앞 활용 가이드(표지) ---- */
  .ghead{ display:flex; align-items:center; gap:14px; margin:2px 0 16px; }
  .gribbon{ flex:0 0 auto; background:var(--navy); color:#fff; font-weight:800; font-size:14px;
            line-height:1.15; text-align:center; padding:12px 14px; border-radius:10px;
            box-shadow:inset 0 0 0 2px rgba(255,255,255,.28); }
  .ghead h1{ font-size:21px; font-weight:800; margin:0; color:#1c2030; }
  .ghead .ko{ font-size:13px; color:#4a5064; margin-top:3px; font-weight:600; }
  .gst{ display:inline-block; font-size:13px; font-weight:800; color:var(--navy);
        border-bottom:2px solid var(--navy); padding-bottom:2px; margin:16px 0 10px; }
  .glegend{ display:grid; grid-template-columns:1fr 1fr; gap:9px 20px; }
  .gitem{ font-size:12px; line-height:1.45; background:#fff; border:1px solid var(--line);
          border-radius:9px; padding:8px 11px; }
  .gitem .gt{ font-weight:800; }
  .gitem .gd{ color:#3a3f4c; }
  .gsw{ font-weight:700; }
  .gsw.role{ color:#7c828c; font-size:9px; font-weight:800; vertical-align:2px; }   /* 성분=회색 */
  .gsw.gram{ color:var(--red); }
  .gsw.num{ color:var(--red); font-weight:800; }
  .gsw.x{ color:var(--gray); font-weight:700; }
  .gsw.vu{ text-decoration:underline; text-decoration-color:var(--green);
           text-decoration-thickness:1.5px; text-underline-offset:2.5px; }
  .gsw.hy{ background:var(--yellow-hl); padding:0 3px; }
  .gsw.hp{ background:var(--purple-hl); padding:0 3px; }
  .gpill{ display:inline-block; font-size:9.5px; font-weight:800;
          border-radius:11px; padding:1px 8px; }
  .gpill.mint{ background:#dcece6; color:#2f6f63; }   /* 어법 Point = 민트 */
  .gpill.gold{ background:#f4e7cf; color:#8a5f22; }   /* 독해 Point = 골드 */
  .gsteps{ margin:0; padding-left:20px; font-size:12px; line-height:1.65; color:#23272e; }
  .gsteps li{ margin-bottom:3px; }
  .gsteps b{ font-weight:800; }
  .gtip{ margin-top:14px; background:#fff; border:1px solid var(--line);
         border-left:5px solid var(--navy); border-radius:9px; padding:9px 12px;
         font-size:12px; line-height:1.55; color:#23272e; }

  /* ---- 학생용(필기) 빈칸 ---- */
  .blk{ display:inline-block; border-bottom:1px dashed #c2cbd3; min-width:60px;
        height:12px; vertical-align:bottom; }
  .kobox .blk, .rdko .blk{ display:block; min-width:0; width:100%; height:13px;
        margin-top:2px; }
  .kobox.stu{ min-height:34px; }               /* 해석 필기 공간 */
  .pbox .body .blk{ display:block; width:100%; height:12px; margin:5px 0; }
  .pbox.stu .body{ min-height:30px; }
  .ptext.stu .blk{ display:block; width:100%; height:13px; margin:6px 0; }
  td.blkcell{ height:20px; }                    /* 어휘표 빈칸 셀 */

  /* ---- 단어 TEST(지문별) : [뜻 쓰기] + [유의어·반의어 줄 잇기]를 한 페이지에 ---- */
  .wtsub{ font-size:12px; color:#5b6172; margin:2px 0 7px; }
  .wtsub .qtag{ display:inline-block; background:var(--navy); color:#fff; font-weight:800;
                font-size:11px; padding:2px 10px; border-radius:10px; margin-right:6px; }
  .wtest{ display:grid; grid-template-columns:1fr 1fr; gap:0 34px; }
  .wtrow{ display:grid; grid-template-columns:22px auto 1fr; align-items:end; gap:9px;
          padding:6px 0 4px; border-bottom:1px dashed #cdd6cd; }
  .wtn{ color:var(--navy); font-weight:800; font-size:11px; text-align:right; padding-bottom:1px; }
  .wtw{ font-size:13px; font-weight:700; color:#20242e; white-space:nowrap; }
  .wtblank{ min-height:13px; }                   /* 뜻을 쓰는 빈칸(밑줄은 .wtrow 하단 점선) */

  /* 유의어·반의어 줄 잇기(매칭) : 왼쪽 단어 ↔ 오른쪽 보기(섞음)를 선으로 연결 */
  .msec{ margin-top:7px; break-inside:avoid; page-break-inside:avoid; }
  .msec .mtitle{ margin:2px 0 2px; }
  .msec .mtag{ display:inline-block; background:#2f9e5f; color:#fff; font-weight:800;
               font-size:11px; padding:2px 11px; border-radius:10px; }
  .match{ display:grid; grid-template-columns:1fr 1fr; gap:0 56px; padding:2px 10px 0; }
  .match .mrow{ display:flex; align-items:center; gap:8px; padding:4px 0; font-size:12.5px;
                border-bottom:1px dashed #e6ebe6; }
  .match .mleft .mrow{ flex-direction:row-reverse; text-align:right; }  /* 점 = 가운데(오른쪽) */
  .match .mn, .match .ml{ color:var(--navy); font-weight:800; font-size:11px; flex:0 0 auto; }
  .match .mw{ font-weight:700; color:#20242e; }
  .match .mleft .mw{ margin-left:auto; }                                /* 단어를 안쪽(점)으로 붙임 */
  .match .mdot{ width:8px; height:8px; border:1.6px solid var(--navy); border-radius:50%;
                flex:0 0 auto; background:#fff; }

  /* ---- 단어 TEST 정답(맨 마지막에 모아서, 페이지 나눔 없이 연속) ---- */
  .answers{ background:var(--page-bg); border-radius:22px; padding:20px 24px 26px;
            page-break-before:always; }
  .answers .ahead{ display:flex; align-items:center; gap:10px; margin:0 0 12px; }
  .answers .ahead .tag{ background:var(--navy); color:#fff; font-weight:800; font-size:13px;
                        padding:3px 12px; border-radius:6px; }
  .answers .ahead h2{ font-size:17px; font-weight:800; margin:0; color:#1c2030; }
  .ansblock{ margin-bottom:11px; }   /* 페이지 나눔 방지 해제 — 정답은 끊김 없이 연속으로 채움 */
  .anshd{ font-weight:800; font-size:12px; color:var(--navy);
          border-bottom:1.5px solid #b9ccb9; padding-bottom:3px; margin-bottom:5px; }
  .answrap{ display:grid; grid-template-columns:1fr 1fr; gap:2px 26px; }
  .ansitem{ font-size:11px; line-height:1.55; color:#232a24; }
  .ansitem .an{ color:var(--navy); font-weight:800; }
  .ansitem .aw{ font-weight:700; }
  .ansitem .am{ color:#4a5064; }
{% if bw %}
  /* ── 인쇄(흑백 친화) 모드: 음영 최소·테두리 중심·형광→밑줄(글자 크기·밀도는 그대로) ── */
  .page{ background:#ffffff !important; border-radius:12px; box-shadow:none; }
  .summary{ background:#ffffff !important; border:1px solid #c7ced6 !important; }
  .pbox, .pbox.merged{ background:#ffffff !important; border:1px solid #c7ced6 !important; }
  /* 포인트 박스 칩(어법/독해 Point)은 색을 '채워서' 유형 구분이 한눈에 되게 유지 */
  .cap.gcap{ background:#dcece6 !important; color:#215d53 !important; }   /* 어법 = 민트 */
  .cap.fcap{ background:#f4e7cf !important; color:#7c5316 !important; }   /* 독해 = 골드 */
  .kobox{ background:#ffffff !important; border:1px solid #c7ced6 !important; }
  .pcol{ background:#ffffff !important; border:1px solid #d7dde3 !important; }
  .vtab th{ background:#eef1f4 !important; color:#333 !important; }   /* 표 헤더만 아주 옅게 */
  /* ── 인쇄용 표기 구분(겹치지 않게 서로 다른 방식) ──
     어법=형광펜 / 주제문=테두리 박스 / 담화표지=대시 밑줄 / 지칭=점선 밑줄 */
  .en .w.red{ background:#fdf4c2 !important; color:#161616 !important;
              border-radius:2px; padding:0 1.5px; }              /* 어법 = 형광펜(연한 노랑) */
  .en .ann.red{ color:#1c1c1c !important; }                      /* 어법 번호·주석은 검정 */
  .en .w.hl-y{ background:transparent !important; border:1.3px solid #2b2b2b !important;
               border-radius:3px; padding:0 2px; font-weight:800; }  /* 주제문 = 테두리 박스 */
  .en .w.hl-p{ background:transparent !important;
               border-bottom:1.6px dashed #555 !important; }     /* 담화표지 = 대시 밑줄 */
  .tok .w.refu{ border-bottom:1.8px dotted #1c1c1c !important; } /* 지칭 = 점선 밑줄(검정) */
  /* 요약 라벨은 테두리형으로 */
  .slbl{ background:#ffffff !important; color:#3a4653 !important; border:1px solid #9aa4b0 !important; }
  .slbl.easy{ color:#7a5a1e !important; border-color:#cbb488 !important; }
  /* 정리(뒷면) 카드/흐름 음영 완화 */
  .icard{ background:#ffffff !important; }
  .flow .step{ background:#ffffff !important; }
  .ez{ background:#ffffff !important; }
{% endif %}
</style>
</head>
<body>
{%- set s_roles = (not student) or slevel == 'interp' -%}
{%- set s_gram  = (not student) or slevel == 'interp' -%}
{%- set s_slash = (not student) or slevel != 'blank' -%}
{%- set s_ko    = not student -%}   {# 직독직해·해석·전체해석·어휘뜻·논리흐름 텍스트 #}
{# 섹션 격리 플래그: 하나라도 켜지면 '그 섹션만' 렌더(합본 순서 재배치용) #}
{%- set _only = only_guide or only_front or only_source or only_summary or only_test or only_answer -%}
{% if only_guide or (include_guide and not _only) %}
<div class="page">
  <div class="ghead">
    <div class="gribbon">활용<br>가이드</div>
    <div>
      <h1>이 학습지 100% 활용법</h1>
      <div class="ko">색과 기호가 무엇을 뜻하는지 먼저 익히고 시작하세요.</div>
    </div>
  </div>

  <span class="gst">🎨 색 · 기호가 뜻하는 것</span>
  <div class="glegend">
    <div class="gitem"><span class="gsw role">S</span> <span class="gsw role">V</span> <span class="gsw role">O</span> <span class="gsw role">C</span>
      <span class="gt">문장 성분</span> — <span class="gd">단어 <b>위</b>에 표기. 주어·동사·목적어·보어(<b>회색</b>)</span></div>
    <div class="gitem"><span class="gsw gram">need</span> <span class="gsw num">①</span>
      <span class="gt">핵심 어법</span> — <span class="gd">빨간 글자 + 단어 <b>아래</b> 번호 ①②③</span></div>
    <div class="gitem"><span class="gsw x">who(X)</span>
      <span class="gt">오답형 함정</span> — <span class="gd">그 자리에 넣으면 <b>틀리는</b> 형태 — 오른쪽 <b>어법 Point 박스</b>에 표기</span></div>
    <div class="gitem"><span class="gsw vu">thrive</span>
      <span class="gt">유의어 · 반의어</span> — <span class="gd">초록 밑줄 (= 유의어 · ↔ 반의어)</span></div>
    <div class="gitem"><span class="gsw hy">주제문</span>
      <span class="gt">노란 형광</span> — <span class="gd">주제문 · 빈칸 출제 예상 어구</span></div>
    <div class="gitem"><span class="gsw hp">However</span>
      <span class="gt">라벤더 형광</span> — <span class="gd">담화표지(However, Similarly …)</span></div>
    <div class="gitem"><span class="gpill mint">N문장 - 어법 Point</span>
      <span class="gt gd"> — 문장별 어법을 ①②③로 정리(민트 박스)</span></div>
    <div class="gitem"><span class="gpill gold">N문장 - 독해 Point</span>
      <span class="gt gd"> — 대명사 지칭(it→…) · 숨은 함축 의미(골드 박스)</span></div>
  </div>

  <span class="gst">📖 이렇게 쓰세요</span>
  <ol class="gsteps">
    <li>앞면 <b>영어 원문</b>을 소리 내어 한 번 읽는다.</li>
    <li><b>성분(회색)</b>으로 문장의 뼈대(주어·동사)를 먼저 잡는다.</li>
    <li><b>어법(빨강 ①②③)</b>과 오른쪽 <b>민트 박스</b>로 시험 포인트 확인 — 특히 <b>(X) 함정</b>에 주의.</li>
    <li><b>골드 박스</b>로 대명사가 가리키는 것과 문장의 숨은 뜻을 확인한다.</li>
    <li>아래 <b>한글 해석</b>과 대조하며 직독직해로 한 번 더 읽는다.</li>
    <li><b>뒷면</b>의 핵심 어휘(유의어·반의어)와 논리 흐름으로 복습한다.</li>
  </ol>

  <div class="gtip">💡 <b>Tip.</b> 번호 <b>①②③</b>는 본문과 오른쪽 박스가 서로 <b>짝</b>이에요. 본문에서 색·번호를 먼저 보고, 박스에서 그 이유를 확인하세요.</div>

  {% if toc %}
  <span class="gst">📑 목차</span>
  <div class="gtoc">
    {% for it in toc %}
    <div class="gtocrow"><span class="gtoct">{{ it.label }}</span><span class="gtocdots"></span><span class="gtocpg">{{ it.page }}</span></div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}
{% for a in analyses %}
  {% if only_front or not _only %}
  {%- set fd = a.front_density -%}
  <div class="page{% if fd == 'compact' %} compact{% elif fd == 'ultra' %} compact ultra{% elif fd == 'roomy' %} roomy{% elif not fd and compact %} compact{% endif %}{% if boxmode %} bx-{{ boxmode }}{% endif %}">
    <div class="head">
      <div class="ribbon">
        <div class="no">{{ a.lecture_label or '★' }}</div>
      </div>
      <div class="titles">
        <h1>{{ a.title_en }}</h1>
        {% if a.title_ko %}<div class="ko">{{ a.title_ko }}</div>{% endif %}
      </div>
    </div>

    {% if a.summary or a.summary_easy %}
    <div class="summary">
      {% if a.summary %}<div class="srow"><span class="slbl">주제</span><span class="stx">{{ a.summary }}</span></div>{% endif %}
      {% if a.summary_easy %}<div class="srow"><span class="slbl easy">쉽게 말하면</span><span class="stx">{{ a.summary_easy }}</span></div>{% endif %}
    </div>
    {% endif %}

    {% for s in a.sentences %}
    {%- set first_has_role = s_roles and s.lines and (s.lines[0] | selectattr('role') | list) -%}
    <div class="row{% if s.important %} imp{% endif %}">
      <div class="analysis{% if first_has_role %} lbl{% endif %}">
        <div class="num">{{ "%02d"|format(s.index) }}{% if s.badge %}<span class="sbadge">{{ s.badge }}</span>{% endif %}</div>
        <div>
          <div class="en">
            {% for line in s.lines %}
            {%- set has_role = (line | selectattr('role') | list) and s_roles -%}
            <div class="line{% if has_role %} po{% endif %}">
              {%- for t in line -%}
                <span class="tok">
                  {# 위: 문장 성분 라벨(학생용 blank/slash 는 숨김) #}
                  {%- if has_role %}<span class="over">{% if t.role %}<span class="lbl">{{ t.role }}</span>{% endif %}</span>{% endif -%}
                  {%- set _a = t.above or '' -%}{%- set _n = t.note or '' -%}
                  {%- set is_vocab = _a[:1] in ['=', '↔'] or (t.note_kind != 'red' and _n[:1] in ['=', '↔']) -%}
                  {# 빨강 어법 글자색(t.color)은 학생용에도 항상 표시. 형광·밑줄·유의어는 s_gram 때만. #}
                  <span class="w{% if t.color %} {{ t.color }}{% endif %}{% if s_gram %}{% if t.hl %} hl-{{ t.hl }}{% endif %}{% if t.underline %} underline{% endif %}{% if is_vocab %} vu{% endif %}{% if t.ref_mark %} refu{% endif %}{% endif %}">{{ t.text | ansclean }}</span>
                  {# 아래: 어법 원문자 번호(빨강)는 학생용에도 표시 / 유의어·반의어·해석힌트는 s_gram 때만.
                     (X) 오답형은 어법 Point 박스에 있으므로 본문에선 생략. #}
                  {%- set _redmark = t.note and t.note_kind == 'red' -%}
                  {%- if (s_gram and (t.above or t.note)) or _redmark -%}
                  <span class="unders">
                    {%- if s_gram and t.above %}<span class="ann {{ 'syn' if t.above.startswith('=') else 'ant' }}">{{ t.above }}</span>{% endif -%}
                    {%- if t.note and (_redmark or s_gram) %}<span class="ann {% if t.note_kind == 'red' %}red{% elif t.note.startswith('=') %}syn{% elif t.note.startswith('↔') %}ant{% else %}gray{% endif %}">{{ t.note }}</span>{% endif -%}
                  </span>
                  {%- endif -%}
                </span>
                {%- if t.slash and s_slash %}<span class="tok tsl">{% if has_role %}<span class="over"></span>{% endif %}<span class="w">/</span></span>{% endif -%}
              {%- endfor -%}
            </div>
            {% endfor %}
          </div>
          {# 끊어읽기: 직독직해(한글, / 구분) — 학생용은 빈칸 #}
          {% if s.reading_ko %}
          <div class="rdko"><span class="rdlbl">직독직해</span><span class="rdtext">
            {%- if s_ko -%}
              {%- for c in s.reading_ko.split(' / ') -%}
                <span class="rc">{{ c }}</span>{% if not loop.last %}<span class="sl">/</span>{% endif %}
              {%- endfor -%}
            {%- else -%}<span class="blk"></span>{%- endif -%}
          </span></div>
          {% endif %}
          {# (온전한 해석 카드는 삭제 — 전체 해석은 뒷면 '원문·전체 해석'에 있음) #}
        </div>
      </div>
      <div class="points">
        {% if s.points or s.has_feed %}
        {# 문장별로 어법·독해 포인트를 '한 박스'에 합침. 뱃지 색은 유지, 박스는 문장마다 번갈아. #}
        <div class="pbox merged {{ 'odd' if s.index % 2 == 1 else 'even' }}{% if not s_gram %} stu{% endif %}">
          {% for p in s.points %}
          <span class="cap {{ 'gcap' if p.is_grammar else 'fcap' }}">{{ p.caption }}</span>
          <div class="body">{% if s_gram %}{{ p.body_html | safe }}{% endif %}</div>
          {% endfor %}
          {% if s.has_feed %}
          <span class="cap fcap">{{ s.index }}문장 - 독해 Point</span>
          <div class="body">
            {%- if s_gram -%}
            {%- for r in s.refs %}<div class="fr"><span class="fl ref">지칭</span> {{ r }}</div>{% endfor -%}
            {% if s.gloss_en %}<div class="fr"><span class="fl im">함축</span> {{ s.gloss_en }}{% if s.gloss_ko %}<br><span class="gko">{{ s.gloss_ko }}</span>{% endif %}</div>{% endif %}
            {%- endif -%}
          </div>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}

    {# 저작권(좌)·페이지번호(우)는 합본 완성 후 하단 여백에 스탬프 #}
  </div>
  {% endif %}

  {% if (only_source or (include_back and not _only)) and a.sentences %}
  <div class="page compact source">   {#- 원문(지문별 페이지 나눔): 원문+필기 / 해석+필기, 한 페이지 압축 -#}
    <div class="bhead">
      <div class="tag">{{ a.lecture_label or '★' }}</div>
      <h2>{{ a.title_en }} · 원문 · 해석</h2>
    </div>

    <div class="sec srcsec">
      <div class="st">원문</div>
      <div class="pcol">
        <div class="ptext">
          {%- for s in a.sentences -%}<span class="pnum">{{ s.index }}</span> {{ s.text | ansclean }}{{ ' ' }}{%- endfor -%}
        </div>
      </div>
      <div class="writebox"><span class="wblbl">필기</span></div>
    </div>

    <div class="sec srcsec">
      <div class="st">전체 해석</div>
      <div class="pcol">
        <div class="ptext">
          {%- for s in a.sentences -%}<span class="pnum">{{ s.index }}</span> {{ s.translation }}{{ ' ' }}{%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {% if only_summary or (include_back and a.has_back and not _only) %}
  <div class="page compact">   {#- 정리 — 논리흐름 → 함축의미 → 핵심어휘(한 페이지 목표) -#}
    <div class="bhead">
      <div class="tag">{{ a.lecture_label or '★' }}</div>
      <h2>{{ a.title_en }} · 정리</h2>
    </div>

    {# 논리흐름(왼쪽) · 함축의미(오른쪽) 2단. 한쪽만 있으면 전체 폭 차지(:only-child) #}
    <div class="twocol">
      {% if a.flow %}
      <div class="sec">
        <div class="st">글의 논리 흐름 · 쉬운 예시</div>
        <div class="flow">
          {% for f in a.flow %}
          <div class="step">
            <div class="row1"><span class="lb">{{ f.label }}</span>{% if s_ko %}<span class="tx">{{ f.text }}</span>{% else %}<span class="tx"><span class="blk"></span></span>{% endif %}{% if f.sentences %}<span class="sn">(문장 {{ f.sentences }})</span>{% endif %}</div>
            {% if f.easy and s_ko %}<div class="ez"><span class="ezt">쉬운 예시</span>{{ f.easy }}</div>{% endif %}
          </div>
          {% if not loop.last %}<div class="arrow">▼</div>{% endif %}
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if a.implicit and s_ko %}
      <div class="sec">
        <div class="st">출제 포인트 · 함축의미</div>
        <div class="impl">
          {% for im in a.implicit %}
          <div class="icard">
            {% if im.sent %}<span class="isnt">{{ im.sent }}문장</span>{% endif %}
            {% if im.phrase %}<span class="iph">{{ im.phrase }}</span>{% endif %}
            {% if im.meaning_ko %}<div class="il"><b>문맥상 의미</b> {{ im.meaning_ko }}</div>{% endif %}
            {% if im.answer_en %}<div class="il"><b>영어 정답 표현</b> {{ im.answer_en }}</div>{% endif %}
            {% if im.trap_ko %}<div class="itrap">⚠️ 직역 함정 · {{ im.trap_ko }}</div>{% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>

    {% if a.vocab %}
    <div class="sec">
      <div class="st">핵심 어휘 · 유의어 · 반의어</div>
      <table class="vtab">
        <tr><th style="width:8%">문장</th><th style="width:21%">단어</th><th style="width:24%">뜻</th>
            <th style="width:23.5%">유의어(=)</th><th style="width:23.5%">반의어(↔)</th></tr>
        {% for v in a.vocab %}
        <tr>
          <td class="vn">{% if v.sent %}{{ v.sent }}번{% endif %}</td>
          <td class="w">{{ v.word }}</td>
          <td class="{% if not s_ko %}blkcell{% endif %}">{% if s_ko %}{{ v.meaning }}{% endif %}</td>
          <td class="syn {% if not s_ko %}blkcell{% endif %}">{% if s_ko %}{{ v.syn }}{% endif %}</td>
          <td class="ant {% if not s_ko %}blkcell{% endif %}">{% if s_ko %}{{ v.ant }}{% endif %}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}

    {# 저작권(좌)·페이지번호(우)는 합본 완성 후 하단 여백에 스탬프 #}
  </div>
  {% endif %}

  {# 지문별 '단어 TEST' — 한 페이지에 [단어 뜻 쓰기] + [유의어·반의어 줄 잇기] 함께 #}
  {% if (only_test or (include_test and not _only)) and (a.vocab_test or a.match_syn or a.match_ant) %}
  <div class="page">
    <div class="bhead">
      <div class="tag">{{ a.lecture_label or '★' }}</div>
      <h2>{{ a.title_en }} · 단어 TEST</h2>
    </div>

    {% if a.vocab_test %}
    <div class="wtsub"><span class="qtag">뜻 쓰기</span> 다음 영어 단어의 뜻을 쓰시오. <span style="color:#8a90a0">(정답은 맨 마지막 장에)</span></div>
    <div class="wtest">
      {% for v in a.vocab_test %}
      <div class="wtrow"><span class="wtn">{{ loop.index }}</span><span class="wtw">{{ v.word }}</span><span class="wtblank"></span></div>
      {% endfor %}
    </div>
    {% endif %}

    {% if a.match_syn or a.match_ant %}
    <div class="wtsub" style="margin-top:13px"><span class="qtag">연결</span> 왼쪽 단어와 뜻이 통하는 오른쪽 보기를 <b>선으로 이으시오.</b></div>
    {% for m, mlabel in [(a.match_syn, '유의어 (=)'), (a.match_ant, '반의어 (↔)')] %}
    {% if m %}
    <div class="msec">
      <div class="mtitle"><span class="mtag">{{ mlabel }} 연결</span></div>
      <div class="match">
        <div class="mcol mleft">
          {% for w in m['items'] %}
          <div class="mrow"><span class="mn">{{ loop.index }}</span><span class="mw">{{ w }}</span><span class="mdot"></span></div>
          {% endfor %}
        </div>
        <div class="mcol mright">
          {% for r in m['right'] %}
          <div class="mrow"><span class="mdot"></span><span class="ml">{{ abc(loop.index0) }}</span><span class="mw">{{ r }}</span></div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    {% endfor %}
    {% endif %}
  </div>
  {% endif %}
{% endfor %}

{# ── 단어 TEST 정답: 맨 마지막에 모아서, 지문마다 페이지 나눔 없이 연속 ── #}
{% if only_answer %}
<div class="answers">
  <div class="ahead"><span class="tag">정답</span><h2>단어 TEST · 정답</h2></div>
  {% for a in analyses %}{% if a.vocab_test %}
  <div class="ansblock">
    <div class="anshd">{{ a.lecture_label or '★' }}번 · {{ a.title_en }}</div>
    <div class="answrap">
      {% for v in a.vocab_test %}<span class="ansitem"><span class="an">{{ loop.index }}.</span> <span class="aw">{{ v.word }}</span> <span class="am">— {{ v.meaning }}</span></span>{% endfor %}
    </div>
    {% if a.match_syn or a.match_ant %}
    <div class="answrap" style="margin-top:5px">
      {% if a.match_syn %}<span class="ansitem"><span class="an">유의어 연결</span> {% for w in a.match_syn['items'] %}{{ loop.index }}-{{ abc(a.match_syn['answer'][loop.index0]) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
      {% if a.match_ant %}<span class="ansitem"><span class="an">반의어 연결</span> {% for w in a.match_ant['items'] %}{{ loop.index }}-{{ abc(a.match_ant['answer'][loop.index0]) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}{% endfor %}
</div>
{% endif %}
</body>
</html>
