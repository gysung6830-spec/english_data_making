{#- 레이아웃 A : 분석 학습지형 (실제 참고 디자인 반영). 명세서 §3 -#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ analyses[0].title_en if analyses else '구문 분석 학습지' }}</title>
<style>
  :root{
    --navy:#2e3a8c; --red:#e0473c; --blue:#3f6bd6; --gray:#8a90a0; --ink:#20242e;
    --yellow-hl:#fdf3b0; --green-hl:#e7eeb0; --purple-hl:#ddd6f3;
    --page-bg:#e9f1fc; --line:#cdd5e3; --box-red:#e2b6b1; --tmi-line:#d3dae7;
  }
  @page{ size:A4 portrait; margin:10mm 9mm; }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    font-family:'Nanum Gothic','NanumGothic','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;
    color:var(--ink); font-size:13px; line-height:1.5; font-weight:400;
  }
  .page{ background:var(--page-bg); border-radius:22px; padding:20px 22px 30px; position:relative;
         page-break-after:always; }
  .page:last-child{ page-break-after:auto; }

  /* ---- 제비꼬리 리본 + 제목 ---- */
  .head{ display:flex; align-items:flex-start; gap:16px; margin:0 0 12px; min-height:74px; }
  .ribbon{ position:relative; width:74px; flex:0 0 74px; background:var(--navy); color:#fff;
           text-align:center; padding:16px 4px 22px; margin-top:-4px;
           box-shadow:inset 0 0 0 2px rgba(255,255,255,.28); }
  .ribbon .no{ font-size:32px; font-weight:800; line-height:1.05; }
  .ribbon::after{ /* 하단 제비꼬리 V홈 (page-bg 삼각형이 아래 가운데를 파냄) */
    content:""; position:absolute; left:0; bottom:-1px; width:0; height:0;
    border-left:37px solid transparent; border-right:37px solid transparent;
    border-bottom:15px solid var(--page-bg); }
  .titles{ padding-top:12px; }
  .titles h1{ font-size:19px; font-weight:800; margin:0; line-height:1.22; color:#1c2030; }
  .titles .ko{ font-size:14px; color:#4a5064; margin-top:3px; font-weight:600; }

  /* ---- 문장 행 ---- */
  .row{ display:grid; grid-template-columns:1fr 200px; gap:12px; margin:18px 0 3px;
        padding-top:6px; page-break-inside:avoid; }
  .row:first-of-type{ margin-top:6px; }
  .analysis{ display:grid; grid-template-columns:26px 1fr; gap:6px; }
  .num{ color:var(--navy); font-weight:800; font-size:15px; line-height:1.4; }

  /* 뱃지(함/빈/서) + 함축 영어줄 */
  .bdg{ display:inline-block; min-width:15px; height:15px; line-height:15px; text-align:center;
        background:var(--navy); color:#fff; font-size:9.5px; font-weight:700; border-radius:3px;
        padding:0 2px; vertical-align:1px; margin-right:3px; }
  .bdg.r{ background:var(--red); }
  .gloss{ margin:0 0 3px; font-size:11px; color:var(--blue); font-weight:600;
          background:var(--yellow-hl); display:inline-block; padding:1px 5px; border-radius:3px; }

  /* ---- 영문 라인 + 토큰 주석 ----
     단어(.w)는 자연스러운 띄어쓰기로 촘촘히 흐르게 한다. 위/아래 주석(.over/.unders)은
     '폭 0' 의 flex 로 두어 단어 위·아래에 세로 공간만 차지하고 '가로 폭'은 넓히지 않는다.
     (흐름에 남아 있어 줄바꿈·정렬이 깨지지 않는다.) --------------------------------*/
  .en{ margin-top:3px; }
  .en .line{ margin-bottom:9px; }          /* 한 문장 안의 줄 사이 호흡 */
  .en .line:last-of-type{ margin-bottom:0; }
  .tok{ display:inline-block; vertical-align:top; text-align:center; margin:0 1.5px; }
  /* 위(over) = 문장 성분 라벨(S·V·O 등) */
  .tok .over{ display:flex; flex-direction:column; align-items:center; width:0; margin:0 auto 3px;
              height:0; overflow:visible; line-height:1.15; white-space:nowrap; text-align:center; }
  .tok .over .lbl{ color:var(--blue); font-weight:800; font-size:8.5px; }
  .en .line.po .tok .over{ height:11px; }   /* 성분 라벨이 있는 줄만 상단 공간 확보(단어 정렬) */
  .tok .w{ display:block; font-size:15px; line-height:1.5; white-space:nowrap; }
  .tok .w.hl-y{ background:var(--yellow-hl); }
  .tok .w.hl-g{ background:var(--green-hl); }
  .tok .w.hl-p{ background:var(--purple-hl); }
  .tok .w.underline{ text-decoration:underline; text-underline-offset:2px; }
  .tok .w.red{ color:var(--red); font-weight:600; }
  /* 유의어/반의어가 달린 어휘 = 파란 '밑줄'(글씨색은 그대로; 어법이면 빨강 유지) */
  .tok .w.vu{ text-decoration:underline; text-decoration-color:var(--blue);
              text-decoration-thickness:1.5px; text-underline-offset:2.5px; }
  .tok .unders{ display:flex; flex-direction:column; align-items:center; width:0; margin:3px auto 0;
                overflow:visible; }
  /* 아래(unders) = 어법 번호(빨강, 크게) + 유의어(= 파랑)/반의어(↔ 회색) + 오답(X) */
  .ann{ font-size:7.5px; line-height:1.2; white-space:nowrap; text-align:center; }
  .ann.red{ color:var(--red); font-weight:800; font-size:11.5px; line-height:1; }
  .ann.syn{ color:var(--blue); }
  .ann.ant{ color:var(--gray); }
  .ann.gray{ color:var(--gray); }
  .ann.x{ color:var(--gray); font-weight:600; }

  .kotr{ margin-top:11px; color:#5b6172; font-size:12.5px; line-height:1.6; }

  /* ---- 우측 박스 : 모두 같은 디자인(알약형 헤더 + 라운드 박스), 색만 구분 ---- */
  .points{ display:flex; flex-direction:column; gap:9px; }
  .pbox{ background:#fff; border:1.5px solid var(--line); border-radius:13px; padding:0 11px 10px;
         font-size:10.5px; line-height:1.55; }
  .pbox .cap{ display:block; text-align:center; font-weight:800; font-size:11px; color:#fff;
              border-radius:20px; padding:2px 10px; margin:8px 0 7px; }
  /* 박스 안 어법 번호 = 인라인과 동일(빨강, 크게) */
  .pbox .gn{ color:var(--red); font-weight:800; font-size:11.5px; }
  /* 어법 Point = 빨강 알약(채도 약간 낮춤) */
  .pbox.g{ border-color:#e6c9c9; }
  .pbox.g .cap{ background:#dd7169; }
  /* 떠먹여주는 Point(대명사 지칭 + 함축) = 파랑 알약(채도 약간 낮춤) */
  .pbox.feed{ border-color:#c2d0f0; }
  .pbox.feed .cap{ background:#6a89d4; }
  .pbox.feed .fr{ margin:3px 0; }
  .pbox.feed .fl{ font-weight:800; color:var(--blue); }
  .pbox.feed .fl.im{ color:#6b4fc0; }        /* 함축 라벨은 보라 */
  .pbox.feed .gko{ color:#4a5064; }          /* 함축 한글 병기 */
  .pbox b, .pbox strong{ font-weight:800; }

  /* ---- 압축(compact) 밀도: 한 지문을 최대한 1페이지에 ---- */
  .page.compact{ padding:14px 18px 26px; }
  .page.compact .head{ margin-bottom:8px; min-height:60px; }
  .page.compact .row{ margin:9px 0 2px; padding-top:3px; }
  .page.compact .en{ margin-top:1px; }
  .page.compact .en .line{ margin-bottom:5px; }
  .page.compact .en .line.po .tok .over{ height:9px; }
  .page.compact .tok .w{ font-size:13px; line-height:1.3; }
  .page.compact .tok .over .lbl{ font-size:7.5px; }
  .page.compact .ann{ font-size:7px; }
  .page.compact .ann.red{ font-size:10px; }
  .page.compact .kotr{ margin-top:6px; font-size:11px; line-height:1.45; }
  .page.compact .num{ font-size:13px; }
  .page.compact .points{ gap:6px; }
  .page.compact .pbox{ font-size:9.5px; padding:0 9px 6px; }
  .page.compact .pbox .cap{ font-size:9.5px; padding:2px 8px; margin:6px 0 4px; }
  .page.compact .pbox .gn{ font-size:10px; }

  .foot{ position:absolute; left:22px; bottom:10px; font-size:10.5px; color:var(--gray); }
  .foot .dot{ color:#f2c14e; }
  .foot .pg{ color:#9aa0b0; font-weight:800; font-size:13px; margin:0 5px; }
  .copyr{ position:absolute; right:22px; bottom:10px; font-size:9.5px; color:var(--gray); }

  /* ---- 뒷페이지(요약): 어휘 리스트 / 논리 흐름도 / 쉬운 예시 목차 ---- */
  .bhead{ display:flex; align-items:center; gap:10px; margin:0 0 14px; }
  .bhead .tag{ background:var(--navy); color:#fff; font-weight:800; font-size:12px;
               padding:4px 12px; border-radius:4px; }
  .bhead h2{ font-size:16px; font-weight:800; margin:0; color:#1c2030; }
  .sec{ margin-bottom:18px; page-break-inside:avoid; }
  .sec > .st{ display:inline-block; font-size:13px; font-weight:800; color:var(--navy);
              border-bottom:2px solid var(--navy); padding-bottom:2px; margin-bottom:9px; }
  /* 어휘 리스트 표 */
  .vtab{ width:100%; border-collapse:collapse; font-size:11.5px; }
  .vtab th, .vtab td{ border:1px solid var(--line); padding:5px 8px; text-align:left;
                      vertical-align:top; }
  .vtab th{ background:var(--navy); color:#fff; font-weight:700; font-size:11px; }
  .vtab tr:nth-child(even) td{ background:#f4f7fd; }
  .vtab .vn{ text-align:center; font-weight:700; color:var(--navy); white-space:nowrap; }
  .vtab .w{ font-weight:800; color:#20242e; white-space:nowrap; }
  .vtab .syn{ color:#2f7d4f; }   /* 유의어=초록 */
  .vtab .ant{ color:var(--red); } /* 반의어=빨강 */
  /* 논리 흐름 + 쉬운 예시 (같은 단계에 함께) */
  .flow{ display:flex; flex-direction:column; gap:0; }
  .flow .step{ border:1.5px solid var(--navy); border-radius:10px; padding:7px 12px 8px;
               background:#f4f7fd; }
  .flow .step .lb{ display:inline-block; background:var(--navy); color:#fff; font-weight:800;
                   font-size:10.5px; padding:1px 8px; border-radius:10px; margin-right:8px; }
  .flow .step .sn{ color:var(--gray); font-size:10px; font-weight:600; margin-left:6px; }
  .flow .step .tx{ font-size:12px; font-weight:700; }
  .flow .step .ez{ margin-top:4px; padding-top:4px; border-top:1px dashed #c3cde0; font-size:11.5px;
                   color:#33384a; }
  .flow .step .ez .ezt{ display:inline-block; background:#fff2c9; color:#8a6d16; font-weight:800;
                        font-size:9.5px; padding:1px 6px; border-radius:8px; margin-right:6px; }
  .flow .arrow{ text-align:center; color:var(--navy); font-size:14px; line-height:1;
                margin:3px 0; font-weight:800; }
</style>
</head>
<body>
{% for a in analyses %}
  <div class="page{% if compact %} compact{% endif %}">
    <div class="head">
      <div class="ribbon">
        <div class="no">{{ a.lecture_label or '★' }}</div>
      </div>
      <div class="titles">
        <h1>{{ a.title_en }}</h1>
        {% if a.title_ko %}<div class="ko">{{ a.title_ko }}</div>{% endif %}
      </div>
    </div>

    {% for s in a.sentences %}
    <div class="row">
      <div class="analysis">
        <div class="num">{{ "%02d"|format(s.index) }}</div>
        <div>
          <div class="en">
            {% for line in s.lines %}
            {%- set has_role = line | selectattr('role') | list -%}
            <div class="line{% if has_role %} po{% endif %}">
              {%- if loop.first and s.badge %}<span class="bdg r">{{ s.badge }}</span> {% endif -%}
              {%- for t in line -%}
                <span class="tok">
                  {# 위: 문장 성분 라벨 #}
                  {%- if has_role %}<span class="over">{% if t.role %}<span class="lbl">{{ t.role }}</span>{% endif %}</span>{% endif -%}
                  {%- set _a = t.above or '' -%}{%- set _n = t.note or '' -%}
                  {%- set is_vocab = _a[:1] in ['=', '↔'] or (t.note_kind != 'red' and _n[:1] in ['=', '↔']) -%}
                  <span class="w{% if t.hl %} hl-{{ t.hl }}{% endif %}{% if t.underline %} underline{% endif %}{% if t.color %} {{ t.color }}{% endif %}{% if is_vocab %} vu{% endif %}">{{ t.text }}</span>
                  {# 아래: 어법 번호 / 유의어·반의어 / 오답 #}
                  {%- if t.above or t.note or t.wrong -%}
                  <span class="unders">
                    {%- if t.above %}<span class="ann {{ 'syn' if t.above.startswith('=') else 'ant' }}">{{ t.above }}</span>{% endif -%}
                    {%- if t.note %}<span class="ann {% if t.note_kind == 'red' %}red{% elif t.note.startswith('=') %}syn{% elif t.note.startswith('↔') %}ant{% else %}gray{% endif %}">{{ t.note }}</span>{% endif -%}
                    {%- if t.wrong %}<span class="ann x">{{ t.wrong }}</span>{% endif -%}
                  </span>
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
            {% endfor %}
          </div>
          {% if s.translation %}<div class="kotr">{{ s.translation }}</div>{% endif %}
        </div>
      </div>
      <div class="points">
        {% for p in s.points %}
        <div class="pbox {{ 'g' if p.is_grammar else 'feed' }}">
          <span class="cap">{{ p.caption }}</span>
          <div class="body">{{ p.body_html | safe }}</div>
        </div>
        {% endfor %}
        {% if s.has_feed %}
        <div class="pbox feed">
          <span class="cap">{{ s.index }}번 문장 떠먹여주는 Point</span>
          <div class="body">
            {%- for r in s.refs %}<div class="fr"><span class="fl">지칭</span> {{ r }}</div>{% endfor -%}
            {% if s.gloss_en %}<div class="fr"><span class="fl im">함축</span> {{ s.gloss_en }}{% if s.gloss_ko %}<br><span class="gko">{{ s.gloss_ko }}</span>{% endif %}</div>{% endif %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}

    <div class="foot"><span class="dot">●</span><span class="pg">{{ loop.index }}</span>{% if footer_meta %}{{ footer_meta }}{% endif %}</div>
    {% if footer_note %}<div class="copyr">{{ footer_note }}</div>{% endif %}
  </div>

  {% if include_back and a.has_back %}
  <div class="page{% if compact %} compact{% endif %}">
    <div class="bhead">
      <div class="tag">{{ a.lecture_label or '★' }}</div>
      <h2>{{ a.title_en }} · 정리</h2>
    </div>

    {% if a.vocab %}
    <div class="sec">
      <div class="st">핵심 어휘 · 유의어 · 반의어</div>
      <table class="vtab">
        <tr><th style="width:8%">문장</th><th style="width:21%">단어</th><th style="width:24%">뜻</th>
            <th style="width:23.5%">유의어(=)</th><th style="width:23.5%">반의어(↔)</th></tr>
        {% for v in a.vocab %}
        <tr>
          <td class="vn">{% if v.sent %}{{ v.sent }}번{% endif %}</td>
          <td class="w">{{ v.word }}</td>
          <td>{{ v.meaning }}</td>
          <td class="syn">{{ v.syn }}</td>
          <td class="ant">{{ v.ant }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}

    {% if a.flow %}
    <div class="sec">
      <div class="st">글의 논리 흐름 · 쉬운 예시</div>
      <div class="flow">
        {% for f in a.flow %}
        <div class="step">
          <div class="row1"><span class="lb">{{ f.label }}</span><span class="tx">{{ f.text }}</span>{% if f.sentences %}<span class="sn">({{ f.sentences }}번)</span>{% endif %}</div>
          {% if f.easy %}<div class="ez"><span class="ezt">쉬운 예시</span>{{ f.easy }}</div>{% endif %}
        </div>
        {% if not loop.last %}<div class="arrow">▼</div>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="foot"><span class="dot">●</span><span class="pg">{{ loop.index }}-2</span>{% if footer_meta %}{{ footer_meta }}{% endif %}</div>
    {% if footer_note %}<div class="copyr">{{ footer_note }}</div>{% endif %}
  </div>
  {% endif %}
{% endfor %}
</body>
</html>
