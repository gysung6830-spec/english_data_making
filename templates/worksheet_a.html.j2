{#- 레이아웃 A : 분석 학습지형 (실제 참고 디자인 반영). 명세서 §3 -#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ analyses[0].title_en if analyses else '구문 분석 학습지' }}</title>
<style>
  :root{
    /* 김은아영어연구소 파일(초록 브랜드) 팔레트 — 디자인 그대로, 색만 회사색으로 */
    --navy:#2e8b54; --red:#cd5049; --blue:#2e8b54;      /* 성분·리본=초록, 어법=빨강 */
    --green:#2f9e5f; --purple:#6a54b3; --amber:#cf8a2a; /* 유의어=초록, 함축·지칭=보라, 포인트=주황 */
    --gray:#8a90a0; --ink:#20242e;
    --yellow-hl:#fbed9c; --green-hl:#dcecc4; --purple-hl:#e0daf1;
    --page-bg:#edf1ec; --line:#d3dcd3; --box-red:#e2b6b1; --tmi-line:#d7ddd6;
  }
  @page{ size:A4 portrait; margin:10mm 9mm; }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    font-family:'Nanum Gothic','NanumGothic','Malgun Gothic','Apple SD Gothic Neo',system-ui,sans-serif;
    color:var(--ink); font-size:13px; line-height:1.5; font-weight:400;
  }
  .page{ background:var(--page-bg); border-radius:22px; padding:20px 22px 30px; position:relative;
         page-break-after:always; }
  .page:last-child{ page-break-after:auto; }

  /* ---- 제비꼬리 리본 + 제목 ---- */
  .head{ display:flex; align-items:flex-start; gap:16px; margin:0 0 12px; min-height:74px; }
  .ribbon{ position:relative; width:74px; flex:0 0 74px; background:var(--navy); color:#fff;
           text-align:center; padding:16px 4px 22px; margin-top:-4px;
           box-shadow:inset 0 0 0 2px rgba(255,255,255,.28); }
  .ribbon .no{ font-size:32px; font-weight:800; line-height:1.05; }
  .ribbon::after{ /* 하단 제비꼬리 V홈 (page-bg 삼각형이 아래 가운데를 파냄) */
    content:""; position:absolute; left:0; bottom:-1px; width:0; height:0;
    border-left:37px solid transparent; border-right:37px solid transparent;
    border-bottom:15px solid var(--page-bg); }
  .titles{ padding-top:12px; }
  .titles h1{ font-size:19px; font-weight:800; margin:0; line-height:1.22; color:#1c2030; }
  .titles .ko{ font-size:14px; color:#4a5064; margin-top:3px; font-weight:600; }

  /* ---- 문장 행 ---- */
  .row{ display:grid; grid-template-columns:1fr 200px; gap:12px; margin:18px 0 3px;
        padding-top:6px; page-break-inside:avoid; }
  .row:first-of-type{ margin-top:6px; }
  .analysis{ display:grid; grid-template-columns:26px 1fr; gap:6px; }
  .num{ color:var(--navy); font-weight:800; font-size:15px; line-height:1.4; }

  /* 뱃지(함/빈/서) + 함축 영어줄 */
  .bdg{ display:inline-block; min-width:15px; height:15px; line-height:15px; text-align:center;
        background:var(--navy); color:#fff; font-size:9.5px; font-weight:700; border-radius:3px;
        padding:0 2px; vertical-align:1px; margin-right:3px; }
  .bdg.r{ background:var(--red); }
  .gloss{ margin:0 0 3px; font-size:11px; color:var(--blue); font-weight:600;
          background:var(--yellow-hl); display:inline-block; padding:1px 5px; border-radius:3px; }

  /* ---- 영문 라인 + 토큰 주석 ----
     각 토큰(.tok)은 '단어(.w)'와 위/아래 주석(.over/.unders) 중 가장 넓은 것에 맞춰
     너비가 정해지는 inline-block. 주석이 단어보다 넓으면 그만큼 토큰이 벌어져
     '옆 단어 주석과 좌우로 겹치지 않는다'(중첩 방지). 짧은 주석/번호는 단어 폭과
     비슷해 영문은 여전히 촘촘히 흐른다. -------------------------------------------*/
  .en{ margin-top:3px; }
  .en .line{ margin-bottom:9px; }          /* 한 문장 안의 줄 사이 호흡 */
  .en .line:last-of-type{ margin-bottom:0; }
  .tok{ display:inline-block; vertical-align:top; text-align:center; margin:0 2px; }
  /* 위(over) = 문장 성분 라벨(S·V·O 등) */
  .tok .over{ display:flex; flex-direction:column; align-items:center; justify-content:flex-end;
              margin:0 auto 1px; height:0; overflow:visible; line-height:1.05;
              white-space:nowrap; text-align:center; }
  .tok .over .lbl{ color:var(--blue); font-weight:800; font-size:8.5px; }
  .en .line.po .tok .over{ height:11px; }   /* 성분 라벨이 있는 줄만 상단 공간 확보(단어 정렬) */
  .tok .w{ display:block; font-size:15px; line-height:1.5; white-space:nowrap; }
  .tok .w.hl-y{ background:var(--yellow-hl); }
  .tok .w.hl-g{ background:var(--green-hl); }
  .tok .w.hl-p{ background:var(--purple-hl); }
  .tok .w.underline{ text-decoration:underline; text-underline-offset:2px; }
  .tok .w.red{ color:var(--red); font-weight:600; }
  /* 유의어/반의어가 달린 어휘 = 초록 '밑줄'(글씨색은 그대로; 어법이면 빨강 유지) */
  .tok .w.vu{ text-decoration:underline; text-decoration-color:var(--green);
              text-decoration-thickness:1.5px; text-underline-offset:2.5px; }
  .tok .unders{ display:flex; flex-direction:column; align-items:center; margin:3px auto 0;
                overflow:visible; }
  /* 아래(unders) = 어법 번호(빨강, 크게) + 유의어(= 파랑)/반의어(↔ 회색) + 오답(X) */
  .ann{ font-size:7.5px; line-height:1.2; white-space:nowrap; text-align:center;
        max-width:150px; }   /* 아주 긴 주석만 방어적으로 제한(대개 짧음) */
  .ann.red{ color:var(--red); font-weight:800; font-size:11.5px; line-height:1; }
  .ann.syn{ color:var(--green); }   /* 유의어(=) 초록 */
  .ann.ant{ color:var(--gray); }    /* 반의어(↔) 차분한 회색 */
  .ann.gray{ color:var(--gray); }
  .ann.x{ color:var(--gray); font-weight:600; }

  .kotr{ margin-top:11px; color:#5b6172; font-size:12px; line-height:1.6; }

  /* 끊어읽기 경계 '/' + 직독직해 줄 + 온전한 해석 박스 */
  .sl{ color:#b6c0b6; font-weight:700; padding:0 4px; }
  .tsl{ margin:0 1px; }                         /* 영어 끊어읽기 '/' — 단어와 같은 baseline */
  .tsl .w{ color:#b6c0b6; font-weight:700; }
  .rdko{ margin-top:9px; font-size:11.5px; line-height:1.75; color:#39424c; }
  .rdlbl{ display:inline-block; background:var(--navy); color:#fff; font-size:9px; font-weight:800;
          padding:1px 7px; border-radius:9px; margin-right:6px; vertical-align:1px; }
  .rdko .rc{ font-weight:500; }
  .kobox{ margin-top:7px; background:#eef4ec; border:1px solid #cfe0cf; border-left:4px solid var(--navy);
          border-radius:8px; padding:6px 11px; font-size:12px; line-height:1.6; color:#232a24; }
  .kblbl{ display:inline-block; background:var(--navy); color:#fff; font-size:9px; font-weight:800;
          padding:1px 7px; border-radius:9px; margin-right:7px; vertical-align:1px; }

  /* ---- 우측 박스 : 알약형 헤더 + 라운드 박스(이전 스타일). 초록 톤과 어울리는 두 색으로 구별 ---- */
  .points{ display:flex; flex-direction:column; gap:9px; }
  .pbox{ background:#fff; border:1.5px solid var(--line); border-radius:13px; padding:0 11px 10px;
         font-size:10.5px; line-height:1.55; }
  .pbox .cap{ display:block; text-align:center; font-weight:800; font-size:11px; color:#fff;
              border-radius:20px; padding:2px 10px; margin:8px 0 7px; }
  /* 박스 안 어법 번호 = 인라인과 동일(빨강, 크게) */
  .pbox .gn{ color:var(--red); font-weight:800; font-size:11.5px; }
  /* 어법 Point = 골드(amber) 알약 + 옅은 크림 배경 */
  .pbox.g{ border-color:#e4d6b8; background:#fbf6ea; }
  .pbox.g .cap{ background:#c0842f; }
  /* 떠먹여주는 Point(대명사 지칭 + 함축) = 틸(teal) 알약 + 옅은 청록 배경 */
  .pbox.feed{ border-color:#c7ddd8; background:#eef6f4; }
  .pbox.feed .cap{ background:#37827b; }
  .pbox.feed .fr{ margin:3px 0; }
  .pbox.feed .fl{ font-weight:800; color:#37827b; }
  .pbox.feed .fl.im{ color:#37827b; }        /* 함축 라벨은 틸 */
  .pbox.feed .gko{ color:#4a5064; }          /* 함축 한글 병기 */
  .pbox b, .pbox strong{ font-weight:800; }

  /* ---- 압축(compact) 밀도: 한 지문을 최대한 1페이지에 ---- */
  .page.compact{ padding:14px 18px 26px; }
  .page.compact .head{ margin-bottom:8px; min-height:60px; }
  .page.compact .row{ margin:9px 0 2px; padding-top:3px; }
  .page.compact .en{ margin-top:1px; }
  .page.compact .en .line{ margin-bottom:5px; }
  .page.compact .en .line.po .tok .over{ height:9px; }
  .page.compact .tok .w{ font-size:13px; line-height:1.3; }
  .page.compact .tok .over .lbl{ font-size:7.5px; }
  .page.compact .ann{ font-size:7px; }
  .page.compact .ann.red{ font-size:10px; }
  .page.compact .kotr{ margin-top:6px; font-size:11px; line-height:1.45; }
  .page.compact .rdko{ margin-top:5px; font-size:10.5px; line-height:1.55; }
  .page.compact .kobox{ margin-top:5px; font-size:11px; line-height:1.45; padding:5px 9px; }
  .page.compact .num{ font-size:13px; }
  .page.compact .points{ gap:6px; }
  .page.compact .pbox{ font-size:9.5px; padding:0 9px 6px; }
  .page.compact .pbox .cap{ font-size:9.5px; padding:2px 8px; margin:6px 0 4px; }
  .page.compact .pbox .gn{ font-size:10px; }
  /* 뒷면(정리) 압축: 원문·전체해석 + 어휘 + 논리흐름을 1페이지에 */
  .page.compact .bhead{ margin-bottom:9px; }
  .page.compact .sec{ margin-bottom:8px; }
  .page.compact .sec > .st{ font-size:12px; margin-bottom:5px; }
  .page.compact .pcol{ padding:6px 9px; }
  .page.compact .ptext{ font-size:11px; line-height:1.7; }        /* 원문·전체해석 확대 */
  .page.compact .ptext .pnum{ font-size:8.5px; min-width:13px; height:13px; line-height:13px; }
  .page.compact .vtab{ font-size:9.5px; }
  .page.compact .vtab th, .page.compact .vtab td{ padding:3px 6px; }
  /* 논리 흐름 축소 */
  .page.compact .flow .step{ padding:4px 9px 5px; }
  .page.compact .flow .step .lb{ font-size:9px; padding:1px 8px; }
  .page.compact .flow .step .sn{ font-size:8.5px; }
  .page.compact .flow .step .tx{ font-size:9.5px; }
  .page.compact .flow .step .ez{ font-size:9px; margin-top:2px; padding-top:2px; }
  .page.compact .flow .step .ez .ezt{ font-size:8px; padding:1px 5px; }
  .page.compact .flow .arrow{ font-size:10px; margin:1px 0; }

  .foot{ position:absolute; left:22px; bottom:10px; font-size:10.5px; color:var(--gray); }
  .foot .dot{ color:var(--amber); }
  .foot .pg{ color:#9aa0b0; font-weight:800; font-size:13px; margin:0 5px; }
  .copyr{ position:absolute; right:22px; bottom:10px; font-size:9.5px; color:var(--gray); }

  /* ---- 뒷페이지(요약): 어휘 리스트 / 논리 흐름도 / 쉬운 예시 목차 ---- */
  .bhead{ display:flex; align-items:center; gap:10px; margin:0 0 14px; }
  .bhead .tag{ background:var(--navy); color:#fff; font-weight:800; font-size:12px;
               padding:4px 12px; border-radius:4px; }
  .bhead h2{ font-size:16px; font-weight:800; margin:0; color:#1c2030; }
  /* 원문 · 전체 해석 2단 */
  .pcols{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .pcol{ background:#eef4ec; border:1px solid #cfe0cf; border-radius:9px; padding:9px 11px; }
  .pclbl{ display:inline-block; background:var(--navy); color:#fff; font-size:9px; font-weight:800;
          padding:1px 9px; border-radius:9px; margin-bottom:6px; }
  .ptext{ font-size:11px; line-height:1.8; color:#232a24; text-align:justify; }
  .ptext .pnum{ display:inline-block; background:var(--navy); color:#fff; font-size:8px; font-weight:800;
                min-width:13px; height:13px; line-height:13px; text-align:center; border-radius:7px;
                padding:0 2px; margin:0 2px 0 1px; vertical-align:1px; }
  .sec{ margin-bottom:18px; page-break-inside:avoid; }
  .sec > .st{ display:inline-block; font-size:13px; font-weight:800; color:var(--navy);
              border-bottom:2px solid var(--navy); padding-bottom:2px; margin-bottom:9px; }
  /* 어휘 리스트 표 */
  .vtab{ width:100%; border-collapse:collapse; font-size:11.5px; }
  .vtab th, .vtab td{ border:1px solid var(--line); padding:5px 8px; text-align:left;
                      vertical-align:top; }
  .vtab th{ background:var(--navy); color:#fff; font-weight:700; font-size:11px; }
  .vtab tr:nth-child(even) td{ background:#f4f7fd; }
  .vtab .vn{ text-align:center; font-weight:700; color:var(--navy); white-space:nowrap; }
  .vtab .w{ font-weight:800; color:#20242e; white-space:nowrap; }
  .vtab .syn{ color:#2e7d4d; }   /* 유의어=진한 초록 */
  .vtab .ant{ color:#b23f36; }   /* 반의어=진한 빨강 */
  /* 논리 흐름 + 쉬운 예시 (같은 단계에 함께) */
  .flow{ display:flex; flex-direction:column; gap:0; }
  .flow .step{ border:1.5px solid var(--navy); border-radius:10px; padding:7px 12px 8px;
               background:#f4f7fd; }
  .flow .step .lb{ display:inline-block; background:var(--navy); color:#fff; font-weight:800;
                   font-size:10.5px; padding:1px 8px; border-radius:10px; margin-right:8px; }
  .flow .step .sn{ color:var(--gray); font-size:10px; font-weight:600; margin-left:6px; }
  .flow .step .tx{ font-size:12px; font-weight:700; }
  .flow .step .ez{ margin-top:4px; padding-top:4px; border-top:1px dashed #c3cde0; font-size:11.5px;
                   color:#33384a; }
  .flow .step .ez .ezt{ display:inline-block; background:#fff2c9; color:#8a6d16; font-weight:800;
                        font-size:9px; padding:1px 6px; border-radius:8px; margin-right:6px; }
  .flow .arrow{ text-align:center; color:var(--navy); font-size:14px; line-height:1;
                margin:3px 0; font-weight:800; }

  /* ---- 맨 앞 활용 가이드(표지) ---- */
  .ghead{ display:flex; align-items:center; gap:14px; margin:2px 0 16px; }
  .gribbon{ flex:0 0 auto; background:var(--navy); color:#fff; font-weight:800; font-size:14px;
            line-height:1.15; text-align:center; padding:12px 14px; border-radius:10px;
            box-shadow:inset 0 0 0 2px rgba(255,255,255,.28); }
  .ghead h1{ font-size:21px; font-weight:800; margin:0; color:#1c2030; }
  .ghead .ko{ font-size:13px; color:#4a5064; margin-top:3px; font-weight:600; }
  .gst{ display:inline-block; font-size:13px; font-weight:800; color:var(--navy);
        border-bottom:2px solid var(--navy); padding-bottom:2px; margin:16px 0 10px; }
  .glegend{ display:grid; grid-template-columns:1fr 1fr; gap:9px 20px; }
  .gitem{ font-size:12px; line-height:1.45; background:#fff; border:1px solid var(--line);
          border-radius:9px; padding:8px 11px; }
  .gitem .gt{ font-weight:800; }
  .gitem .gd{ color:#3a3f4c; }
  .gsw{ font-weight:700; }
  .gsw.role{ color:var(--navy); font-size:9px; font-weight:800; vertical-align:2px; }
  .gsw.gram{ color:var(--red); }
  .gsw.num{ color:var(--red); font-weight:800; }
  .gsw.x{ color:var(--gray); font-weight:700; }
  .gsw.vu{ text-decoration:underline; text-decoration-color:var(--green);
           text-decoration-thickness:1.5px; text-underline-offset:2.5px; }
  .gsw.hy{ background:var(--yellow-hl); padding:0 3px; }
  .gsw.hp{ background:var(--purple-hl); padding:0 3px; }
  .gpill{ display:inline-block; color:#fff; font-size:9.5px; font-weight:800;
          border-radius:11px; padding:1px 8px; }
  .gpill.gold{ background:#c0842f; } .gpill.teal{ background:#37827b; }
  .gsteps{ margin:0; padding-left:20px; font-size:12px; line-height:1.65; color:#23272e; }
  .gsteps li{ margin-bottom:3px; }
  .gsteps b{ font-weight:800; }
  .gtip{ margin-top:14px; background:#fff; border:1px solid var(--line);
         border-left:5px solid var(--navy); border-radius:9px; padding:9px 12px;
         font-size:12px; line-height:1.55; color:#23272e; }
</style>
</head>
<body>
{% if include_guide %}
<div class="page">
  <div class="ghead">
    <div class="gribbon">활용<br>가이드</div>
    <div>
      <h1>이 학습지 100% 활용법</h1>
      <div class="ko">색과 기호가 무엇을 뜻하는지 먼저 익히고 시작하세요.</div>
    </div>
  </div>

  <span class="gst">🎨 색 · 기호가 뜻하는 것</span>
  <div class="glegend">
    <div class="gitem"><span class="gsw role">S</span> <span class="gsw role">V</span> <span class="gsw role">O</span> <span class="gsw role">C</span>
      <span class="gt">문장 성분</span> — <span class="gd">단어 <b>위</b>에 표기. 주어·동사·목적어·보어(초록)</span></div>
    <div class="gitem"><span class="gsw gram">need</span> <span class="gsw num">①</span>
      <span class="gt">핵심 어법</span> — <span class="gd">빨간 글자 + 단어 <b>아래</b> 번호 ①②③</span></div>
    <div class="gitem"><span class="gsw x">who(X)</span>
      <span class="gt">오답형 함정</span> — <span class="gd">그 자리에 넣으면 <b>틀리는</b> 형태(시험 함정)</span></div>
    <div class="gitem"><span class="gsw vu">thrive</span>
      <span class="gt">유의어 · 반의어</span> — <span class="gd">초록 밑줄 (= 유의어 · ↔ 반의어)</span></div>
    <div class="gitem"><span class="gsw hy">주제문</span>
      <span class="gt">노란 형광</span> — <span class="gd">주제문 · 빈칸 출제 예상 어구</span></div>
    <div class="gitem"><span class="gsw hp">However</span>
      <span class="gt">라벤더 형광</span> — <span class="gd">담화표지(However, Similarly …)</span></div>
    <div class="gitem"><span class="gpill gold">N번 어법 Point</span>
      <span class="gt gd"> — 문장별 어법을 ①②③로 정리(골드 박스)</span></div>
    <div class="gitem"><span class="gpill teal">떠먹여주는 Point</span>
      <span class="gt gd"> — 대명사 지칭(it→…) · 숨은 함축 의미(틸 박스)</span></div>
  </div>

  <span class="gst">📖 이렇게 쓰세요</span>
  <ol class="gsteps">
    <li>앞면 <b>영어 원문</b>을 소리 내어 한 번 읽는다.</li>
    <li><b>성분(초록)</b>으로 문장의 뼈대(주어·동사)를 먼저 잡는다.</li>
    <li><b>어법(빨강 ①②③)</b>과 오른쪽 <b>골드 박스</b>로 시험 포인트 확인 — 특히 <b>(X) 함정</b>에 주의.</li>
    <li><b>틸 박스</b>로 대명사가 가리키는 것과 문장의 숨은 뜻을 확인한다.</li>
    <li>아래 <b>한글 해석</b>과 대조하며 직독직해로 한 번 더 읽는다.</li>
    <li><b>뒷면</b>의 핵심 어휘(유의어·반의어)와 논리 흐름으로 복습한다.</li>
  </ol>

  <div class="gtip">💡 <b>Tip.</b> 번호 <b>①②③</b>는 본문과 오른쪽 박스가 서로 <b>짝</b>이에요. 본문에서 색·번호를 먼저 보고, 박스에서 그 이유를 확인하세요.</div>
</div>
{% endif %}
{% for a in analyses %}
  <div class="page{% if compact %} compact{% endif %}">
    <div class="head">
      <div class="ribbon">
        <div class="no">{{ a.lecture_label or '★' }}</div>
      </div>
      <div class="titles">
        <h1>{{ a.title_en }}</h1>
        {% if a.title_ko %}<div class="ko">{{ a.title_ko }}</div>{% endif %}
      </div>
    </div>

    {% for s in a.sentences %}
    <div class="row">
      <div class="analysis">
        <div class="num">{{ "%02d"|format(s.index) }}</div>
        <div>
          <div class="en">
            {% for line in s.lines %}
            {%- set has_role = line | selectattr('role') | list -%}
            <div class="line{% if has_role %} po{% endif %}">
              {%- if loop.first and s.badge %}<span class="bdg r">{{ s.badge }}</span> {% endif -%}
              {%- for t in line -%}
                <span class="tok">
                  {# 위: 문장 성분 라벨 #}
                  {%- if has_role %}<span class="over">{% if t.role %}<span class="lbl">{{ t.role }}</span>{% endif %}</span>{% endif -%}
                  {%- set _a = t.above or '' -%}{%- set _n = t.note or '' -%}
                  {%- set is_vocab = _a[:1] in ['=', '↔'] or (t.note_kind != 'red' and _n[:1] in ['=', '↔']) -%}
                  <span class="w{% if t.hl %} hl-{{ t.hl }}{% endif %}{% if t.underline %} underline{% endif %}{% if t.color %} {{ t.color }}{% endif %}{% if is_vocab %} vu{% endif %}">{{ t.text | replace('(','') | replace(')','') }}</span>
                  {# 아래: 어법 번호 / 유의어·반의어 / 오답 #}
                  {%- if t.above or t.note or t.wrong -%}
                  <span class="unders">
                    {%- if t.above %}<span class="ann {{ 'syn' if t.above.startswith('=') else 'ant' }}">{{ t.above }}</span>{% endif -%}
                    {%- if t.note %}<span class="ann {% if t.note_kind == 'red' %}red{% elif t.note.startswith('=') %}syn{% elif t.note.startswith('↔') %}ant{% else %}gray{% endif %}">{{ t.note }}</span>{% endif -%}
                    {%- if t.wrong %}<span class="ann x">{{ t.wrong }}</span>{% endif -%}
                  </span>
                  {%- endif -%}
                </span>
                {%- if t.slash %}<span class="tok tsl">{% if has_role %}<span class="over"></span>{% endif %}<span class="w">/</span></span>{% endif -%}
              {%- endfor -%}
            </div>
            {% endfor %}
          </div>
          {# 끊어읽기: 직독직해(한글, / 구분) #}
          {% if s.reading_ko %}
          <div class="rdko"><span class="rdlbl">직독직해</span>
            {%- for c in s.reading_ko.split(' / ') -%}
              <span class="rc">{{ c }}</span>{% if not loop.last %}<span class="sl">/</span>{% endif %}
            {%- endfor -%}
          </div>
          {% endif %}
          {# 온전한 해석: 박스 처리 #}
          {% if s.translation %}<div class="kobox"><span class="kblbl">해석</span>{{ s.translation }}</div>{% endif %}
        </div>
      </div>
      <div class="points">
        {% for p in s.points %}
        <div class="pbox {{ 'g' if p.is_grammar else 'feed' }}">
          <span class="cap">{{ p.caption }}</span>
          <div class="body">{{ p.body_html | safe }}</div>
        </div>
        {% endfor %}
        {% if s.has_feed %}
        <div class="pbox feed">
          <span class="cap">{{ s.index }}번 문장 떠먹여주는 Point</span>
          <div class="body">
            {%- for r in s.refs %}<div class="fr"><span class="fl">지칭</span> {{ r }}</div>{% endfor -%}
            {% if s.gloss_en %}<div class="fr"><span class="fl im">함축</span> {{ s.gloss_en }}{% if s.gloss_ko %}<br><span class="gko">{{ s.gloss_ko }}</span>{% endif %}</div>{% endif %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}

    <div class="foot"><span class="dot">●</span><span class="pg">{{ loop.index }}</span>{% if footer_meta %}{{ footer_meta }}{% endif %}</div>
    {% if footer_note %}<div class="copyr">{{ footer_note }}</div>{% endif %}
  </div>

  {% if include_back and a.has_back %}
  <div class="page compact">   {#- 뒷면(정리)은 항상 압축해 1페이지에 맞춘다 -#}
    <div class="bhead">
      <div class="tag">{{ a.lecture_label or '★' }}</div>
      <h2>{{ a.title_en }} · 정리</h2>
    </div>

    {% if a.sentences %}
    <div class="sec">
      <div class="st">원문 · 전체 해석</div>
      <div class="pcols">
        <div class="pcol">
          <span class="pclbl">원문</span>
          <div class="ptext">
            {%- for s in a.sentences -%}
              <span class="pnum">{{ s.index }}</span> {{ s.text | replace('(','') | replace(')','') }}{{ ' ' }}
            {%- endfor -%}
          </div>
        </div>
        <div class="pcol">
          <span class="pclbl">전체 해석</span>
          <div class="ptext">
            {%- for s in a.sentences -%}
              <span class="pnum">{{ s.index }}</span> {{ s.translation }}{{ ' ' }}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
    {% endif %}

    {% if a.vocab %}
    <div class="sec">
      <div class="st">핵심 어휘 · 유의어 · 반의어</div>
      <table class="vtab">
        <tr><th style="width:8%">문장</th><th style="width:21%">단어</th><th style="width:24%">뜻</th>
            <th style="width:23.5%">유의어(=)</th><th style="width:23.5%">반의어(↔)</th></tr>
        {% for v in a.vocab %}
        <tr>
          <td class="vn">{% if v.sent %}{{ v.sent }}번{% endif %}</td>
          <td class="w">{{ v.word }}</td>
          <td>{{ v.meaning }}</td>
          <td class="syn">{{ v.syn }}</td>
          <td class="ant">{{ v.ant }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}

    {% if a.flow %}
    <div class="sec">
      <div class="st">글의 논리 흐름 · 쉬운 예시</div>
      <div class="flow">
        {% for f in a.flow %}
        <div class="step">
          <div class="row1"><span class="lb">{{ f.label }}</span><span class="tx">{{ f.text }}</span>{% if f.sentences %}<span class="sn">({{ f.sentences }}번)</span>{% endif %}</div>
          {% if f.easy %}<div class="ez"><span class="ezt">쉬운 예시</span>{{ f.easy }}</div>{% endif %}
        </div>
        {% if not loop.last %}<div class="arrow">▼</div>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="foot"><span class="dot">●</span><span class="pg">{{ loop.index }}-2</span>{% if footer_meta %}{{ footer_meta }}{% endif %}</div>
    {% if footer_note %}<div class="copyr">{{ footer_note }}</div>{% endif %}
  </div>
  {% endif %}
{% endfor %}
</body>
</html>
