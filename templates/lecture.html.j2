{#- 강의컨셉 교재(필생보): 학생용(teacher=False) / 강사용(teacher=True, 정답 표시) -#}
<!doctype html>
<html lang="ko">
<head><meta charset="utf-8"><title>강의컨셉 교재</title></head>
<body>
{% for p in passages %}
<div class="passage">

  {#- 지문 헤더 (학생용은 정답이 될 수 있는 상단 제목을 감춤) -#}
  <div class="doc-head">
    <div class="kicker"><span class="pill-doc">지문 {{ p.no }}{% if p.total > 1 %} / {{ p.total }}{% endif %}</span>
      {% if teacher %}<span class="tag-teacher">강사용 · 정답 표시</span>{% else %}<span class="tag-student">학생 문제지</span>{% endif %}
      {% if p.item_no %}<span class="item-badge">{{ p.item_no }}</span>{% endif %}
    </div>
    {% if teacher %}<div class="doc-title">{{ p.theme_ko }}</div>{% endif %}
    <div class="doc-sub">필생보 · 필자의 생각이 보이는 영어독해 — 어휘 · 끊어읽기 · 내용 · 예측{% if p.source %} &nbsp;·&nbsp; {{ p.source }}{% endif %}</div>
  </div>

  {#- ① 지문 통째로 읽기 -#}
  <div class="section">
    <div class="sec-head"><span class="sec-no">1</span><span class="sec-title">지문 통째로 읽기</span>
      <span class="sec-desc">먼저 전체 흐름을 쭉 훑어봐</span></div>
    <div class="passage-box">
      {% for s in p.sentences %}<span class="sent"><span class="snum">{{ s.id }}</span>{{ s.text }}</span> {% endfor %}
    </div>
  </div>

  {#- ② 어휘 리스트 -#}
  <div class="section">
    <div class="sec-head"><span class="sec-no">2</span><span class="sec-title">어휘 리스트</span>
      <span class="sec-desc">핵심 어휘부터 익혀둬 (앞의 숫자 = 나온 문장 번호)</span></div>
    <div class="panel">
      <div class="vocab-grid">
        {% for v in p.vocab_list %}<span class="vterm"><span class="vsid">{{ v.sid }}</span>{{ v.word }}</span><span class="vmean">{{ v.meaning }}</span>{% endfor %}
      </div>
    </div>
  </div>

  {#- ③ 문장별: 끊어읽기 빈칸 + 내용 객관식 (새 페이지) -#}
  <div class="section brk">
    <div class="sec-head"><span class="sec-no">3</span><span class="sec-title">문장별 끊어읽기 &amp; 내용 파악</span>
      <span class="sec-desc">빈칸을 직접 해석해 채우고(어디가 빠졌는지 찾기), 문장 내용을 골라봐</span></div>
    <div class="panel">
      {% for it in p.lines %}
      <div class="s-item">
        <div class="s-en"><span class="s-no">{{ it.id }}</span>{% for c in it.chunks %}{{ c.en }}{% if not loop.last %} <span class="sl">/</span> {% endif %}{% endfor %}</div>
        {% if it.grammar %}<div class="gram">🔑 {% for g in it.grammar %}<span class="gchip">{{ g.tag }}</span>{% if g.note %} <span class="gnote">{{ g.note }}</span>{% endif %}{% if not loop.last %} &nbsp;·&nbsp; {% endif %}{% endfor %}</div>{% endif %}
        <div class="ko-box"><span class="ko-lab">한글</span>{% for c in it.chunks %}<span class="ko-plain">{{ c.ko }}</span>{% if not loop.last %} <span class="sl">/</span> {% endif %}{% endfor %}</div>
        <div class="s-q"><span class="q-lead">이렇게 읽으면 오답 — 왜 틀렸을까?</span></div>
        {% for m in it.misreads %}
        <div class="mis">{{ m.statement }} <span class="mis-x">(X)</span></div>
        {% if teacher %}<div class="mis-why">→ {{ m.why }}</div>{% else %}<div class="mis-line">왜? <span class="writeline inline wide"></span></div>{% endif %}
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>

  {#- ④ 글 정리 (새 페이지) -#}
  <div class="section brk">
    <div class="sec-head"><span class="sec-no">4</span><span class="sec-title">글 정리</span>
      <span class="sec-desc">문장을 다 봤으니 지문 전체를 정리해봐{% if not teacher %} (정답은 강사용){% endif %}</span></div>

    <div class="pcard">
      <div class="pc-q"><span class="em">🔎</span>소재<span class="pc-hint">이 지문, 뭐에 관한 글이야?</span></div>
      {% if teacher %}<div class="pred-a">{{ p.topic }}</div>{% else %}<div class="writeline"></div>{% endif %}
    </div>

    <div class="pcard">
      <div class="pc-q"><span class="em">🗣</span>필자 의견<span class="pc-hint">태도(긍/부/중)를 판단</span></div>
      <div class="choices">
        {% for st in p.stances %}<span class="choice {% if teacher and st == p.stance %}on{% endif %}"><span class="ck"></span>{{ st }}</span>{% endfor %}
      </div>
      {% if teacher %}<div class="pred-a">{{ p.stance_reason }}</div>
      {% else %}<div class="rubric">
        <div><span class="rb pos">긍정</span>좋다·이롭다·중요 / should·valuable·effective 같은 칭찬·권장</div>
        <div><span class="rb neg">부정</span>문제·해롭다 / But·However·overlook·fail 같은 비판·경고</div>
        <div><span class="rb neu">중립</span>사실 설명·양쪽 비교(on the other hand)만 하고 편들지 않음</div>
      </div>{% endif %}
    </div>

    <div class="pcard">
      <div class="pc-q"><span class="em">🧩</span>글의 구조<span class="pc-hint">글이 어떻게 전개되는지 판단</span></div>
      <div class="choices">
        {% for stc in p.structures %}<span class="choice {% if teacher and stc == p.structure %}on{% endif %}"><span class="ck"></span>{{ stc }}</span>{% endfor %}
      </div>
      {% if teacher %}<div class="pred-a">{{ p.structure_reason }}</div>
      {% else %}<div class="subline">그렇게 본 근거(전환·연결 표현이나 문장 번호): <span class="writeline inline"></span></div>{% endif %}
    </div>

    <div class="pcard">
      <div class="pc-q"><span class="em">🔗</span>재진술 사슬<span class="pc-hint">{% if teacher %}같은 개념(소재)이 형광펜으로 어떻게 이어지는지{% else %}첫 번째 소재는 예시로 칠해놨어 — 나머지 소재도 형광펜으로 찾아 칠해봐{% endif %}</span></div>
      <div class="chain-legend">
        {% for c in p.chains %}<span class="cleg"><span class="cnum {{ c.color }}">{{ loop.index }}</span>{{ c.label }}{% if not teacher and loop.first %} <span class="cvar">— 예시로 표시함</span>{% endif %}{% if teacher and c.variation %} <span class="cvar">— {{ c.variation }}</span>{% endif %}</span>{% endfor %}
      </div>
      {% if teacher %}<div class="hl-passage">{{ p.passage_hl }}</div>
      {% else %}<div class="hl-passage">{{ p.passage_hl_student }}</div>{% endif %}
    </div>

    <div class="pcard flow-card">
      <div class="pc-q green"><span class="em">📝</span>글 내용 정리<span class="pc-hint">글의 순서(도입→전개→…){% if not teacher %} · 빈칸을 채워봐{% endif %}</span></div>
      {% for b in p.flow_blocks %}
      <div class="fblock">
        <div class="fb-head"><span class="fb-stage">{{ b.stage }}</span><span class="fb-sum">{{ b.summary }}</span>
          <span class="fb-range">(문장 {{ b.sentence_range }})</span></div>
        {% if b.easy_example %}<div class="fb-ex"><span class="fb-ex-lab">쉬운 예시</span>{{ b.easy_example }}</div>{% endif %}
      </div>
      {% if not loop.last %}<div class="fb-arr">▼</div>{% endif %}
      {% endfor %}
    </div>
  </div>

  {#- ⑤ 이 지문의 핵심 문법 (새 페이지) -#}
  <div class="section brk">
    <div class="sec-head"><span class="sec-no">5</span><span class="sec-title">이 지문의 핵심 문법</span>
      <span class="sec-desc">이 문법 하나만 확실히! (설명 빈칸 채우기 + 객관식·영작 연습)</span></div>
    <div class="kg-box">
      <div class="kg-head">🔑 <span class="kg-point">{{ p.key_grammar.point }}</span></div>
      <div class="kg-exp"><span class="kg-lab">설명</span>
        <ul class="kg-list">
          {% for line in p.key_grammar.explanation %}<li>{{ line }}</li>{% endfor %}
        </ul>
      </div>
      {% if p.key_grammar.example %}<div class="kg-ex"><span class="kg-ex-lab">지문 예</span>{{ p.key_grammar.example }}
        {% if p.key_grammar.example_analysis %}<div class="kg-ex-an">↳ {{ p.key_grammar.example_analysis }}</div>{% endif %}</div>{% endif %}
    </div>

    <div class="kg-drills">
      <div class="kg-drills-h">✏ 연습문제 — 객관식 · 영작(지문 문장 + 응용)으로 확인</div>
      <div class="drill-cols">
      {% for d in p.key_grammar.drills %}
      <div class="drill">
        <div class="drill-q"><span class="drill-kind {{ d.kind }}">{{ d.kind }}</span>{% if d.kind == '영작' %}<span class="drill-src {{ 'psg' if d.from_passage else 'app' }}">{{ '지문 문장' if d.from_passage else '응용' }}</span>{% endif %}{{ d.question }}</div>
        {% if d.kind == '객관식' %}
        <div class="drill-opts">
          {% for op in d.options %}<span class="dopt {% if teacher and op == d.answer %}on{% endif %}"><span class="dk"></span>{{ op }}</span>{% endfor %}
        </div>
        {% if teacher %}<div class="drill-a">→ {{ d.answer }}</div>{% endif %}
        {% elif d.kind == '영작' %}
        {% if d.words %}<div class="drill-words"><span class="dw-lab">제시어</span>{% for w in d.words %}<span class="dw">{{ w }}</span>{% endfor %}</div>{% endif %}
        {% if teacher %}<div class="drill-a">→ {{ d.answer }}</div>
        {% else %}<div class="drill-write"><span class="drill-arrow">→</span><span class="writeline inline wide2"></span></div>{% endif %}
        {% else %}
        {% if teacher %}<div class="drill-a">→ {{ d.answer }}</div>
        {% else %}<div class="drill-write"><span class="drill-arrow">→</span><span class="writeline inline wide2"></span></div>{% endif %}
        {% endif %}
      </div>
      {% endfor %}
      </div>
    </div>
  </div>

</div>
{% endfor %}
</body>
</html>
