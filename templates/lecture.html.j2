{#- 강의컨셉 교재(필생보): 학생용(teacher=False, ①②③) / 강사용(teacher=True, ①~⑤) -#}
<!doctype html>
<html lang="ko">
<head><meta charset="utf-8"><title>강의컨셉 교재</title></head>
<body>
{% if footer_note %}<div class="footer">{{ footer_note }}</div>{% endif %}

{% for p in passages %}
<div class="passage">

  {#- 지문 헤더 -#}
  <div class="doc-head">
    <div class="kicker">지문 {{ p.no }}{% if p.total > 1 %} / {{ p.total }}{% endif %}
      {% if teacher %}<span class="tag-teacher">강사용 · 답지 포함</span>{% else %}<span class="tag-student">학생 문제지</span>{% endif %}
    </div>
    <div class="doc-title">{% if p.item_no %}<span class="item-badge">{{ p.item_no }}</span>{% endif %}{{ p.theme_ko }}</div>
    <div class="doc-sub">필생보 · 필자의 생각이 보이는 영어독해 — 소재 · 주장 · 구조 · 재진술{% if p.source %} &nbsp;·&nbsp; {{ p.source }}{% endif %}</div>
  </div>

  {#- ① 지문 통째로 읽기 -#}
  <div class="section">
    <div class="sec-head"><span class="sec-no">①</span><span class="sec-title">지문 통째로 읽기</span>
      <span class="sec-desc">먼저 전체 흐름을 쭉 훑어봐</span></div>
    <div class="passage-box">
      {% for s in p.sentences %}<span class="sent"><sup class="snum">{{ s.id }}</sup>{{ s.text }}</span> {% endfor %}
    </div>
  </div>

  {#- ② 해석 전 예측 -#}
  <div class="section">
    <div class="sec-head"><span class="sec-no">②</span><span class="sec-title">해석 전 예측</span>
      <span class="sec-desc">해석 들어가기 전에 먼저 예측해봐! (정답은 ⑤)</span></div>
    <div class="panel">
      <div class="pred-row"><div class="pred-q">🔎 소재 <span class="pred-hint">이 지문, 뭐에 관한 글이야?</span></div>
        <div class="writeline"></div></div>

      <div class="pred-row"><div class="pred-q">🗗 필자 주장 <span class="pred-hint">긍정·부정·중립? (평가어·마지막 문장으로 판단)</span></div>
        <div class="choices">
          {% for st in p.stances %}<span class="choice">◯ {{ st }}</span>{% endfor %}
        </div>
        <div class="rubric">
          <div><b>긍정</b> 좋다·이롭다·중요 / should·valuable·effective 같은 칭찬·권장</div>
          <div><b>부정</b> 문제·해롭다 / But·However 로 뒤집기·overlook·fail·should not 같은 비판·경고</div>
          <div><b>중립</b> 사실을 설명하거나 양쪽을 비교(on the other hand)만 하고 편들지 않음</div>
        </div>
      </div>

      <div class="pred-row"><div class="pred-q">🧩 글의 구조 <span class="pred-hint">전체 흐름을 보고 하나에 ✓</span></div>
        <div class="choices">
          {% for stc in p.structures %}<span class="choice">☐ {{ stc }}</span>{% endfor %}
        </div>
        <div class="subline">그렇게 본 근거(전환·연결표현이나 문장 번호): <span class="writeline inline"></span></div>
      </div>

      <div class="pred-row"><div class="pred-q">🔗 재진술 사슬 찾기 <span class="pred-hint">첫 표현이 지문에서 같은 뜻으로 어떻게 다시 나오는지 순서대로 써봐</span></div>
        {% for c in p.chains %}
        <div class="chain-q"><span class="chain-label">{{ c.label }}</span>
          <span class="chain-flow">{{ c.first }}{% for i in range(c.blanks) %} → <span class="chain-blank"></span>{% endfor %}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  {#- ③ 어휘 & 오역 포인트 잡기 -#}
  <div class="section">
    <div class="sec-head"><span class="sec-no">③</span><span class="sec-title">어휘 &amp; 오역 포인트 잡기</span>
      <span class="sec-desc">어휘 보고 → 틀리기 쉬운 곳만 골라 풀기 (정답·해설은 ⑤)</span></div>
    <div class="panel">
      {% if p.vocab_hints %}
      <div class="vocab-hints">📘 <b>어휘 힌트</b>
        {% for v in p.vocab_hints %}<span class="vchip"><b>{{ v.word }}</b> {{ v.meaning }}</span>{% endfor %}
      </div>
      {% endif %}

      {% for q in p.problems %}
      <div class="q-card">
        <div class="q-head"><span class="q-no">Q{{ q.no }}</span>
          <span class="q-kind {{ '주관' if q.kind == '주관식' else '객관' }}">{{ q.kind }}</span>
          <span class="q-tag">S{{ q.sentence_id }}</span>
          <span class="q-text">{{ q.question }}</span></div>
        {% if q.focus %}<div class="q-focus">{{ q.focus }}</div>{% endif %}
        {% if q.kind == '객관식' %}
          {% for o in q.options %}
          <div class="q-opt {% if teacher and o.correct %}correct{% endif %}"><span class="osym">{{ o.sym }}</span>{{ o.text }}</div>
          {% endfor %}
        {% else %}
          <div class="q-answerline">✏ <span class="writeline inline wide"></span></div>
        {% endif %}
        {% if teacher %}
        <div class="q-ans">정답 {% if q.kind == '객관식' %}<b>{{ q.answer_sym }}</b>{% endif %} {{ q.answer_text }}
          <span class="q-exp">— {{ q.explanation }}</span></div>
        {% endif %}
      </div>
      {% endfor %}

      <div class="wrapup"><span class="wrapup-q">✍ 마무리 — 이 지문을 한 줄로 요약해봐</span>
        <div class="writeline"></div></div>
    </div>
  </div>

  {% if teacher %}
  {#- ④ 답지 — 끊어읽기·캐치 -#}
  <div class="section answer">
    <div class="sec-head"><span class="sec-no ans">④</span><span class="sec-title">답지 — 끊어읽기 · 캐치</span>
      <span class="sec-desc">영어 문장에 / 로 끊어읽기 + 직독직해</span></div>
    <div class="panel ans-panel">
      <div class="analogy">💡 <b>이 지문의 비유 — ‘{{ p.analogy_name }}’</b> {{ p.analogy_desc }}</div>
      {% for it in p.lines %}
      <div class="a-item">
        <div class="a-en"><span class="s-no">{{ it.id }}</span>{{ it.en_chunked }}
          {% if it.syntax_tag %}<span class="syntax">{{ it.syntax_tag }}</span>{% endif %}</div>
        <div class="a-ko">{{ it.ko_chunked }}</div>
        {% if it.catch %}<div class="a-catch">✅ 이 정도는 캐치! &nbsp;{{ it.catch }}</div>{% endif %}
        {% if it.easy_example %}<div class="a-ex">💡 쉬운 예시 &nbsp;{{ it.easy_example }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>

  {#- ⑤ 정답 & 해설 (예측 + 오역문제 + 요지) -#}
  <div class="section answer">
    <div class="sec-head"><span class="sec-no ans">⑤</span><span class="sec-title">정답 &amp; 해설</span>
      <span class="sec-desc">앞에서 예측·풀이한 걸 여기서 맞춰봐</span></div>
    <div class="panel ans-panel">
      <div class="ans-row"><span class="ans-k">🔎 소재</span><span class="ans-v">{{ p.topic }}</span></div>
      <div class="ans-row"><span class="ans-k">🗗 필자 주장</span><span class="ans-v"><b class="hl">{{ p.stance }}</b> — {{ p.stance_reason }}</span></div>
      <div class="ans-row"><span class="ans-k">🧩 글의 구조</span><span class="ans-v"><b class="hl">{{ p.structure }}</b> — {{ p.structure_reason }}</span></div>
      <div class="ans-row"><span class="ans-k">🔗 재진술 사슬</span><span class="ans-v">
        {% for c in p.chains %}<div class="chain-a"><b>{{ c.label }}</b>: {{ c.expressions | join(' → ') }}<div class="chain-var">↳ 변주 {{ c.variation }}</div></div>{% endfor %}
      </span></div>
      <div class="ans-row"><span class="ans-k">📘 오역 포인트</span><span class="ans-v">
        {% for q in p.problems %}<div class="prob-a"><b>Q{{ q.no }}</b> {% if q.kind == '객관식' %}정답 {{ q.answer_sym }} {% endif %}{{ q.answer_text }} <span class="prob-exp">— {{ q.explanation }}</span></div>{% endfor %}
      </span></div>
      <div class="gist">✅ 이 지문, 이 정도는 캐치!(전체 요지 · 한 줄 요약 정답) &nbsp;{{ p.gist }}</div>
    </div>
  </div>
  {% endif %}

</div>
{% endfor %}
</body>
</html>
