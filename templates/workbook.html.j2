<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>{{ books[0].title }}{% if books|length > 1 %} 외 {{ books|length - 1 }}편{% endif %} - 통합 워크북</title>
  <style>{{ font_css }}</style>
  <style>{% include "workbook.css" %}</style>
  <style>{% include "_common.css" %}</style>
</head>
<body>

  {# 복수 지문: 각 지문마다 [문제] → [정답] 을 한 묶음으로 배치한다.
     지문1 → 답1 → 지문2 → 답2 … (지문별로 새 페이지에서 시작) #}
  {% for wb in books %}
  <section class="wb-unit{{ ' unit-break' if not loop.first and section != 'a' }}">

    {% if section != 'a' %}
    {# ── 상단 헤더 (제목 + 출처 뱃지) ── #}
    <div class="sh-head">
      <div class="sh-titles"><div class="sh-title">{{ wb.title }}</div></div>
      {% if wb.label %}<span class="sh-badge">{{ wb.label }}</span>{% endif %}
    </div>

    {# ── 유형 범례 바 (5칸 균등) ── #}
    <div class="wb-legend">
      <div class="lg lg-v"><span class="name"><span class="dot"></span>동사·준동사</span><span class="how">어형 변화</span></div>
      <div class="lg lg-a"><span class="name"><span class="dot"></span>형용사·부사</span><span class="how">원문/유의어/반의어</span></div>
      <div class="lg lg-r"><span class="name"><span class="dot"></span>관계사·대명사</span><span class="how">어법·지칭 선택</span></div>
      <div class="lg lg-c"><span class="name"><span class="dot"></span>연결사</span><span class="how">흐름 선택</span></div>
      <div class="lg lg-o"><span class="name"><span class="dot"></span>특수구문</span><span class="how">어순 배열</span></div>
    </div>

    {# ── 지시문 (문제 풀이 방법) ── #}
    <div class="wb-guide">
      <b>※ 문제</b>
      <span class="gi"><span class="gn">(1)</span> <span class="mk v">( &nbsp;)</span> 안의 동사는 <b>어형을 알맞게 바꿔</b> 쓰시오.</span>
      <span class="gi"><span class="gn">(2)</span> <span class="mk sel">[ / ]</span> 에서는 <b>문맥·어법상 알맞은 것</b>을 고르시오.</span>
      <span class="gi"><span class="gn">(3)</span> <span class="mk o">〈 &nbsp;〉</span> 안의 어구는 <b>순서를 바르게 배열</b>하시오.</span>
      <span class="gi"><span class="gn">(4)</span> <span class="mk r">대명사 =</span> 뒤 [ ]에서 <b>가리키는 대상</b>을 고르시오.</span>
    </div>

    {# ── 문항 카드 ── #}
    <div class="wb-cards">
      {% for s in wb.sentences %}
      <div class="card">
        <span class="cbar"></span>
        <span class="cnum">{{ s.no }}</span>
        <div class="cbody">
          <div class="c-en">{{ s | render_sentence }}</div>
          {% if show_ko %}<div class="c-ko">{{ s.ko }}</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>

    {# 하단 저작권 문구는 Playwright 인쇄 푸터로 모든 페이지에 렌더된다(render_workbook_pdf). #}
    {% endif %}

    {% if section != 'q' %}
    {# ── 정답 · 해설 (다음 페이지) ── #}
    <div class="ans-page">
      <div class="ans-head">정답 · 해설
        <span class="ans-sub">{% if wb.label %}{{ wb.label }} · {% endif %}통합 카드 · 총 {{ wb.total }}문항</span>
      </div>
      <ol class="ans-list">
        {% for q in wb.all_questions %}
        <li class="ans-item">
          <span class="an">{{ q.num }})</span>
          <span class="aw {{ q.css }}">{{ q.answer }}</span>
          <span class="adash">—</span>
          <span class="ar">{{ q.reason }}</span>
          <span class="atag {{ q.css }}">{{ q.label }}</span>
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}

  </section>
  {% endfor %}

</body>
</html>
