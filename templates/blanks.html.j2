<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>{{ wb.title }} - 빈칸 워크북</title>
  <style>{{ font_css | safe }}</style>
  <style>{% include "blanks.css" %}</style>
  <style>{% include "_common.css" %}</style>
</head>
<body>

  {% if section != 'a' %}
  {% for st in wb.sets %}
  <section class="set{{ ' set-break' if not loop.first }}">

    {# ── 지문 헤더 (제목 + 출처 뱃지) ── #}
    <div class="sh-head">
      {% if st.label %}<span class="sh-badge">{{ st.label }}</span>{% endif %}
    </div>

    {# ── 유형 B: 지문 빈칸형 (첫 글자 + 밑줄) — 다른 유형과 동일한 세로 배치(영문 위·한글 아래) ── #}
    <div class="part-head pb-head">① 지문 빈칸 <span class="ph-sub">첫 글자 힌트</span></div>
    <ol class="pb-list">
      {% for s in st.sentences %}
      <li>
        <span class="s-no">{{ s.no }}</span>
        <div class="s-en">{{ s | render_bsentence }}</div>
        {% if show_ko %}<div class="s-ko">{{ s.ko }}</div>{% endif %}
      </li>
      {% endfor %}
    </ol>

    {# ── 유형 A: 요약문 빈칸형 (번호만 + 단어뱅크) ──
        헤더·워드뱅크·요약문을 한 덩어리로 묶어 페이지가 갈리며 워드뱅크가
        요약문과 떨어지지 않게 한다(워드뱅크를 먼저 보여 주고 요약문을 채우게). #}
    <div class="sb-block">
      <div class="part-head sb-head">② 요약문 빈칸 <span class="ph-sub">워드뱅크에서 골라 쓰기</span></div>
      <div class="wordbank">
        <div class="wb-label">Word Bank</div>
        <div class="chips">
          {% for w in st.wordbank %}<span class="chip">{{ w }}</span>{% endfor %}
        </div>
      </div>
      <div class="summary">
        <span class="cbar sb-bar"></span>
        <div class="sum-text">{{ st | render_summary }}</div>
      </div>
    </div>

  </section>
  {% endfor %}
  {% endif %}

  {% if section != 'q' %}
  {# ── 정답 페이지 ── #}
  <div class="ans-page">
    <div class="ans-head">정답 <span class="ans-sub">Answers · 총 {{ wb.total }}개</span></div>
    {% for st in wb.sets %}
    <div class="ans-set">
      <div class="ans-set-title"><span class="set-idx">지문 {{ st.no }}</span> {{ st.title }}</div>
      <div class="ans-cols">
        <div class="ans-col">
          <div class="ans-col-h pb-h">① 지문 빈칸</div>
          {% for b in st.passage_blanks %}<span class="ans-item"><b>{{ b.num }})</b> {{ b.answer }}</span>{% endfor %}
        </div>
        <div class="ans-col">
          <div class="ans-col-h sb-h">② 요약문 빈칸</div>
          {% for b in st.summary_blanks %}<span class="ans-item"><b>{{ b.num }})</b> {{ b.answer }}</span>{% endfor %}
        </div>
      </div>
      {% if st.summary_ko %}
      <div class="ans-sum-ko"><span class="ans-col-h sb-h">요약문 해석</span> {{ st.summary_ko }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

</body>
</html>
