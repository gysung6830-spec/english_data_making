<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>내신 서술형 대비 교재</title>
<style>
  /* 교재 전용 페이지 하단: 왼쪽=저작권, 오른쪽=페이지 번호 (전역 중앙 번호는 끔) */
  @page {
    @bottom-center { content: none; }
    @bottom-left {
      content: "{{ (footer_note or '') | replace('\"', '') }}";
      font-family: "NanumSquareRound", "NanumGothic", sans-serif;
      font-size: 11px; color: #9aa0a6;
    }
    @bottom-right {
      content: counter(page) " / " counter(pages);
      font-family: "NanumSquareRound", "NanumGothic", sans-serif;
      font-size: 11px; color: #9aa0a6;
    }
  }
</style>
</head>
<body>

{# ---------- 공통 매크로 ---------- #}
{% macro thead(n, name, instr) %}
  <div class="t-head">
    <span class="t-badge">유형 {{ n }}</span>
    <span class="t-name">{{ name }}</span>
    <span class="t-instr">{{ instr }}</span>
  </div>
{% endmacro %}

{% macro qhead(q) %}
  <div class="q-head"><span class="q-no">{{ q.qno }}</span><span class="q-src">{{ q.src }}</span></div>
{% endmacro %}

{% macro chips(words, cls) %}
  <div class="chips">{% for w in words %}<span class="chip {{ cls }}">{{ w }}</span>{% endfor %}</div>
{% endmacro %}

{% macro psub(pg) %}<div class="p-sub">{{ pg.srclabel }}</div>{% endmacro %}

{% macro blank_boxes(blanks, reveal) %}
  <div class="sum-boxes">
    {% for b in blanks %}
    <div class="sum-box">
      <span class="sum-lb">({{ b.label }})</span>
      <span class="sum-in{{ ' filled' if reveal }}">{% if reveal %}{{ b.answer }}{% if b.meaning %} <em>({{ b.meaning }})</em>{% endif %}{% else %}{{ b.hint }}{% endif %}</span>
    </div>
    {% endfor %}
  </div>
{% endmacro %}

{% macro arrange_card(q, reveal) %}
  <div class="q-card">
    {{ qhead(q) }}
    <div class="ko-target">{{ q.korean }}{% if q.word_count %} <span class="wc">{{ q.word_count }}</span>{% endif %}</div>
    <div class="box-label">&lt;보기&gt;</div>
    {{ chips(q.given_words, 'g3') }}
    {% if reveal %}<div class="ans-line">➜ {{ q.answer }}</div>{% if q.explanation %}<div class="exp">{{ q.explanation }}</div>{% endif %}
    {% else %}<div class="ans-box">➜</div>{% endif %}
  </div>
{% endmacro %}

{# ---------- 한 파트(학생용/교사용)의 7개 유형 · type-major ---------- #}
{% macro render_part(passages, reveal) %}

  {# ===== 유형1 : 보기 어휘 빈칸 완성 ===== #}
  {% if has.cloze %}
  <div class="type-block tb1">
  {{ thead(1, '보기 어휘 빈칸 완성', '보기에서 알맞은 낱말을 골라 빈칸을 완성할 때, 사용되지 않는 낱말을 모두 고르시오.') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    <div class="grid2">
    {% for s in pg.cloze %}
    <div class="q-card">
      {{ qhead(s) }}
      <div class="box-label">&lt;보기&gt;</div>
      {{ chips(s.choices, 'g5') }}
      <div class="cloze">
        {% for se in s.sentences %}
        <div class="cloze-sent">{% if reveal %}{{ se.teacher }}{% else %}{{ se.student }}{% endif %}</div>
        {% endfor %}
      </div>
      <ol class="opts inline">
        {% for c in s.choices %}
        <li class="{{ 'correct' if reveal and loop.index in s.unused_index }}"><span class="cn">{{ loop.index | circled }}</span> {{ c }}</li>
        {% endfor %}
      </ol>
      {% if reveal %}<div class="exp"><b>사용되지 않는 낱말 {% for i in s.unused_index %}{{ i | circled }}{% endfor %} ({{ s.unused | join(', ') }})</b> {{ s.explanation }}</div>{% endif %}
    </div>
    {% endfor %}
    </div>
  {% endfor %}
  </div>

  {% endif %}
  {# ===== 유형2 : 서술형 요약문 완성 ===== #}
  {% if has.summary %}
  <div class="type-block tb2">
  {{ thead(2, '서술형 요약문 완성', '지문을 읽고 빈칸에 알맞은 단어를 원문에서 찾아 쓰시오. (필요시 어형 변화)') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    <div class="rq2">
      {% if pg.passage %}<div class="reading">{{ pg.passage }}</div>{% endif %}
      <div class="rq-cards">
      {% for q in pg.summary %}
      <div class="q-card">
        {{ qhead(q) }}
        <div class="q-body">{% if reveal %}{{ q.teacher }}{% else %}{{ q.student }}{% endif %}</div>
        {{ blank_boxes(q.blanks, reveal) }}
      </div>
      {% endfor %}
      </div>
    </div>
  {% endfor %}
  </div>

  {% endif %}
  {# ===== 유형3 : 어법 오류 수정 ===== #}
  {% if has.error %}
  <div class="type-block tb3">
  {{ thead(3, '어법 오류 수정', '밑줄 친 부분 중 어법상 틀린 부분을 모두 찾아 바르게 고치시오.') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    {% for q in pg.error %}
    <div class="q-card">
      {{ qhead(q) }}
      <div class="q-body">{% if reveal %}{{ q.teacher }}{% else %}{{ q.student }}{% endif %}</div>
      {% if reveal %}
        <div class="ans-line">
          {% for w in q.wrong %}<span class="fixpair">{{ w.no | circled }} <span class="wrong">{{ w.text }}</span> ➜ <span class="fix">{{ w.correction }}</span>{% if w.point %} <span class="pt">{{ w.point }}</span>{% endif %}</span>{% if not loop.last %} 　 {% endif %}{% endfor %}
        </div>
        {% if q.explanation %}<div class="exp">{{ q.explanation }}</div>{% endif %}
      {% else %}<div class="ans-box"><span class="ans-hint">어법상 틀린 부분의 번호와 고친 표현을 쓰시오</span></div>{% endif %}
    </div>
    {% endfor %}
  {% endfor %}
  </div>

  {% endif %}
  {# ===== 유형4 : 조건 영작 연습 ===== #}
  {% if has.compose %}
  <div class="type-block tb4">
  {{ thead(4, '조건 영작 연습', '난이도(하·중·상)별로 주어진 단어를 활용해 같은 문장을 영작하시오. (하=많이·상=적게 제시)') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    <div class="grid2">
    {% for q in pg.compose %}
    <div class="q-card">
      {{ qhead(q) }}
      <div class="ko-target">{{ q.korean }}{% if q.word_count %} <span class="wc">{{ q.word_count }}</span>{% endif %}</div>
      {% if q.conditions %}<div class="cond"><span class="cond-lb">조건</span>{{ q.conditions | join(' · ') }}</div>{% endif %}
      {% for lv in q.levels %}
      <div class="lv-block">
        <div class="lv-row"><span class="lv-badge {{ lv.cls }}">{{ lv.tag }}</span>{% if lv.words %}{{ chips(lv.words, 'g4') }}{% else %}<span class="lv-none">단어 제시 없음</span>{% endif %}</div>
        {% if not reveal %}<div class="ans-box sm">➜</div>{% endif %}
      </div>
      {% endfor %}
      {% if reveal %}<div class="ans-line">➜ {{ q.answer }}</div>{% if q.explanation %}<div class="exp">{{ q.explanation }}</div>{% endif %}{% endif %}
    </div>
    {% endfor %}
    </div>
  {% endfor %}
  </div>

  {% endif %}
  {# ===== 유형5 : 요지·제목 배열 영작 ===== #}
  {% if has.arrange %}
  <div class="type-block tb5">
  {{ thead(5, '요지·제목 배열 영작', '보기의 단어를 모두 사용하여 영작하시오.') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    <div class="two-col">
      <div class="col">
        <div class="col-label idea">글의 요지</div>
        {% for q in pg.ideas %}{{ arrange_card(q, reveal) }}{% endfor %}
      </div>
      <div class="col">
        <div class="col-label title">글의 제목</div>
        {% for q in pg.titles %}{{ arrange_card(q, reveal) }}{% endfor %}
      </div>
    </div>
  {% endfor %}
  </div>

  {% endif %}
  {# ===== 유형6 : 문장 변형 대비(보기 제공) ===== #}
  {% if has.paraphrase %}
  <div class="type-block tb6">
  {{ thead(6, '문장 변형 대비', '유의어·구조를 바꾼 문장의 빈칸을, 보기에서 골라 완성하시오.') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    <div class="grid2">
    {% for q in pg.paraphrase %}
    <div class="q-card">
      {{ qhead(q) }}
      <div class="box-label">&lt;보기&gt;</div>
      {{ chips(q.choices, 'g6') }}
      <div class="q-body">{% if reveal %}{{ q.teacher }}{% else %}{{ q.student }}{% endif %}</div>
      {{ blank_boxes(q.blanks, reveal) }}
      {% if reveal %}<div class="exp"><b>원문</b> {{ q.original }}{% if q.explanation %}<br>{{ q.explanation }}{% endif %}</div>{% endif %}
    </div>
    {% endfor %}
    </div>
  {% endfor %}
  </div>

  {% endif %}
  {# ===== 유형7 : 지문 기반 영어 문답(지문 배치) ===== #}
  {% if has.qa %}
  <div class="type-block tb7">
  {{ thead(7, '지문 기반 영어 문답', '지문을 읽고, 지문 내용에 근거하여 영어 질문에 영어로 답하시오. (지문에 없는 내용 추론 금지)') }}
  {% for pg in passages %}
    {% if pg.total > 1 %}{{ psub(pg) }}{% endif %}
    <div class="rq2">
      {% if pg.passage %}<div class="reading">{{ pg.passage }}</div>{% endif %}
      <div class="rq-cards">
      {% for q in pg.qa %}
      <div class="q-card">
        {{ qhead(q) }}
        <div class="qa-q">{{ q.question }}</div>
        {% if reveal %}
          <div class="ans-line">➜ {{ q.answer }}</div>
          <div class="exp">{% if q.answer_ko %}{{ q.answer_ko }}{% endif %}{% if q.evidence %}{% if q.answer_ko %}<br>{% endif %}<b>근거</b> {{ q.evidence }}{% endif %}</div>
        {% else %}<div class="ans-box">➜</div>{% endif %}
      </div>
      {% endfor %}
      </div>
    </div>
  {% endfor %}
  </div>
  {% endif %}
{% endmacro %}

{# ---------- 빠른 정답(유형별로 모든 지문 모아서) ---------- #}
{% macro quick(passages) %}
  {% if has.cloze %}<div class="qa-row"><span class="qa-t">유형1</span>{% for pg in passages %}{% for s in pg.cloze %}<span class="qa-a">{{ s.qno }}. {% for i in s.unused_index %}{{ i | circled }}{% endfor %} ({{ s.unused | join(', ') }})</span>{% endfor %}{% endfor %}</div>{% endif %}
  {% if has.summary %}<div class="qa-row"><span class="qa-t">유형2</span>{% for pg in passages %}{% for q in pg.summary %}<span class="qa-a">{{ q.qno }}. {% for b in q.blanks %}({{ b.label }}){{ b.answer }}{% if not loop.last %} {% endif %}{% endfor %}</span>{% endfor %}{% endfor %}</div>{% endif %}
  {% if has.error %}<div class="qa-row"><span class="qa-t">유형3</span>{% for pg in passages %}{% for q in pg.error %}<span class="qa-a">{{ q.qno }}. {% for w in q.wrong %}{{ w.no | circled }}{{ w.text }}→{{ w.correction }}{% if not loop.last %} / {% endif %}{% endfor %}</span>{% endfor %}{% endfor %}</div>{% endif %}
  {% if has.compose %}<div class="qa-row"><span class="qa-t">유형4</span><div class="qa-list">{% for pg in passages %}{% for q in pg.compose %}<div class="qa-a">{{ q.qno }}. {{ q.answer }}</div>{% endfor %}{% endfor %}</div></div>{% endif %}
  {% if has.arrange %}<div class="qa-row"><span class="qa-t">유형5</span><div class="qa-list">{% for pg in passages %}{% for q in pg.ideas %}<div class="qa-a">{{ q.qno }}. {{ q.answer }}</div>{% endfor %}{% for q in pg.titles %}<div class="qa-a">{{ q.qno }}. {{ q.answer }}</div>{% endfor %}{% endfor %}</div></div>{% endif %}
  {% if has.paraphrase %}<div class="qa-row"><span class="qa-t">유형6</span>{% for pg in passages %}{% for q in pg.paraphrase %}<span class="qa-a">{{ q.qno }}. {% for b in q.blanks %}({{ b.label }}){{ b.answer }}{% if not loop.last %} {% endif %}{% endfor %}</span>{% endfor %}{% endfor %}</div>{% endif %}
  {% if has.qa %}<div class="qa-row"><span class="qa-t">유형7</span><div class="qa-list">{% for pg in passages %}{% for q in pg.qa %}<div class="qa-a">{{ q.qno }}. {{ q.answer }}</div>{% endfor %}{% endfor %}</div></div>{% endif %}
{% endmacro %}

{# ---------- 정답 및 해설(유형별로 모든 지문 모아서) ---------- #}
{% macro explain(passages) %}
  {% if has.cloze %}<div class="ex-t">유형1 · 보기 어휘 빈칸 완성</div>
  {% for pg in passages %}{% for s in pg.cloze %}<div class="ex-r"><b>{{ s.qno }}. 사용되지 않는 낱말 {% for i in s.unused_index %}{{ i | circled }}{% endfor %} ({{ s.unused | join(', ') }})</b>{% if s.explanation %}<br><span class="ex-n">{{ s.explanation }}</span>{% endif %}</div>{% endfor %}{% endfor %}{% endif %}
  {% if has.summary %}<div class="ex-t">유형2 · 서술형 요약문 완성</div>
  {% for pg in passages %}{% for q in pg.summary %}<div class="ex-r"><b>{{ q.qno }}.</b> {% for b in q.blanks %}({{ b.label }}) <b>{{ b.answer }}</b>{% if b.meaning %} {{ b.meaning }}{% endif %}{% if not loop.last %} / {% endif %}{% endfor %}</div>{% endfor %}{% endfor %}{% endif %}
  {% if has.error %}<div class="ex-t">유형3 · 어법 오류 수정</div>
  {% for pg in passages %}{% for q in pg.error %}<div class="ex-r"><b>{{ q.qno }}.</b> {% for w in q.wrong %}{{ w.no | circled }} <span class="wrong">{{ w.text }}</span> ➜ <span class="fix">{{ w.correction }}</span>{% if w.point %} ({{ w.point }}){% endif %}{% if not loop.last %} / {% endif %}{% endfor %}{% if q.explanation %}<br><span class="ex-n">{{ q.explanation }}</span>{% endif %}</div>{% endfor %}{% endfor %}{% endif %}
  {% if has.compose %}<div class="ex-t">유형4 · 조건 영작 연습</div>
  {% for pg in passages %}{% for q in pg.compose %}<div class="ex-r"><b>{{ q.qno }}.</b> ➜ {{ q.answer }}{% if q.explanation %}<br><span class="ex-n">{{ q.explanation }}</span>{% endif %}</div>{% endfor %}{% endfor %}{% endif %}
  {% if has.arrange %}<div class="ex-t">유형5 · 요지·제목 배열 영작</div>
  {% for pg in passages %}{% for q in pg.ideas %}<div class="ex-r"><b>{{ q.qno }}. [요지]</b> ➜ {{ q.answer }}{% if q.explanation %}<br><span class="ex-n">{{ q.explanation }}</span>{% endif %}</div>{% endfor %}{% for q in pg.titles %}<div class="ex-r"><b>{{ q.qno }}. [제목]</b> ➜ {{ q.answer }}{% if q.explanation %}<br><span class="ex-n">{{ q.explanation }}</span>{% endif %}</div>{% endfor %}{% endfor %}{% endif %}
  {% if has.paraphrase %}<div class="ex-t">유형6 · 문장 변형 대비</div>
  {% for pg in passages %}{% for q in pg.paraphrase %}<div class="ex-r"><b>{{ q.qno }}.</b> {% for b in q.blanks %}({{ b.label }}) <b>{{ b.answer }}</b>{% if b.meaning %} {{ b.meaning }}{% endif %}{% if not loop.last %} / {% endif %}{% endfor %}{% if q.explanation %}<br><span class="ex-n">{{ q.explanation }}</span>{% endif %}</div>{% endfor %}{% endfor %}{% endif %}
  {% if has.qa %}<div class="ex-t">유형7 · 지문 기반 영어 문답</div>
  {% for pg in passages %}{% for q in pg.qa %}<div class="ex-r"><b>{{ q.qno }}. Q.</b> {{ q.question }}<br>➜ {{ q.answer }}{% if q.answer_ko %} <span class="ex-n">({{ q.answer_ko }})</span>{% endif %}{% if q.evidence %}<br><span class="ex-n">근거: {{ q.evidence }}</span>{% endif %}</div>{% endfor %}{% endfor %}{% endif %}
{% endmacro %}

{% macro part_head(no, label, sub) %}
  <div class="part-head">
    <span class="part-badge">PART {{ no }}</span>
    <span class="part-title">{{ label }}</span>
    <span class="part-sub">{{ sub }}</span>
  </div>
{% endmacro %}

{% macro doc_header() %}
  <div class="doc-head">
    <span class="doc-badge">서술형 대비 교재</span>
    <div class="doc-title">{{ title }}</div>
  </div>
{% endmacro %}

{# ================= 표지 겸 사용 설명서 ================= #}
{% set type_meta = [
  ('cloze', has.cloze, '보기 어휘 빈칸 완성', '보기 낱말로 빈칸을 채우고, 쓰이지 않는 낱말을 가려냅니다.'),
  ('summary', has.summary, '서술형 요약문 완성', '지문을 요약한 문장의 빈칸을 원문 어휘로 채웁니다.'),
  ('error', has.error, '어법 오류 수정', '밑줄 친 부분에서 어법상 틀린 곳을 찾아 바르게 고칩니다.'),
  ('compose', has.compose, '조건 영작 연습', '조건과 주어진 단어에 맞춰 영어 문장을 완성합니다.'),
  ('arrange', has.arrange, '요지·제목 배열 영작', '보기 단어를 모두 배열해 글의 요지와 제목을 영작합니다.'),
  ('paraphrase', has.paraphrase, '문장 변형 대비', '유의어·구조를 바꾼 문장의 빈칸을 보기에서 골라 채웁니다.'),
  ('qa', has.qa, '지문 기반 영어 문답', '지문 내용에 근거하여 영어 질문에 영어로 답합니다.')
] %}
{% set shown_types = type_meta | selectattr(1) | list %}
<div class="doc cover">
  <div class="cv-top">
    <span class="cv-badge">내신 서술형 · 변형문제 대비</span>
    <h1 class="cv-title">{{ title }}</h1>
    <div class="cv-rule"></div>
    <div class="cv-meta">지문 {{ passages | length }}개 · 수록 유형 {{ shown_types | length }}종 · 4단 구성(학생용 · 교사용 · 빠른 정답 · 정답 및 해설)</div>
  </div>

  <div class="cv-sec">
    <div class="cv-h">이 교재 구성</div>
    <div class="cv-parts">
      <div class="cv-part"><span class="cv-pn">PART 1</span><b>학생용</b><span>문제만 수록. 시험처럼 직접 풀어 봅니다.</span></div>
      <div class="cv-part"><span class="cv-pn">PART 2</span><b>교사용</b><span>같은 문제에 정답과 해설이 함께 표시됩니다.</span></div>
      <div class="cv-part"><span class="cv-pn">PART 3</span><b>빠른 정답</b><span>해설 없이 정답만 모아 빠른 채점용.</span></div>
      <div class="cv-part"><span class="cv-pn">PART 4</span><b>정답 및 해설</b><span>유형별 정답과 풀이를 정리했습니다.</span></div>
    </div>
  </div>

  <div class="cv-sec">
    <div class="cv-h">수록 유형 ({{ shown_types | length }}종)</div>
    <ol class="cv-types">
      {% for key, on, name, desc in shown_types %}
      <li><span class="cv-tn">유형 {{ loop.index }}</span><b>{{ name }}</b><span class="cv-td">{{ desc }}</span></li>
      {% endfor %}
    </ol>
  </div>

  <div class="cv-sec">
    <div class="cv-h">활용법</div>
    <ul class="cv-tips">
      <li><b>학생</b> · 학생용으로 실전처럼 풀고, ‘정답 및 해설’로 채점·오답 복습을 합니다.</li>
