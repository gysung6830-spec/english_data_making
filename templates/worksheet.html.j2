<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>내신 서술형 대비 교재</title></head>
<body>

{# ===== 한 지문의 6개 유형(문제 본체) — 학생용/교사용 공용 ===== #}
{% macro render_types(pg, reveal) %}
  {% set ws = pg.ws %}
  {% if pg.total > 1 %}<div class="ws-passage-tag">지문 {{ pg.no }} / {{ pg.total }} · {{ ws.title }}</div>{% endif %}

  {% for t in types %}
  <div class="ws-type ws-t{{ t.n }}">
    <div class="ws-thead">
      <span class="ws-tnum">유형 {{ t.n }}</span>
      <span class="ws-tname">{{ t.name }}</span>
      <span class="ws-tsub">{{ t.sub }}</span>
    </div>

    {# 유형1: 요약문 빈칸 #}
    {% if t.key == 'summary' %}
      <div class="ws-summary">{{ ws.summary.text | ws_blanks(ws.summary.answers, reveal) }}</div>
      {% if reveal %}<div class="ws-ko">{{ ws.summary.translation }}</div>{% endif %}

    {# 유형2: 문장 변형 선택 #}
    {% elif t.key == 'paraphrase' %}
      {% for q in ws.paraphrase.questions %}
      <div class="ws-item">
        <div class="ws-stem"><b>{{ q.no }}.</b> 다음 문장과 의미가 <u>일치하는</u> 것은?</div>
        <div class="ws-original">{{ q.original }}</div>
        <ol class="ws-opts">
          {% for op in q.options %}
          <li class="{{ 'ws-correct' if reveal and loop.index == q.answer }}"><span class="ws-cn">{{ loop.index | circled }}</span> {{ op }}</li>
          {% endfor %}
        </ol>
        {% if reveal %}<div class="ws-exp"><b>정답 {{ q.answer | circled }}</b> {{ q.explanation }}</div>{% endif %}
      </div>
      {% endfor %}

    {# 유형3·4: 영작 #}
    {% elif t.key in ('compose_idea', 'compose_cond') %}
      {% set comp = ws.compose_idea if t.key == 'compose_idea' else ws.compose_cond %}
      {% for it in comp.items %}
      <div class="ws-item">
        <div class="ws-stem"><b>{{ it.no }}.</b> {% if it.label %}<span class="ws-label">{{ it.label }}</span> {% endif %}{{ it.korean }}{% if it.word_count %} <span class="ws-wc">({{ it.word_count }})</span>{% endif %}</div>
        {% if it.given_words %}<div class="ws-given"><b>보기</b> {{ it.given_words | join('  /  ') }}</div>{% endif %}
        {% if it.conditions %}<div class="ws-cond"><b>조건</b> {{ it.conditions | join(' · ') }}</div>{% endif %}
        {% if reveal %}
          <div class="ws-answer">➜ {{ it.answer }}</div>
          {% if it.explanation %}<div class="ws-exp">{{ it.explanation }}</div>{% endif %}
        {% else %}
          <div class="ws-writeline"></div>
        {% endif %}
      </div>
      {% endfor %}

    {# 유형5: 들어갈 수 없는 단어 #}
    {% elif t.key == 'choice' %}
      {% for it in ws.choice.items %}
      <div class="ws-item">
        <div class="ws-stem"><b>{{ it.no }}.</b> {{ it.sentence }}</div>
        <div class="ws-opts-inline">
          {% for c in it.choices %}<span class="ws-opt {{ 'ws-correct' if reveal and loop.index == it.answer }}"><span class="ws-cn">{{ loop.index | circled }}</span> {{ c }}</span>{% endfor %}
        </div>
        {% if reveal %}<div class="ws-exp"><b>들어갈 수 없는 단어 {{ it.answer | circled }}</b> {{ it.explanation }}</div>{% endif %}
      </div>
      {% endfor %}

    {# 유형6: 어법 오류 수정 #}
    {% elif t.key == 'error' %}
      {% for it in ws.error.items %}
      <div class="ws-item">
        <div class="ws-stem"><b>{{ it.no }}.</b> {{ it.text }}</div>
        {% if reveal %}
          <div class="ws-answer"><span class="ws-wrong">{{ it.error }}</span> ➜ <span class="ws-fix">{{ it.correction }}</span></div>
          {% if it.explanation %}<div class="ws-exp">{{ it.explanation }}</div>{% endif %}
        {% else %}
          <div class="ws-writeline"><span class="ws-wl-label">틀린 부분 → 고쳐 쓰기</span></div>
        {% endif %}
      </div>
      {% endfor %}
    {% endif %}
  </div>
  {% endfor %}
{% endmacro %}

{# ===== 빠른 정답 (한 지문) ===== #}
{% macro quick_answers(pg) %}
  {% set ws = pg.ws %}
  <div class="qa-block">
    {% if pg.total > 1 %}<div class="qa-passage">지문 {{ pg.no }}. {{ ws.title }}</div>{% endif %}
    <div class="qa-line"><span class="qa-t">유형1</span>
      {% for a in ws.summary.answers %}<span class="qa-a">{{ a.no }}. {{ a.word }}</span>{% endfor %}
    </div>
    <div class="qa-line"><span class="qa-t">유형2</span>
      {% for q in ws.paraphrase.questions %}<span class="qa-a">{{ q.no }}. {{ q.answer | circled }}</span>{% endfor %}
    </div>
    <div class="qa-line"><span class="qa-t">유형3</span>
      {% for it in ws.compose_idea.items %}<span class="qa-a">{{ it.label or it.no }}: {{ it.answer }}</span>{% endfor %}
    </div>
    <div class="qa-line"><span class="qa-t">유형4</span>
      {% for it in ws.compose_cond.items %}<span class="qa-a">{{ it.no }}. {{ it.answer }}</span>{% endfor %}
    </div>
    <div class="qa-line"><span class="qa-t">유형5</span>
      {% for it in ws.choice.items %}<span class="qa-a">{{ it.no }}. {{ it.answer | circled }}</span>{% endfor %}
    </div>
    <div class="qa-line"><span class="qa-t">유형6</span>
      {% for it in ws.error.items %}<span class="qa-a">{{ it.no }}. {{ it.error }}→{{ it.correction }}</span>{% endfor %}
    </div>
  </div>
{% endmacro %}

{# ===== 정답 및 해설 (한 지문) ===== #}
{% macro explanations(pg) %}
  {% set ws = pg.ws %}
  {% if pg.total > 1 %}<div class="ex-passage">지문 {{ pg.no }}. {{ ws.title }}</div>{% endif %}

  <div class="ex-type"><div class="ex-th">유형1 · 서술형 요약문 완성</div>
    <div class="ex-ans">완성: {{ ws.summary.text | ws_blanks(ws.summary.answers, true) }}</div>
    <ul class="ex-ul">{% for a in ws.summary.answers %}<li><b>{{ a.no }}. {{ a.word }}</b>{% if a.note %} — {{ a.note }}{% endif %}</li>{% endfor %}</ul>
    {% if ws.summary.translation %}<div class="ex-ko">{{ ws.summary.translation }}</div>{% endif %}
  </div>

  <div class="ex-type"><div class="ex-th">유형2 · 문장 변형 대비</div>
    {% for q in ws.paraphrase.questions %}
    <div class="ex-row"><b>{{ q.no }}. 정답 {{ q.answer | circled }}</b> — {{ q.explanation }}</div>
    {% endfor %}
  </div>

  <div class="ex-type"><div class="ex-th">유형3 · 요지·제목 배열 영작</div>
    {% for it in ws.compose_idea.items %}
    <div class="ex-row"><b>{{ it.label or it.no }}</b> ➜ {{ it.answer }}{% if it.explanation %}<br><span class="ex-note">{{ it.explanation }}</span>{% endif %}</div>
    {% endfor %}
  </div>

  <div class="ex-type"><div class="ex-th">유형4 · 조건 영작 연습</div>
    {% for it in ws.compose_cond.items %}
    <div class="ex-row"><b>{{ it.no }}.</b> ➜ {{ it.answer }}{% if it.explanation %}<br><span class="ex-note">{{ it.explanation }}</span>{% endif %}</div>
    {% endfor %}
  </div>

  <div class="ex-type"><div class="ex-th">유형5 · 보기 어휘 빈칸 완성</div>
    {% for it in ws.choice.items %}
    <div class="ex-row"><b>{{ it.no }}. 들어갈 수 없는 단어 {{ it.answer | circled }}</b> — {{ it.explanation }}</div>
    {% endfor %}
  </div>

  <div class="ex-type"><div class="ex-th">유형6 · 어법 오류 수정</div>
    {% for it in ws.error.items %}
    <div class="ex-row"><b>{{ it.no }}.</b> <span class="ws-wrong">{{ it.error }}</span> ➜ <span class="ws-fix">{{ it.correction }}</span>{% if it.explanation %}<br><span class="ex-note">{{ it.explanation }}</span>{% endif %}</div>
    {% endfor %}
  </div>
{% endmacro %}

{# ===== 파트 표지 ===== #}
{% macro part_header(no, label, sub) %}
  <div class="ws-part-head">
    <span class="ws-part-badge">PART {{ no }}</span>
    <span class="ws-part-title">{{ label }}</span>
    <span class="ws-part-sub">{{ sub }}</span>
  </div>
{% endmacro %}

{# ================= PART 1. 학생용 ================= #}
<div class="ws-doc">
  <div class="doc-header">
    <span class="doc-badge">서술형 대비 교재</span>
    <div class="doc-title">{{ title }}</div>
    <div class="doc-source">학생용 · 교사용 · 빠른 정답 · 정답 및 해설</div>
  </div>
  {{ part_header(1, '학생용', '문제만 실려 있습니다. 직접 풀어 보세요.') }}
  {% for pg in passages %}
  <div class="ws-passage{{ ' pgbreak' if not loop.first }}">{{ render_types(pg, false) }}</div>
  {% endfor %}
  {% if footer_note %}<div class="footer-note">{{ footer_note }}</div>{% endif %}
</div>

{# ================= PART 2. 교사용 ================= #}
<div class="ws-doc pgbreak">
  {{ part_header(2, '교사용', '문제에 정답과 해설이 함께 표시됩니다.') }}
  {% for pg in passages %}
  <div class="ws-passage{{ ' pgbreak' if not loop.first }}">{{ render_types(pg, true) }}</div>
  {% endfor %}
  {% if footer_note %}<div class="footer-note">{{ footer_note }}</div>{% endif %}
</div>

{# ================= PART 3. 빠른 정답 ================= #}
<div class="ws-doc pgbreak">
  {{ part_header(3, '빠른 정답', '해설 없이 정답만 모았습니다.') }}
  {% for pg in passages %}{{ quick_answers(pg) }}{% endfor %}
  {% if footer_note %}<div class="footer-note">{{ footer_note }}</div>{% endif %}
</div>

{# ================= PART 4. 정답 및 해설 ================= #}
<div class="ws-doc pgbreak">
  {{ part_header(4, '정답 및 해설', '유형별 정답과 풀이를 정리했습니다.') }}
  {% for pg in passages %}
  <div class="{{ 'pgbreak' if not loop.first }}">{{ explanations(pg) }}</div>
  {% endfor %}
  {% if footer_note %}<div class="footer-note">{{ footer_note }}</div>{% endif %}
</div>

</body>
</html>
