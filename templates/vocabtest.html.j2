<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>핵심 어휘 시험지</title></head>
<body>
  {# 모든 페이지 하단에 반복되는 브랜드 저작권 (running element) #}
  {% if footer_note %}<div class="pg-copyright">{{ footer_note }}</div>{% endif %}
  {# ── 브랜드 헤더(오르티카 스타일): 로고 마크 + 워드마크 + 문서 라벨 ── #}
  {% macro ot_head(pg, kind_en, kind_ko, fields) %}
  <div class="ot-head">
    <div class="ot-id">
      {% if brand_mark %}<span class="ot-mark">{{ brand_mark }}</span>{% endif %}
      <span class="ot-idtext">
        {% if brand_name %}<span class="ot-word">{{ brand_name }}</span>{% endif %}
        <span class="ot-kicker">{{ kind_en }} · {{ kind_ko }}</span>
      </span>
    </div>
    {% if fields %}
    <div class="ot-fields">
      <span class="ot-field">이름 <span class="ot-line"></span></span>
      <span class="ot-field">점수 <span class="ot-line short"></span></span>
    </div>
    {% else %}
    <div class="ot-akchip">정답 · ANSWER KEY</div>
    {% endif %}
  </div>
  <div class="ot-titlebar">
    <span class="ot-title">{{ pg.title }}</span>
    {% if pg.item_no %}<span class="ot-tag">{{ pg.item_no }}번</span>
    {% elif pg.total > 1 %}<span class="ot-tag">지문 {{ pg.no }} / {{ pg.total }}</span>{% endif %}
  </div>
  {% endmacro %}

  {# 지문별: 문제(뜻쓰기 → 유의어 줄긋기 → 반의어 줄긋기) #}
  {% for pg in passages %}
  <div class="wl-passage vt-page{{ ' pgbreak' if not loop.first }}">
    {{ ot_head(pg, "VOCABULARY TEST", "핵심 어휘 시험", true) }}

    {# ① 단어 뜻 쓰기 #}
    <div class="vt-part"><span class="vt-pno">Ⅰ</span>다음 단어의 뜻을 쓰세요. <span class="vt-hint">(순서 무작위)</span></div>
    {% if pg.mean %}
    <table class="grid t-quiz">
      <thead><tr>
        <th class="wl-no">No</th><th class="wl-en">단어</th><th class="q-blank">뜻 쓰기</th>
        <th class="wl-no">No</th><th class="wl-en">단어</th><th class="q-blank">뜻 쓰기</th>
      </tr></thead>
      <tbody>
      {% for l, r in pg.mean_rows %}
        <tr>
          <td class="wl-no">{{ l.qno }}</td><td class="wl-en">{{ l.word }}</td><td class="q-blank"></td>
          {% if r %}
          <td class="wl-no">{{ r.qno }}</td><td class="wl-en">{{ r.word }}</td><td class="q-blank"></td>
          {% else %}<td></td><td></td><td class="q-blank"></td>{% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {# ② 유의어 줄긋기 #}
    {% if pg.syn %}
    <div class="vt-part"><span class="vt-pno">Ⅱ</span>단어와 <b>유의어</b>를 선으로 이으세요.</div>
    <table class="match">
      <tbody>
      {% for i in range(pg.syn.L|length) %}
        <tr>
          <td class="mt-left"><span class="mt-no">{{ pg.syn.L[i].no }}</span> {{ pg.syn.L[i].word }} <span class="mt-dot">○</span></td>
          <td class="mt-gap"></td>
          <td class="mt-right">{% if i < pg.syn.R|length %}<span class="mt-dot">○</span> <span class="mt-sym">{{ pg.syn.R[i].sym }}</span> {{ pg.syn.R[i].target }}{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {# ③ 반의어 줄긋기 #}
    {% if pg.ant %}
    <div class="vt-part"><span class="vt-pno">Ⅲ</span>단어와 <b>반의어</b>를 선으로 이으세요.</div>
    <table class="match">
      <tbody>
      {% for i in range(pg.ant.L|length) %}
        <tr>
          <td class="mt-left"><span class="mt-no">{{ pg.ant.L[i].no }}</span> {{ pg.ant.L[i].word }} <span class="mt-dot">○</span></td>
          <td class="mt-gap"></td>
          <td class="mt-right">{% if i < pg.ant.R|length %}<span class="mt-dot">○</span> <span class="mt-sym">{{ pg.ant.R[i].sym }}</span> {{ pg.ant.R[i].target }}{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
  {% endfor %}

  {# 정답: 문제 뒤에 지문별로 모아서 #}
  {% for pg in passages %}
  <div class="answer-key pgbreak">
    {{ ot_head(pg, "ANSWER KEY", "정답", false) }}

    <div class="ak-sub"><span class="ak-pno">Ⅰ</span>단어 뜻</div>
    <div class="ak-list">
      {% for w in pg.answers %}<span class="ak-item"><b>{{ w.word }}</b> — {{ w.meaning }}</span>{% endfor %}
    </div>

    {% if pg.syn %}
    <div class="ak-sub"><span class="ak-pno">Ⅱ</span>유의어 줄긋기</div>
    <div class="ak-list">
      {% for l in pg.syn.L %}<span class="ak-item"><b>{{ l.no }}.</b> {{ l.word }} → {{ l.ans_sym }}</span>{% endfor %}
    </div>
    {% endif %}

    {% if pg.ant %}
    <div class="ak-sub"><span class="ak-pno">Ⅲ</span>반의어 줄긋기</div>
    <div class="ak-list">
      {% for l in pg.ant.L %}<span class="ak-item"><b>{{ l.no }}.</b> {{ l.word }} → {{ l.ans_sym }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}

</body>
</html>
