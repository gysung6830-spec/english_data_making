<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>{{ badge }} 단어 시험지</title></head>
<body>
  {% if footer_note %}<div class="pg-copyright">{{ footer_note }}</div>{% endif %}

{#- 문항 표: ans=true 면 쓰는 칸에 정답이 인쇄된 '답지'가 된다 -#}
{% macro grid(sec, ans) %}
    <table class="ht-grid{{ ' ko' if sec.dir == 'ko2en' }}{{ ' ans' if ans }}">
      {% if sec.single %}
      <colgroup>
        {% if sec.dir == 'ko2en' %}<col style="width:24pt"><col><col style="width:33%">
        {% else %}<col style="width:24pt"><col style="width:22%"><col>{% endif %}
      </colgroup>
      {% elif sec.dir == 'ko2en' %}
      <colgroup>
        <col style="width:20pt"><col><col style="width:88pt">
        <col style="width:16pt">
        <col style="width:20pt"><col><col style="width:88pt">
      </colgroup>
      {% else %}
      <colgroup>
        <col style="width:20pt"><col style="width:86pt"><col>
        <col style="width:16pt">
        <col style="width:20pt"><col style="width:86pt"><col>
      </colgroup>
      {% endif %}
      <tbody>
      {% for l, r in sec.rows %}
        <tr style="height:{{ sec.row_h_ans if ans else sec.row_h }}pt">
          {% for q in ([l] if sec.single else [l, r]) %}
            {% if not loop.first %}<td class="ht-mid"></td>{% endif %}
            {% if q %}
          <td class="ht-no">{{ "%02d"|format(q.qno) }}</td>
          <td class="ht-q{{ ' ko' if sec.dir == 'ko2en' }}">{{ q.prompt }}</td>
          <td class="ht-a">{% if ans %}<span class="ht-ans">{{ q.answer }}</span>{% elif q.hint %}<span class="ht-hint">{{ q.hint }}</span>{% endif %}</td>
            {% else %}
          <td class="ht-no"></td><td class="ht-q"></td><td class="ht-a"></td>
            {% endif %}
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
{% endmacro %}

  {# ── 문제 면: 섹션(영→한 / 한→영)마다 한 쪽 ── #}
  {% for sec in sections %}
  <div class="ht-page">
    <div class="ht-top">
      <span class="ht-badge">{{ badge }}</span>
      <span class="ht-meta">이름 <span class="ht-line"></span> 점수 <span class="ht-line short"></span> / {{ sec.questions|length }}</span>
    </div>

    <div class="ht-guide">
      <span class="ht-gtitle">{{ sec.no }}. {{ sec.title }}</span>
      <span class="ht-gsub">{{ sec.desc }}</span>
    </div>

    {{ grid(sec, false) }}
  </div>
  {% endfor %}

  {# ── 답지: 문제지와 같은 자리에 정답이 채워진 형태 ── #}
  {% for sec in sections %}
  <div class="ht-page">
    <div class="ht-top">
      <span class="ht-badge">{{ badge }} · 정답</span>
      <span class="ht-meta ht-akmark">ANSWER KEY</span>
    </div>

    <div class="ht-guide">
      <span class="ht-gtitle">{{ sec.no }}. {{ sec.title }}</span>
      <span class="ht-gsub">{{ sec.ans_desc }}</span>
    </div>

    {{ grid(sec, true) }}
  </div>
  {% endfor %}
</body>
</html>
