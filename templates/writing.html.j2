<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>{{ pack.title }} - 영작 워크북</title>
  <style>{{ font_css | safe }}</style>
  <style>{% include "writing.css" %}</style>
  <style>{% include "_common.css" %}</style>
</head>
<body>

  {% if section != 'a' %}
  <section class="ws">
    <div class="sh-head">
      {% if pack.label %}<span class="sh-badge">{{ pack.label }}</span>{% endif %}
    </div>
    <div class="ws-instr wt-writing">
      <span class="wt-label">{{ pack.wt_label or '영작' }}</span> {{ pack.instruction }}
    </div>
    {% if pack.caution %}<div class="ws-caution cx-{{ pack.caution_style or 'warn' }}"><span class="cx-icon">{{ pack.caution_badge or '주의' }}</span>{{ pack.caution }}</div>{% endif %}

    <ol class="ws-list">
      {% for s in pack.sentences %}
      <li>
        {# 영작의 우리말은 '해석'이 아니라 '문제(배열 지시)'이므로 한글 제외본에서도 항상 표시 #}
        <div class="s-ko-q">{{ s.ko }}</div>
        <div class="s-en">{{ s | render_writing }}</div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if section != 'q' %}
  {# 정답 #}
  <section class="ans-page">
    <div class="ans-head">정답 <span class="ans-sub">Answers · 바른 배열</span></div>
    {% for s in pack.sentences %}
    <div class="ans-row">
      <b>{{ s.no }}.</b>
      {% for it in s.items %}<span class="ans-a">{{ it.answer }}</span>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

</body>
</html>
