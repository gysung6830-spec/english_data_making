<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>영단어 시험지</title></head>
<body>
  {# 배치: 지문1 문제 → 지문2 문제 → … → 지문1 답 → 지문2 답 → … #}
  {% for pg in passages %}
  <div class="wl-passage{{ ' pgbreak' if not loop.first }}">
    <div class="doc-header">
      <span class="doc-badge">Vocabulary Quiz</span>
      {% if pg.total > 1 %}<span class="passage-tag">지문 {{ pg.no }} / {{ pg.total }}</span>{% endif %}
      <div class="doc-title">{{ pg.title }}</div>
      <div class="quiz-meta">
        이름 <span class="ql">&nbsp;</span>　　　점수 <span class="ql short">&nbsp;</span> / {{ pg.words|length }}
      </div>
      <div class="doc-source">아래 영단어의 한글 뜻을 쓰세요. (직독직해 핵심 어휘 · 순서 무작위)</div>
    </div>

    {% if pg.words %}
    <table class="grid t-quiz">
      <thead><tr>
        <th class="wl-no">No</th><th class="wl-en">단어</th><th class="q-blank">뜻 쓰기</th>
        <th class="wl-no">No</th><th class="wl-en">단어</th><th class="q-blank">뜻 쓰기</th>
      </tr></thead>
      <tbody>
      {% for l, r in pg.rows %}
        <tr>
          <td class="wl-no">{{ l.no }}</td><td class="wl-en">{{ l.word }}</td><td class="q-blank"></td>
          {% if r %}
          <td class="wl-no">{{ r.no }}</td><td class="wl-en">{{ r.word }}</td><td class="q-blank"></td>
          {% else %}<td></td><td></td><td class="q-blank"></td>{% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="wl-empty">직독직해에서 수집된 핵심 어휘가 없습니다.</div>
    {% endif %}

    {% if footer_note %}<div class="footer-note">{{ footer_note }}</div>{% endif %}
  </div>
  {% endfor %}

  {% for pg in passages %}
  {% if pg.words %}
  <div class="answer-key pgbreak">
    <div class="ak-title">정답 (Answer Key){% if pg.total > 1 %} · 지문 {{ pg.no }}{% endif %}</div>
    <div class="ak-list">
      {% for w in pg.words %}<span class="ak-item"><b>{{ w.no }}.</b> {{ w.word }} — {{ w.meaning }}</span>{% endfor %}
    </div>
  </div>
  {% endif %}
  {% endfor %}
</body>
</html>
