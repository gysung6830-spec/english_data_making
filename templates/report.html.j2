<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>영어 지문 분석 - Full Analysis</title></head>
<body>

{% macro render_report(report, pno, total) %}
  <div class="doc-header">
    <span class="doc-badge">지문 분석{% if student %} · 학생용{% endif %}</span>
    {% if brand %}<span class="doc-badge2">{{ brand }}</span>{% endif %}
    {% set _num = report.item_no or pno %}
    {% if source_label or _num %}<span class="doc-numbadge">{{ source_label }}{% if source_label and _num %} · {% endif %}{{ _num }}</span>{% endif %}
    <div class="doc-title">{% if report.summary.theme_ko %}<span class="title-ko">{{ report.summary.theme_ko }}</span><br>{% endif %}<span class="title-en">{{ report.summary.theme_en or report.title }}</span></div>
  </div>

  {# ① 주제 #}
  <div class="section s-sum">
    <div class="section-head">
      <span class="sec-num">1</span>
      <span class="sec-title">주제</span>
      <span class="sec-sub">Theme{% if student %} · 빈칸을 채워보세요{% endif %}</span>
    </div>
    <div class="summary-overall">{% if student %}{{ report.summary.overall | blank_ko(report.summary.keywords) }}{% else %}{{ report.summary.overall | highlight_ko(report.summary.keywords) }}{% endif %}</div>
  </div>

  {# ②③ 구조 분석 + 출제 포인트를 2단(좌우)으로 배치 #}
  <div class="two-col">
  {# ② 지문 구조 분석 (개조식 + 문장번호) #}
  <div class="section s-struc">
    <div class="section-head">
      <span class="sec-num">2</span>
      <span class="sec-title">지문 구조 분석</span>
      <span class="sec-sub">{{ "Logic Flow" if report.structure.flow_type == "logic" else "Emotional Flow" }}</span>
    </div>
    <span class="struc-type">
      {{ "논리 전개형 (Logic Flow)" if report.structure.flow_type == "logic" else "감정 전개형 (Emotional Flow)" }}
    </span>
    {% if report.structure.easy_explanation or report.structure.examples %}
    <div class="easy-box">
      {% if report.structure.easy_explanation %}
      <div class="easy-gist"><span class="easy-lbl">쉽게 말하면</span> {{ report.structure.easy_explanation }}</div>
      {% endif %}
      {% if report.structure.examples %}
      <div class="killer">
        <span class="killer-lbl">실생활 예시</span>
        <ol class="killer-list">
          {% for ex in report.structure.examples %}<li>{{ ex }}</li>{% endfor %}
        </ol>
      </div>
      {% endif %}
    </div>
    {% endif %}
    <ul class="flow">
      {% for st in report.structure.stages %}
      <li>
        <span class="stage">{{ st.stage }}</span>
        <span class="content">{{ st.content }}</span>
        {% if student %}<span class="stage-ref stage-blank">문장 <span class="blank" style="min-width:40px"></span></span>
        {% elif st.evidence %}<span class="stage-ref">{{ st.evidence }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>

  {# ③ '치밀하게 분석한' 출제 포인트 (유형별 카드) #}
  <div class="section s-exam">
    <div class="section-head">
      <span class="sec-num">3</span>
      <span class="sec-title">해석 포인트(함축의미)</span>
      <span class="sec-sub">Implied Meaning{% if brand %} · {{ brand }} tip{% endif %}</span>
    </div>
    <div class="exam-cards">
    {# 지칭추론은 직독직해 표(⑤)에, 서술형은 목차 7 에 배치 → 여기서는 함축의미만 #}
    {% for e in report.exam.items if '함축' in e.question_type %}
      <div class="exam-card ec-imp">
        <div class="ec-body">

        {%- if '지칭' in e.question_type -%}
          {%- for ln in e.content.split('\n') if ln.strip() -%}
            {%- set parts = ln.split(' - ') -%}
            {%- if parts | length >= 3 -%}
              <div class="ref-line">
                <span class="ref-loc">{{ parts[0] | trim }}</span>
                <span class="ref-pron">{{ parts[1] | trim }}</span>
                <span class="ref-arrow">→</span>
                {%- if student -%}<span class="blank" style="min-width:180px"></span>
                {%- else -%}<span class="ref-target">{{ (parts[2:] | join(' - ')) | trim | replace('(', '') | replace(')', '') }}</span>{%- endif -%}
              </div>
            {%- else -%}
              <div class="ref-line"><span class="ref-target">{{ ln | trim }}</span></div>
            {%- endif -%}
          {%- endfor -%}

        {%- elif '함축' in e.question_type -%}
          {%- for block in e.content | split_blocks -%}
            <div class="imp-block">
            {%- for ln in block.split('\n') if ln.strip() -%}
              {%- if '함정' in ln -%}<div class="imp-trap">{{ ln | trim }}</div>
              {%- elif '정답 표현' in ln -%}
                {%- if student -%}<div class="imp-ans">· 영어 정답 표현: <span class="blank" style="min-width:220px"></span></div>
                {%- else -%}<div class="imp-ans">{{ ln | trim }}</div>{%- endif -%}
              {%- elif '문맥상' in ln -%}
                {%- if student -%}<div class="imp-mean">· 문맥상 의미: <span class="blank" style="min-width:220px"></span></div>
                {%- else -%}<div class="imp-mean">{{ ln | trim }}</div>{%- endif -%}
              {%- else -%}
                {%- set qp = ln.split('"') -%}
                {%- if qp | length >= 2 -%}
                <div class="imp-expr"><span class="imp-loc">{{ qp[0] | trim }}</span><span class="imp-badge">{{ qp[1] | trim }}</span></div>
                {%- else -%}
                <div class="imp-expr"><span class="imp-badge">{{ ln | trim }}</span></div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            </div>
          {%- endfor -%}

        {%- elif '서술' in e.question_type -%}
          {%- for ln in e.content.split('\n') if ln.strip() -%}
            {%- if loop.first -%}<div class="narr-sent">{{ ln | trim }}</div>
            {%- elif student -%}<div class="narr-reason narr-blank">쓰인 문법: <span class="blank" style="min-width:240px"></span></div>
            {%- else -%}<div class="narr-reason">{{ ln | trim }}</div>{%- endif -%}
          {%- endfor -%}

        {%- else -%}
          <div class="pre">{{ e.content }}</div>
        {%- endif -%}

        </div>
      </div>
    {% endfor %}
    </div>
  </div>
  </div>{# /two-col #}

  {# ④ 핵심 단어 영어 요약문 (직독직해 앞) #}
  {% if report.vocab.english_summary %}
  <div class="section s-esum">
    <div class="section-head">
      <span class="sec-num">4</span>
      <span class="sec-title">핵심 단어 영어 요약문</span>
      <span class="sec-sub">굵은 단어 = 핵심 어휘</span>
    </div>
    <div class="esum-box">
      {% if student %}{{ report.vocab.english_summary | blank_words(report.vocab.items | map(attribute='word') | list) }}{% else %}{{ report.vocab.english_summary | highlight_words(report.vocab.items | map(attribute='word') | list) }}{% endif %}
    </div>
    {% if report.vocab.english_summary_ko and not student %}
    <div class="esum-ko">{{ report.vocab.english_summary_ko }}</div>
    {% endif %}
  </div>
  {% endif %}

  {# ⑤ 서술형 출제 예상 문장 (직독직해 앞) #}
  {% set ns_narr = namespace(has=false) %}
  {% for e in report.exam.items if '서술' in e.question_type %}{% set ns_narr.has = true %}{% endfor %}
  {% if ns_narr.has %}
  <div class="section s-narr">
    <div class="section-head">
      <span class="sec-num">5</span>
      <span class="sec-title">서술형 출제 예상 문장</span>
      <span class="sec-sub">Guided Writing</span>
    </div>
    <div class="exam-cards">
    {% for e in report.exam.items if '서술' in e.question_type %}
      <div class="exam-card ec-narr">
        <div class="ec-body">
          {%- for ln in e.content.split('\n') if ln.strip() -%}
            {%- if loop.first -%}<div class="narr-sent">{{ ln | trim }}</div>
            {%- elif student -%}<div class="narr-reason narr-blank">쓰인 문법: <span class="blank" style="min-width:240px"></span></div>
            {%- else -%}<div class="narr-reason">{{ ln | trim }}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {% endfor %}
    </div>
  </div>
  {% endif %}

  {# ⑥ 직독직해 (핵심 문법 통합) — 새 페이지에 단독 배치 #}
  <div class="section s-lit page-break">
    <div class="section-head">
      <span class="sec-num">6</span>
      <span class="sec-title">직독직해 {% if brand %}<span class="made-by">made by {{ brand }}</span>{% endif %}</span>
      <span class="sec-sub">문장별 핵심 문법 포함 · ★ = 관계사·분사·가정법·비교·도치·강조·5형식 필수 어법</span>
    </div>
    <table class="lit2{% if student %} stu{% endif %}">
      <thead><tr><th class="lh-en">영어 원문{% if student %} (핵심 문법에 ○ 표시){% else %} + 핵심 문법{% endif %}</th><th class="lh-ko">직독직해{% if not student %} + 핵심 단어{% endif %}</th></tr></thead>
      <tbody>
      {% set refs = report.exam | ref_map %}
      {% for s in report.literal.sentences %}
      <tr class="lit-row">
        <td class="lit-en">
          <span class="snum">{{ s.no }}</span>
          <span class="lit-line">
            {%- for c in s.chunks -%}
              <span class="ck ck{{ loop.index0 % 8 }}">{{ c.english }}</span>{% if not loop.last %}<span class="sl">/</span>{% endif %}
            {%- endfor -%}
          </span>
          {% set gitems = report.grammar.items | selectattr('sentence_no', 'equalto', s.no) | list %}
          {% if gitems %}
          <div class="lit-gram">
            {% if student %}<div class="gram-todo">▶ 아래 핵심 문법이 쓰인 부분을 문장에서 찾아 ○로 표시하세요</div>{% endif %}
            {% for g in gitems %}
            {% set is_key = g.key or (g.point|is_key_grammar) %}
            {% set ci = g.example | chunk_color(s.chunks, g.point) %}
            <div class="gline ck{{ ci }}">
              <span class="gtag{{ ' keytag' if is_key }}">{% if is_key %}★ {% endif %}{{ g.point }}</span>
              {% if not student %}<span class="gexp">{{ g.explanation }}</span>{% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {# 지칭추론 (출제 포인트에서 이동) — 어법과 함께 표시 #}
          {% if refs.get(s.no) %}
          <div class="lit-ref">
            <span class="ref-h-lbl">지칭</span>
            {% for line in refs[s.no] %}
            {% set parts = line.split(' - ') %}
            <div class="lit-ref-item">
              {%- if parts | length >= 3 -%}
                <span class="ref-pron2">{{ parts[1] | trim }}</span><span class="ref-arrow2">→</span>{% if student %}<span class="blank" style="min-width:120px"></span>{% else %}<span class="ref-tgt2">{{ (parts[2:] | join(' - ')) | trim | replace('(', '') | replace(')', '') }}</span>{% endif %}
              {%- else -%}
                {{ line | trim }}
              {%- endif -%}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </td>
        <td class="lit-ko">
          <span class="lit-line">
            {%- for c in s.chunks -%}
              {% if student %}<span class="blank" style="min-width:{{ [c.korean|length*7, 44]|max }}px"></span>{% else %}<span class="ck ck{{ loop.index0 % 8 }}">{{ c.korean }}</span>{% endif %}{% if not loop.last %}<span class="sl">/</span>{% endif %}
            {%- endfor -%}
          </span>
          {# 핵심 단어: 학생용에서는 표시하지 않음 #}
          {% if not student %}
          {% set allwords = [] %}
          {% for c in s.chunks %}{% for w in c.words %}{% set _ = allwords.append(w) %}{% endfor %}{% endfor %}
          {% if allwords %}
          <span class="lit-words">
            {%- for w in allwords -%}<b>{{ w.word }}</b> {{ w.meaning }}{% if not loop.last %} · {% endif %}{%- endfor -%}
          </span>
          {% endif %}
          {% endif %}
        </td>
      </tr>
      {% if s.note %}
      <tr class="lit-note-row"><td colspan="2"><span class="nlbl">쉽게</span>{{ s.note }}</td></tr>
      {% endif %}
      {% endfor %}
      {% set nmax = report.literal.sentences | length %}
      {% set leftover = report.grammar.items | rejectattr('sentence_no', 'in', range(1, nmax + 1)) | list %}
      {% if leftover %}
      <tr class="lit-note-row"><td colspan="2">
        <span class="nlbl">기타 문법</span>
        {% for g in leftover %}
        {% set is_key = g.key or (g.point|is_key_grammar) %}
        <span class="gtag{{ ' keytag' if is_key }}">{% if is_key %}★ {% endif %}{{ g.point }}</span>
        {% endfor %}
      </td></tr>
      {% endif %}
      </tbody>
    </table>
  </div>
{% endmacro %}

{# ---- 앞부분: 원문 + 전체 해석 모음 ---- #}
{% macro render_source(report, pno, total) %}
  <div class="doc-header">
    <span class="doc-badge">원문 · 전체 해석{% if student %} · 학생용{% endif %}</span>
    {% set _num = report.item_no or pno %}
    {% if source_label or _num %}<span class="doc-numbadge">{{ source_label }}{% if source_label and _num %} · {% endif %}{{ _num }}</span>{% endif %}
    <div class="doc-title">{% if report.summary.theme_ko %}<span class="title-ko">{{ report.summary.theme_ko }}</span><br>{% endif %}<span class="title-en">{{ report.summary.theme_en or report.title }}</span></div>
  </div>
  <table class="src2">
    <thead><tr><th class="src-h-en">원문</th><th class="src-h-ko">전체 해석</th></tr></thead>
    <tbody><tr>
      <td class="src-en">
        {%- for s in report.literal.sentences -%}
          <span class="src-no">{{ s.no }}</span>{% if s.english %}{{ s.english }}{% else %}{% for c in s.chunks %}{{ c.english }}{% if not loop.last %} {% endif %}{% endfor %}{% endif %}{% if not loop.last %} {% endif %}
        {%- endfor -%}
      </td>
      <td class="src-ko">
        {%- for s in report.literal.sentences -%}
          <span class="src-no">{{ s.no }}</span>{% if s.translation %}{{ s.translation }}{% else %}{% for c in s.chunks %}{{ c.korean }}{% if not loop.last %} {% endif %}{% endfor %}{% endif %}{% if not loop.last %} {% endif %}
        {%- endfor -%}
      </td>
    </tr></tbody>
  </table>
{% endmacro %}

  {# 매 페이지 하단 왼쪽에 반복 표시할 저작권 (running element) #}
  {% if footer_note %}<div class="pg-copyright">{{ footer_note }}</div>{% endif %}

  {# 1) 전체 원문 + 해석 모음 (여러 지문이면 지문별 페이지) #}
  {% if with_source %}
  {% for report in reports %}
  <div class="src-page">
    {{ render_source(report, loop.index, reports|length) }}
  </div>
  {% endfor %}
  {% endif %}

  {# 2) 지문별 분석지 #}
  {% for report in reports %}
  <div class="passage{{ ' pg' if (with_source or not loop.first) }}{% if student %} stu{% endif %}">
    {{ render_report(report, loop.index, reports|length) }}
  </div>
  {% endfor %}

</body>
</html>
