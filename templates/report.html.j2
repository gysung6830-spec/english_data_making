<!DOCTYPE html>
<html lang="ko">
<head><meta charset="utf-8"><title>영어 지문 분석 - Full Analysis</title></head>
<body>

{% macro render_report(report, pno, total) %}
  <div class="doc-header">
    <span class="doc-badge">지문 분석</span>
    {% if brand %}<span class="doc-badge2">{{ brand }}</span>{% endif %}
    <div class="doc-title">{{ report.item_no or pno }}. {{ report.summary.theme_en or report.title }}</div>
  </div>

  {# ① 주제 #}
  <div class="section s-sum">
    <div class="section-head">
      <span class="sec-num">1</span>
      <span class="sec-title">주제</span>
      <span class="sec-sub">Theme</span>
    </div>
    <div class="summary-overall">{{ report.summary.overall | highlight_ko(report.summary.keywords) }}</div>
  </div>

  {# ② 지문 구조 분석 (개조식 + 문장번호) #}
  <div class="section s-struc">
    <div class="section-head">
      <span class="sec-num">2</span>
      <span class="sec-title">지문 구조 분석</span>
      <span class="sec-sub">{{ "Logic Flow" if report.structure.flow_type == "logic" else "Emotional Flow" }}</span>
    </div>
    <span class="struc-type">
      {{ "논리 전개형 (Logic Flow)" if report.structure.flow_type == "logic" else "감정 전개형 (Emotional Flow)" }}
    </span>
    {% if report.structure.easy_explanation or report.structure.examples %}
    <div class="easy-box">
      {% if report.structure.easy_explanation %}
      <div class="easy-gist"><span class="easy-lbl">쉽게 말하면</span> {{ report.structure.easy_explanation }}</div>
      {% endif %}
      {% if report.structure.examples %}
      <div class="killer">
        <span class="killer-lbl">이런 느낌이야</span>
        <ol class="killer-list">
          {% for ex in report.structure.examples %}<li>{{ ex }}</li>{% endfor %}
        </ol>
      </div>
      {% endif %}
    </div>
    {% endif %}
    <ul class="flow">
      {% for st in report.structure.stages %}
      <li>
        <span class="stage">{{ st.stage }}</span>
        <span class="content">{{ st.content }}</span>
        {% if st.evidence %}<span class="stage-ref">{{ st.evidence }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>

  {# ③ '치밀하게 분석한' 출제 포인트 (유형별 카드) #}
  <div class="section s-exam">
    <div class="section-head">
      <span class="sec-num">3</span>
      <span class="sec-title">‘치밀하게 분석한’ 출제 포인트</span>
      <span class="sec-sub">Exam Points{% if brand %} · {{ brand }} tip{% endif %}</span>
    </div>
    <div class="exam-cards">
    {% for e in report.exam.items %}
      <div class="exam-card{% if '지칭' in e.question_type %} ec-ref{% elif '함축' in e.question_type %} ec-imp{% elif '서술' in e.question_type %} ec-narr{% endif %}">
        <div class="ec-head">{{ e.question_type }}</div>
        <div class="ec-body">

        {%- if '지칭' in e.question_type -%}
          {%- for ln in e.content.split('\n') if ln.strip() -%}
            {%- set parts = ln.split(' - ') -%}
            {%- if parts | length >= 3 -%}
              <div class="ref-line">
                <span class="ref-loc">{{ parts[0] | trim }}</span>
                <span class="ref-pron">{{ parts[1] | trim }}</span>
                <span class="ref-arrow">→</span>
                <span class="ref-target">{{ (parts[2:] | join(' - ')) | trim | replace('(', '') | replace(')', '') }}</span>
              </div>
            {%- else -%}
              <div class="ref-line"><span class="ref-target">{{ ln | trim }}</span></div>
            {%- endif -%}
          {%- endfor -%}

        {%- elif '함축' in e.question_type -%}
          {%- for block in e.content | split_blocks -%}
            <div class="imp-block">
            {%- for ln in block.split('\n') if ln.strip() -%}
              {%- if '함정' in ln -%}<div class="imp-trap">{{ ln | trim }}</div>
              {%- elif '정답 표현' in ln -%}<div class="imp-ans">{{ ln | trim }}</div>
              {%- elif '문맥상' in ln -%}<div class="imp-mean">{{ ln | trim }}</div>
              {%- else -%}<div class="imp-expr">{{ ln | trim }}</div>{%- endif -%}
            {%- endfor -%}
            </div>
          {%- endfor -%}

        {%- elif '서술' in e.question_type -%}
          {%- for ln in e.content.split('\n') if ln.strip() -%}
            {%- if loop.first -%}<div class="narr-sent">{{ ln | trim }}</div>
            {%- else -%}<div class="narr-reason">{{ ln | trim }}</div>{%- endif -%}
          {%- endfor -%}

        {%- else -%}
          <div class="pre">{{ e.content }}</div>
        {%- endif -%}

        </div>
      </div>
    {% endfor %}
    </div>
  </div>

  {# ④ 핵심 어휘 · 유의어 · 반의어 #}
  <div class="section s-voc">
    <div class="section-head">
      <span class="sec-num">4</span>
      <span class="sec-title">핵심 어휘 · 유의어 · 반의어</span>
      <span class="sec-sub">Vocabulary</span>
    </div>
    <table class="grid t-voc">
      <thead><tr>
        <th>No</th><th>단어</th><th>의미</th><th>유의어</th><th>반의어</th><th class="th-sent">문장</th>
      </tr></thead>
      <tbody>
      {% for v in report.vocab.items %}
        <tr>
          <td class="cell-no">{{ v.no }}</td>
          <td class="cell-word">{{ v.word }}</td>
          <td>{{ v.meaning }}</td>
          <td>{{ v.synonyms }}</td>
          <td>{{ v.antonyms }}</td>
          <td class="cell-sent">{% if v.sentence_no %}{{ v.sentence_no }}{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {# ⑤ 직독직해 (핵심 문법 통합) — 새 페이지에 단독 배치 #}
  <div class="section s-lit page-break">
    <div class="section-head">
      <span class="sec-num">5</span>
      <span class="sec-title">직독직해 {% if brand %}<span class="made-by">made by {{ brand }}</span>{% endif %}</span>
      <span class="sec-sub">문장별 핵심 문법 포함 · ★ = 관계사·분사·가정법·비교·도치·강조·5형식 필수 어법</span>
    </div>
    <table class="lit2">
      <thead><tr><th class="lh-en">영어 원문 + 핵심 문법</th><th class="lh-ko">직독직해 + 핵심 단어</th></tr></thead>
      <tbody>
      {% for s in report.literal.sentences %}
      <tr class="lit-row">
        <td class="lit-en">
          <span class="snum">{{ s.no }}</span>
          <span class="lit-line">
            {%- for c in s.chunks -%}
              <span class="ck ck{{ loop.index0 % 8 }}">{{ c.english }}</span>{% if not loop.last %}<span class="sl">/</span>{% endif %}
            {%- endfor -%}
          </span>
          {% set gitems = report.grammar.items | selectattr('sentence_no', 'equalto', s.no) | list %}
          {% if gitems %}
          <div class="lit-gram">
            {% for g in gitems %}
            {% set is_key = g.key or (g.point|is_key_grammar) %}
            {% set ci = g.example | chunk_color(s.chunks, g.point) %}
            <div class="gline ck{{ ci }}">
              <span class="gtag{{ ' keytag' if is_key }}">{% if is_key %}★필수 {% endif %}{{ g.point }}</span>
              <span class="gexp">{{ g.explanation }}</span>
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </td>
        <td class="lit-ko">
          <span class="lit-line">
            {%- for c in s.chunks -%}
              <span class="ck ck{{ loop.index0 % 8 }}">{{ c.korean }}</span>{% if not loop.last %}<span class="sl">/</span>{% endif %}
            {%- endfor -%}
          </span>
          {% set allwords = [] %}
          {% for c in s.chunks %}{% for w in c.words %}{% set _ = allwords.append(w) %}{% endfor %}{% endfor %}
          {% if allwords %}
          <span class="lit-words">
            {%- for w in allwords -%}<b>{{ w.word }}</b> {{ w.meaning }}{% if not loop.last %} · {% endif %}{%- endfor -%}
          </span>
          {% endif %}
        </td>
      </tr>
      {% if s.note %}
      <tr class="lit-note-row"><td colspan="2"><span class="nlbl">쉽게</span>{{ s.note }}</td></tr>
      {% endif %}
      {% endfor %}
      {% set nmax = report.literal.sentences | length %}
      {% set leftover = report.grammar.items | rejectattr('sentence_no', 'in', range(1, nmax + 1)) | list %}
      {% if leftover %}
      <tr class="lit-note-row"><td colspan="2">
        <span class="nlbl">기타 문법</span>
        {% for g in leftover %}
        {% set is_key = g.key or (g.point|is_key_grammar) %}
        <span class="gtag{{ ' keytag' if is_key }}">{% if is_key %}★ {% endif %}{{ g.point }}</span>
        {% endfor %}
      </td></tr>
      {% endif %}
      </tbody>
    </table>
  </div>

  {# ⑥ 핵심 단어 영어 요약문 — 직독직해 뒤에 배치 #}
  {% if report.vocab.english_summary %}
  <div class="section s-esum">
    <div class="section-head">
      <span class="sec-num">6</span>
      <span class="sec-title">핵심 단어 영어 요약문</span>
      <span class="sec-sub">굵은 단어 = 핵심 어휘</span>
    </div>
    <div class="esum-box">
      {{ report.vocab.english_summary | highlight_words(report.vocab.items | map(attribute='word') | list) }}
    </div>
    {% if report.vocab.english_summary_ko %}
    <div class="esum-ko">{{ report.vocab.english_summary_ko }}</div>
    {% endif %}
  </div>
  {% endif %}

  {% if footer_note %}
  <div class="footer-note">{{ footer_note }}</div>
  {% endif %}
{% endmacro %}

{# ---- 앞부분: 원문 + 전체 해석 모음 ---- #}
{% macro render_source(report, pno, total) %}
  <div class="doc-header">
    <span class="doc-badge">원문 · 전체 해석</span>
    <div class="doc-title">{{ report.item_no or pno }}. {{ report.summary.theme_en or report.title }}</div>
  </div>
  <table class="src2">
    <thead><tr><th class="src-h-en">원문</th><th class="src-h-ko">전체 해석</th></tr></thead>
    <tbody><tr>
      <td class="src-en">
        {%- for s in report.literal.sentences -%}
          <span class="src-no">{{ s.no }}</span>{% if s.english %}{{ s.english }}{% else %}{% for c in s.chunks %}{{ c.english }}{% if not loop.last %} {% endif %}{% endfor %}{% endif %}{% if not loop.last %} {% endif %}
        {%- endfor -%}
      </td>
      <td class="src-ko">
        {%- for s in report.literal.sentences -%}
          <span class="src-no">{{ s.no }}</span>{% if s.translation %}{{ s.translation }}{% else %}{% for c in s.chunks %}{{ c.korean }}{% if not loop.last %} {% endif %}{% endfor %}{% endif %}{% if not loop.last %} {% endif %}
        {%- endfor -%}
      </td>
    </tr></tbody>
  </table>
  {% if footer_note %}<div class="footer-note">{{ footer_note }}</div>{% endif %}
{% endmacro %}

  {# 1) 전체 원문 + 해석 모음 (여러 지문이면 지문별 페이지) #}
  {% if with_source %}
  {% for report in reports %}
  <div class="src-page">
    {{ render_source(report, loop.index, reports|length) }}
  </div>
  {% endfor %}
  {% endif %}

  {# 2) 지문별 분석지 #}
  {% for report in reports %}
  <div class="passage{{ ' pg' if (with_source or not loop.first) }}">
    {{ render_report(report, loop.index, reports|length) }}
  </div>
  {% endfor %}

</body>
</html>
