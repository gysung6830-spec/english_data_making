<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>{{ pack.title }} - 워크북</title>
  <style>{{ font_css }}</style>
  <style>{% include "prose.css" %}</style>
  <style>{% include "_common.css" %}</style>
</head>
<body>

  {% if section != 'a' %}
  {% for ws in pack.worksheets %}
  <section class="ws{{ ' brk' if not loop.first }}">
    <div class="sh-head">
      {% if pack.label %}<span class="sh-badge">{{ pack.label }}</span>{% endif %}
      <div class="sh-titles"><div class="sh-title">{{ pack.title }}</div></div>
    </div>
    <div class="ws-instr wt-{{ ws.wtype }}">
      <span class="wt-label">{{ ws.label }}</span> {{ ws.instruction }}
    </div>
    <ol class="ws-list">
      {% for s in ws.sentences %}
      <li>
        <div class="s-en">{{ s | render_prose(ws.wtype) }}</div>
        {% if ws.wtype == 'translate' %}
          <div class="translate-box"></div>
        {% elif show_ko %}
          <div class="s-ko">{{ s.ko }}</div>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endfor %}
  {% endif %}

  {% if section != 'q' %}
  {# 정답 #}
  <section class="ans-page">
    <div class="ans-head">정답 <span class="ans-sub">Answers</span></div>
    {% for ws in pack.worksheets %}
    <div class="ans-ws">
      <div class="ans-ws-h wt-{{ ws.wtype }}">{{ ws.label }}</div>
      {% if ws.wtype == 'translate' %}
        {% for s in ws.sentences %}<div class="ans-row ans-tr"><b>{{ s.no }}.</b> {{ s.ko }}</div>{% endfor %}
      {% else %}
        {% for s in ws.sentences %}{% if s.items %}<div class="ans-row"><b>{{ s.no }}.</b>
          {% for it in s.items %}<span class="ans-a">{{ it.answer }}</span>{% if not loop.last %}<span class="sep">/</span>{% endif %}{% endfor %}
        </div>{% endif %}{% endfor %}
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

</body>
</html>
